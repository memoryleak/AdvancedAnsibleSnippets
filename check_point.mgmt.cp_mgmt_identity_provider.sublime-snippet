<snippet>
  <content><![CDATA[- name: ${1:Manages identity-provider objects on Checkpoint over Web Services API}
  check_point.mgmt.cp_mgmt_identity_provider:
    auto_publish_session: ${2:# Publish the current session if changes have been performed after task completes}
    base64_certificate: ${3:# Certificate file encoded in base64 based on provider data}
    base64_metadata_file: ${4:# Metadata file encoded in base64 based on the provider data}
    color: ${5:# Color of the object}
    comments: ${6:# Comments string}
    data_receiving: ${7:# Data receiving method from the SAML Identity Provider}
    details_level: ${8:# The level of detail for some of the fields in the response can vary from showing only the UID value of the object to a fully detailed representation of the object}
    domains_to_process: ${9:# Indicates which domains to process the commands on}
    gateway: ${10:# Gateway for the SAML Identity Provider usage}
    ignore_errors: ${11:# Apply changes ignoring errors}
    ignore_warnings: ${12:# Apply changes ignoring warnings}
    login_url: ${13:# Login URL based on the provider data}
    name: ${14:# Object name}
    received_identifier: ${15:# Received Identifier (Entity ID) based on the provider data}
    service: ${16:# Service for the selected gateway}
    state: ${17:# State of the access rule (present or absent)}
    tags: ${18:# Collection of tag identifiers}
    usage: ${19:# Usage of Identity Provider}
    version: ${20:# Version of checkpoint}
    wait_for_task: ${21:# Wait for the task to end}
    wait_for_task_timeout: ${22:# How many minutes to wait until throwing a timeout error}
  tags:
    - check_point
    - mgmt
    - cp_mgmt_identity_provider]]></content>
