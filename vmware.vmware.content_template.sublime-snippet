<snippet>
  <content><![CDATA[- name: ${1:Manage template in content library from virtual machine}
  vmware.vmware.content_template:
    cluster: ${2:# Cluster onto which the virtual machine template should be placed}
    datacenter: ${3:# The name of the datacenter to use when searching for the source VM}
    folder_paths_are_absolute: ${4:# If true, any folder path parameters are treated as absolute paths}
    host: ${5:# Host onto which the virtual machine template should be placed}
    hostname: ${6:# The hostname or IP address of the vSphere vCenter server}
    library: ${7:# The name of the content library where the template will be created}
    password: ${8:# The password of the vSphere vCenter server}
    port: ${9:# The port number of the vSphere vCenter server}
    proxy_host: ${10:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${11:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    proxy_protocol: ${12:# The proxy connection protocol to use}
    resource_pool: ${13:# Resource pool into which the virtual machine template should be placed}
    state: ${14:# State of the template in content library}
    template_folder: ${15:# Virtual machine folder into which the virtual machine template should be placed}
    template_name: ${16:# The name of template to manage}
    use_instance_uuid: ${17:# Whether to use the VMware instance UUID rather than the BIOS UUID when searching for the VM}
    username: ${18:# The username of the vSphere vCenter server}
    validate_certs: ${19:# Allows connection when SSL certificates are not valid}
    vm_folder: ${20:# Destination folder, absolute or relative path to find an existing guest}
    vm_moid: ${21:# Managed Object ID of the instance to manage if known, this is a unique identifier only within a single vCenter instance}
    vm_name: ${22:# The name of the VM to be used to create template}
    vm_name_match: ${23:# If multiple virtual machines matching the name, use the first or last found}
    vm_uuid: ${24:# UUID of the instance to manage if known, this is VMware's unique identifier}
  tags:
    - vmware
    - vmware
    - content_template]]></content>
  <tabTrigger>vmware.vmware.content_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage template in content library from virtual machine</description>
</snippet>