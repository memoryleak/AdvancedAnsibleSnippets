<snippet>
  <content><![CDATA[- name: ${1:Manage Key Vault security domain for HSM}
  azure.azcollection.azure_rm_keyvaultsecuritydomain:
    action: ${2:# Action to take on Security Domain}
    ad_user: ${3:# Active Directory username}
    adfs_authority_url: ${4:# Azure AD authority url}
    api_profile: ${5:# Selects an API profile to use when communicating with Azure services}
    auth_source: ${6:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${7:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${8:# Azure client ID}
    cloud_environment: ${9:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    disable_instance_discovery: ${10:# Determines whether or not instance discovery is performed when attempting to authenticate}
    hsm_name: ${11:# Name of the HSM}
    keyvault_uri: ${12:# URI of the keyvault endpoint}
    log_mode: ${13:# Parent argument}
    log_path: ${14:# Parent argument}
    no_wait: ${15:# Don't wait for the operation to finish}
    password: ${16:# Active Directory user password}
    profile: ${17:# Security profile found in ~/}
    sd_quorum: ${18:# The minimum number of shares required to decrypt the security domain for recovery}
    sd_wrapping_keys: ${19:# List of wrapping keys containing public keys}
    secret: ${20:# Azure client secret}
    subscription_id: ${21:# Your Azure subscription Id}
    tenant: ${22:# Azure tenant ID}
    thumbprint: ${23:# The thumbprint of the private key specified in I(x509_certificate_path)}
    x509_certificate_path: ${24:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_keyvaultsecuritydomain]]></content>
  <tabTrigger>azure.azcollection.azure_rm_keyvaultsecuritydomain</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Key Vault security domain for HSM</description>
</snippet>