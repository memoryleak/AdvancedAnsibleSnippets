<snippet>
  <content><![CDATA[- name: ${1:Link Aggregation Policy configuration for Cisco Intersight}
  cisco.intersight.intersight_link_aggregation_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    description: ${5:# The user-defined description for the Link Aggregation Policy}
    lacp_rate: ${6:# Flag used to indicate whether LACP PDUs are to be sent 'fast', i}
    name: ${7:# The name assigned to the Link Aggregation Policy}
    organization: ${8:# The name of the Organization this resource is assigned to}
    state: ${9:# If C(present), will verify the resource is present and will create if needed}
    suspend_individual: ${10:# Flag tells the switch whether to suspend the port if it didn't receive LACP PDU}
    tags: ${11:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    use_proxy: ${12:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${13:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_link_aggregation_policy]]></content>
  <tabTrigger>cisco.intersight.intersight_link_aggregation_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Link Aggregation Policy configuration for Cisco Intersight</description>
</snippet>