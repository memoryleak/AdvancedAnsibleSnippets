<snippet>
  <content><![CDATA[- name: ${1:Manage downtimes in Icinga2}
  telekom_mms.icinga_director.icinga_scheduled_downtime:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    append: ${3:# Do not overwrite the whole object but instead append the defined properties}
    apply_to: ${4:# Whether this dependency should affect hosts or services}
    assign_filter: ${5:# The filter where the downtime will take effect}
    author: ${6:# Name of the downtime author}
    client_cert: ${7:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${8:# PEM formatted file that contains your private key to be used for SSL client authentication}
    comment: ${9:# A descriptive comment for the downtime}
    disabled: ${10:# Disabled objects will not be deployed}
    duration: ${11:# How long the downtime lasts}
    fixed: ${12:# Whether this downtime is fixed or flexible}
    force: ${13:# If V(yes) do not get a cached copy}
    force_basic_auth: ${14:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    http_agent: ${15:# Header to identify as, generally appears in web server logs}
    object_name: ${16:# Icinga object name for this downtime}
    ranges: ${17:# The period which should be downtimed}
    state: ${18:# Apply feature state}
    url: ${19:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${20:# The password for use in HTTP basic authentication}
    url_username: ${21:# The username for use in HTTP basic authentication}
    use_gssapi: ${22:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${23:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${24:# If V(no), SSL certificates will not be validated}
    with_services: ${25:# Whether you only downtime the hosts or add some services with it}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_scheduled_downtime]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_scheduled_downtime</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage downtimes in Icinga2</description>
</snippet>