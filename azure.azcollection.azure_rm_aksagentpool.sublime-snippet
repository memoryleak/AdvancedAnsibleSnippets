<snippet>
  <content><![CDATA[- name: ${1:Manage node pools in Kubernetes kubernetes cluster}
  azure.azcollection.azure_rm_aksagentpool:
    ad_user: ${2:# Active Directory username}
    adfs_authority_url: ${3:# Azure AD authority url}
    api_profile: ${4:# Selects an API profile to use when communicating with Azure services}
    append_tags: ${5:# Use to control if tags field is canonical or just appends to existing tags}
    auth_source: ${6:# Controls the source of the credentials to use for authentication}
    availability_zones: ${7:# Availability zones for nodes}
    capacity_reservation_group_id: ${8:# The Capacity Reservation Group ID}
    cert_validation_mode: ${9:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${10:# Azure client ID}
    cloud_environment: ${11:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    cluster_name: ${12:# The name of the kubernetes cluster}
    count: ${13:# Number of agents (VMs) to host docker containers}
    disable_instance_discovery: ${14:# Determines whether or not instance discovery is performed when attempting to authenticate}
    enable_auto_scaling: ${15:# Whether to enable auto-scaler}
    enable_encryption_at_host: ${16:# This is only supported on certain VM sizes and in certain Azure regions}
    enable_fips: ${17:# Whether enable FIPS node pool}
    enable_node_public_ip: ${18:# Some scenarios may require nodes in a node pool to receive theirown dedicated public IP addresses}
    enable_ultra_ssd: ${19:# Whether to enable UltraSSD}
    gpu_instance_profile: ${20:# GPUInstanceProfile to be used to specify GPU MIG instance profile for supported GPU VM SKU}
    host_group_id: ${21:# The Host Group ID}
    kubelet_config: ${22:# The Kubelet configuration on the agent pool nodes}
    kubelet_disk_type: ${23:# Determines the placement of emptyDir volumes, container runtime data root, and Kubelet ephemeral storage}
    linux_os_config: ${24:# The OS configuration of Linux agent nodes}
    log_mode: ${25:# Parent argument}
    log_path: ${26:# Parent argument}
    max_count: ${27:# Maximum number of nodes for auto-scaling}
    max_pods: ${28:# Maximum number of pods that can run on a node}
    min_count: ${29:# Minimum number of nodes for auto-scaling}
    mode: ${30:# AgentPoolMode represents mode of an agent pool}
    name: ${31:# The name of the node agent pool}
    network_profile: ${32:# Network-related settings of an agent pool}
    node_labels: ${33:# Agent pool node labels to be persisted across all nodes in agent pool}
    node_public_ip_prefix_id: ${34:# The Azure Public IP prefix's ID}
    node_taints: ${35:# The taints added to new nodes during node pool create and scale}
    orchestrator_version: ${36:# Version of orchestrator specified when creating the managed cluster}
    os_disk_size_gb: ${37:# OS Disk Size in GB to be used to specify the disk size for every machine in this master/agent pool}
    os_disk_type: ${38:# The default is C(Ephemeral) if the VM supports it and has a cache disk larger than the requested OSDiskSizeGB}
    os_sku: ${39:# Specifies an OS SKU}
    os_type: ${40:# OsType to be used to specify os type}
    password: ${41:# Active Directory user password}
    pod_subnet_id: ${42:# If omitted, pod IPs are statically assigned on the node subnet}
    power_state: ${43:# When an Agent Pool is first created it is initially C(Running)}
    profile: ${44:# Security profile found in ~/}
    proximity_placement_group_id: ${45:# The ID for Proximity Placement Group}
    resource_group: ${46:# The name of the resource group}
    scale_down_mode: ${47:# This also effects the cluster autoscaler behavior}
    scale_set_eviction_policy: ${48:# This cannot be specified unless the I(scale_set_priority=Spot)}
    scale_set_priority: ${49:# The Virtual Machine Scale Set priority}
    secret: ${50:# Azure client secret}
    security_profile: ${51:# The security settings of an agent pool}
    spot_max_price: ${52:# Possible values are any decimal value greater than zero or -1}
    state: ${53:# State of the automation runbook}
    subscription_id: ${54:# Your Azure subscription Id}
    tags: ${55:# Dictionary of string:string pairs to assign as metadata to the object}
    tenant: ${56:# Azure tenant ID}
    thumbprint: ${57:# The thumbprint of the private key specified in I(x509_certificate_path)}
    type_properties_type: ${58:# AgentPoolType represents types of an agent pool}
    upgrade_settings: ${59:# Settings for upgrading the agentpool}
    vm_size: ${60:# Size of agent VMs}
    vnet_subnet_id: ${61:# VNet SubnetID specifies the VNet's subnet identifier}
    windows_profile: ${62:# The Windows agent pool's specific profile}
    workload_runtime: ${63:# Determines the type of workload a node can run}
    x509_certificate_path: ${64:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_aksagentpool]]></content>
  <tabTrigger>azure.azcollection.azure_rm_aksagentpool</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage node pools in Kubernetes kubernetes cluster</description>
</snippet>