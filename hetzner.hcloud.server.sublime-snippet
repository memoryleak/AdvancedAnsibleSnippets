<snippet>
  <content><![CDATA[- name: ${1:Create and manage cloud servers on the Hetzner Cloud}
  hetzner.hcloud.server:
    api_endpoint: ${2:# The endpoint for the Hetzner Cloud API}
    api_endpoint_hetzner: ${3:# The endpoint for the Hetzner API}
    api_token: ${4:# The token for the Hetzner Cloud API}
    backups: ${5:# Enable or disable Backups for the given Server}
    datacenter: ${6:# B(Deprecated:) The O(datacenter) argument is deprecated and will be removed after 1 July 2026}
    delete_protection: ${7:# Protect the Server for deletion}
    enable_ipv4: ${8:# Enables the public ipv4 address}
    enable_ipv6: ${9:# Enables the public ipv6 address}
    firewalls: ${10:# List of Hetzner Cloud Firewalls (name or ID) that should be attached to the server}
    force: ${11:# Force the update of the server}
    id: ${12:# ID of the Hetzner Cloud Server to manage}
    image: ${13:# Hetzner Cloud Image (name or ID) to create the server from}
    image_allow_deprecated: ${14:# Allows the creation of servers with deprecated images}
    ipv4: ${15:# Hetzner Cloud Primary IPv4 (name or ID) to use}
    ipv6: ${16:# Hetzner Cloud Primary IPv6 (name or ID) to use}
    labels: ${17:# User-defined labels (key-value pairs)}
    location: ${18:# Hetzner Cloud Location (name or ID) to create the server in}
    name: ${19:# Name of the Hetzner Cloud Server to manage}
    placement_group: ${20:# Hetzner Cloud Placement Group (name or ID) to create the server in}
    private_networks: ${21:# List of Hetzner Cloud Networks (name or ID) the server should be attached to}
    rebuild_protection: ${22:# Protect the Server for rebuild}
    rescue_mode: ${23:# Add the Hetzner rescue system type you want the server to be booted into}
    server_type: ${24:# Hetzner Cloud Server Type (name or ID) of the server}
    ssh_keys: ${25:# List of Hetzner Cloud SSH Keys (name or ID) to create the server with}
    state: ${26:# State of the server}
    upgrade_disk: ${27:# Resize the disk size, when resizing a server}
    user_data: ${28:# User Data to be passed to the server on creation}
    volumes: ${29:# List of Hetzner Cloud Volumes (name or ID) that should be attached to the server}
  tags:
    - hetzner
    - hcloud
    - server]]></content>
  <tabTrigger>hetzner.hcloud.server</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Create and manage cloud servers on the Hetzner Cloud</description>
</snippet>