    set_dampening: ${12:# The dampening rule to add to the Set Rule Policy}
    set_metric: ${13:# The metric rule to add to the Set Rule Policy}
    set_metric_type: ${14:# The type of metric rule to add to the Set Rule Policy}
    set_multi_path: ${15:# The multipath option to add to the Set Rule Policy}
    set_next_hop: ${16:# The next hop rule to add to the Set Rule Policy}
    set_next_hop_propagate: ${17:# The next hop propagation value to add to the Set Rule Policy}
    set_preference: ${18:# The preference rule to add to the Set Rule Policy}
    set_route_tag: ${19:# The route tag rule to add to the Set Rule Policy}
    set_weight: ${20:# The weight rule to add to the Set Rule Policy}
    state: ${21:# Determines the desired state of the resource}
    template: ${22:# The name of the template}
    template_id: ${23:# The ID of the tenant template}
    timeout: ${24:# The socket level timeout in seconds}
