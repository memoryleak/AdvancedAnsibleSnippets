<snippet>
  <content><![CDATA[- name: ${1:Manage NTP Policies in Fabric Policy Templates on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_ntp_policy:
    admin_state: ${2:# Enable admin state}
    authentication_state: ${3:# Enable authentication state}
    description: ${4:# The description of the NTP Policy}
    host: ${5:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    login_domain: ${6:# The login domain name to use for authentication}
    master_mode: ${7:# Enable master mode}
    name: ${8:# The name of the NTP Policy}
    ntp_keys: ${9:# The list of NTP client authentication keys}
    ntp_providers: ${10:# The list of NTP providers}
    output_level: ${11:# Influence the output of this MSO module}
    password: ${12:# The password to use for authentication}
    port: ${13:# Port number to be used for the REST connection}
    server_state: ${14:# Enable server state}
    state: ${15:# Use C(absent) for removing}
    stratum: ${16:# The numerical value of the stratum}
    template: ${17:# The name of the Fabric Policy template}
    template_id: ${18:# The ID of the Fabric Policy template}
    timeout: ${19:# The socket level timeout in seconds}
    use_proxy: ${20:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${21:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${22:# The username to use for authentication}
    uuid: ${23:# The UUID of the NTP Policy}
    validate_certs: ${24:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_ntp_policy]]></content>
  <tabTrigger>cisco.mso.ndo_ntp_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage NTP Policies in Fabric Policy Templates on Cisco Nexus Dashboard Orchestrator (NDO)</description>
