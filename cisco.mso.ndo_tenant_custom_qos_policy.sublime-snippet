<snippet>
  <content><![CDATA[- name: ${1:Manage Custom QoS Policies in Tenant Policy Templates on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_tenant_custom_qos_policy:
    cos_mappings: ${2:# The Class of Service (CoS) mappings of the Custom QoS Policy}
    description: ${3:# The description of the Custom QoS Policy}
    dscp_mappings: ${4:# The Differentiated Services Code Point (DSCP) mappings of the Custom QoS Policy}
    host: ${5:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    login_domain: ${6:# The login domain name to use for authentication}
    name: ${7:# The name of the Custom QoS Policy}
    output_level: ${8:# Influence the output of this MSO module}
    password: ${9:# The password to use for authentication}
    port: ${10:# Port number to be used for the REST connection}
    state: ${11:# Use C(absent) for removing}
    template: ${12:# The name of the tenant template}
    timeout: ${13:# The socket level timeout in seconds}
    use_proxy: ${14:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${15:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${16:# The username to use for authentication}
    uuid: ${17:# The UUID of the Custom QoS Policy}
    validate_certs: ${18:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_tenant_custom_qos_policy]]></content>
