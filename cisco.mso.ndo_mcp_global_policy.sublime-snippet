<snippet>
  <content><![CDATA[- name: ${1:Manage the MCP Global Policy in a Fabric Policy Template on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_mcp_global_policy:
    admin_state: ${2:# The administrative state of the MCP Global Policy}
    description: ${3:# The description of the MCP Global Policy}
    host: ${4:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    initial_delay_time: ${5:# The MCP initial delay time in seconds}
    key: ${6:# The key of the MCP Global Policy}
    login_domain: ${7:# The login domain name to use for authentication}
    loop_detection_factor: ${8:# The amount of MCP packets that will be received before port disable loop protection action takes place}
    name: ${9:# The name of the MCP Global Policy}
    output_level: ${10:# Influence the output of this MSO module}
    password: ${11:# The password to use for authentication}
    per_vlan: ${12:# When enabled MCP will send packets on a per End Point Group (EPG) basis}
    port: ${13:# Port number to be used for the REST connection}
    port_disable: ${14:# Enable or disable port disabling when MCP packets are received}
    state: ${15:# Use C(absent) for removing}
    template: ${16:# The name of the template}
    timeout: ${17:# The socket level timeout in seconds}
    transmission_frequency_msec: ${18:# The MCP transmission frequency in milliseconds}
    transmission_frequency_sec: ${19:# The MCP transmission frequency in seconds}
    use_proxy: ${20:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${21:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${22:# The username to use for authentication}
    uuid: ${23:# The UUID of the MCP Global Policy}
    validate_certs: ${24:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_mcp_global_policy]]></content>
