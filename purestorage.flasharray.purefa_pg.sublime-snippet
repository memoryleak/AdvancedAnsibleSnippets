<snippet>
  <content><![CDATA[- name: ${1:Manage protection groups on Pure Storage FlashArrays}
  purestorage.flasharray.purefa_pg:
    api_token: ${2:# FlashArray API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    disable_warnings: ${4:# Disable insecure certificate warnings in debug logs}
    enabled: ${5:# Define whether to enabled snapshots for the protection group}
    eradicate: ${6:# Define whether to eradicate the protection group on delete and leave in trash}
    fa_url: ${7:# FlashArray management IPv4 address or Hostname}
    host: ${8:# List of existing hosts to add to protection group}
    hostgroup: ${9:# List of existing hostgroups to add to protection group}
    name: ${10:# The name of the protection group}
    rename: ${11:# Rename a protection group}
    safe_mode: ${12:# Enables SafeMode restrictions on the protection group}
    state: ${13:# Define whether the protection group should exist or not}
    target: ${14:# List of remote arrays or offload target for replication protection group to connect to}
    volume: ${15:# List of existing volumes to add to protection group}
  tags:
    - purestorage
    - flasharray
    - purefa_pg]]></content>
  <tabTrigger>purestorage.flasharray.purefa_pg</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage protection groups on Pure Storage FlashArrays</description>
</snippet>