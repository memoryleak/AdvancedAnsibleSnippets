<snippet>
  <content><![CDATA[- name: ${1:Manage Content View Versions}
  theforeman.foreman.content_view_version:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    content_view: ${3:# Name of the content view}
    current_lifecycle_environment: ${4:# The lifecycle environment that is already associated with the content view version}
    description: ${5:# Description of the Content View Version}
    force_promote: ${6:# Force content view promotion and bypass lifecycle environment restriction}
    force_yum_metadata_regeneration: ${7:# Force metadata regeneration when performing Publish and Promote tasks}
    lifecycle_environments: ${8:# The lifecycle environments the Content View Version should be in}
    organization: ${9:# Organization that the entity is in}
    password: ${10:# Password of the user accessing the Foreman server}
    server_url: ${11:# URL of the Foreman server}
    state: ${12:# State of the entity}
    use_gssapi: ${13:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${14:# Username accessing the Foreman server}
    validate_certs: ${15:# Whether or not to verify the TLS certificates of the Foreman server}
    version: ${16:# The content view version number (i}
  tags:
    - theforeman
    - foreman
    - content_view_version]]></content>
