    natural_foreign: ${9:# Use natural keys when serializing for foreign keys}
    natural_primary: ${10:# Omit primary keys when serializing}
    primary_keys: ${11:# List of primary keys to include in the dump}
    pythonpath: ${12:# Adds the given filesystem path to the Python import search path}
    settings: ${13:# Specifies the settings module to use}
    skip_checks: ${14:# Skips running system checks prior to running the command}
    traceback: ${15:# Provides a full stack trace in the output when a C(CommandError) is raised}
    venv: ${16:# Use the Python interpreter from this virtual environment}
