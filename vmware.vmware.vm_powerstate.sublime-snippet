<snippet>
  <content><![CDATA[- name: ${1:Manages power states of virtual machines in vCenter}
  vmware.vmware.vm_powerstate:
    datacenter: ${2:# The datacenter where the VM you'd like to operate the power}
    folder: ${3:# Destination folder, absolute or relative path to find an existing guest}
    folder_paths_are_absolute: ${4:# If true, any folder path parameters are treated as absolute paths}
    force: ${5:# Ignore warnings and complete the actions}
    hostname: ${6:# The hostname or IP address of the vSphere vCenter server}
    moid: ${7:# Managed Object ID of the instance to manage if known, this is a unique identifier only within a single vCenter instance}
    name: ${8:# Name of the virtual machine to work with}
    name_match: ${9:# If multiple virtual machines matching the name, use the first or last found}
    password: ${10:# The password of the vSphere vCenter server}
    port: ${11:# The port number of the vSphere vCenter server}
    proxy_host: ${12:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${13:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    question_answers: ${14:# A list of questions to answer, should one or more arise while waiting for the task to complete}
    scheduled_at: ${15:# Date and time in string format at which specified task needs to be performed}
    scheduled_task_description: ${16:# Description of scheduled task}
    scheduled_task_enabled: ${17:# Flag to indicate whether the scheduled task is enabled or disabled}
    scheduled_task_name: ${18:# Name of scheduled task}
    state: ${19:# Set the state of the virtual machine}
    timeout: ${20:# If this argument is set to a positive integer, the module will wait for the VM to reach the poweredoff state}
    use_instance_uuid: ${21:# Whether to use the VMware instance UUID rather than the BIOS UUID}
    username: ${22:# The username of the vSphere vCenter server}
    uuid: ${23:# UUID of the instance to manage if known, this is VMware's unique identifier}
    validate_certs: ${24:# Allows connection when SSL certificates are not valid}
  tags:
    - vmware
    - vmware
    - vm_powerstate]]></content>
  <tabTrigger>vmware.vmware.vm_powerstate</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manages power states of virtual machines in vCenter</description>
</snippet>