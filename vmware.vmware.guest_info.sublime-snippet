<snippet>
  <content><![CDATA[- name: ${1:Gather guest information}
  vmware.vmware.guest_info:
    datacenter: ${2:# The datacenter with the VM you would like to query}
    folder: ${3:# Absolute or relative folder path to search for the virtual machine}
    folder_paths_are_absolute: ${4:# If true, any folder path parameters are treated as absolute paths}
    gather_tags: ${5:# If true, gather any tags attached to the vm(s)}
    guest_password: ${6:# The password of the user to be used to connect to guest vm and fetch environment info}
    guest_username: ${7:# The username to be used to connect to guest vm and fetch environment info}
    hostname: ${8:# The hostname or IP address of the vSphere vCenter server}
    moid: ${9:# The MOID of the vm to gather info for}
    name: ${10:# The name of the vm to gather info for}
    name_match: ${11:# If using name and multiple VMs have the same name, specify which VM should be selected}
    password: ${12:# The password of the vSphere vCenter server}
    port: ${13:# The port number of the vSphere vCenter server}
    properties: ${14:# If the schema is 'vsphere', gather these specific properties only}
    proxy_host: ${15:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${16:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    proxy_protocol: ${17:# The proxy connection protocol to use}
    schema: ${18:# The type of info to gather from the vms}
    use_instance_uuid: ${19:# If true, search by instance UUID instead of BIOS UUID}
    username: ${20:# The username of the vSphere vCenter server}
    uuid: ${21:# The UUID of the vm to gather info for}
    validate_certs: ${22:# Allows connection when SSL certificates are not valid}
  tags:
    - vmware
    - vmware
    - guest_info]]></content>
  <tabTrigger>vmware.vmware.guest_info</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Gather guest information</description>
</snippet>