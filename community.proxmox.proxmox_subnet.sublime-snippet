    dnszoneprefix: ${12:# Prefix for the DNS zone}
    gateway: ${13:# Subnet Gateway}
    lock_token: ${14:# the token for unlocking the global SDN configuration}
    snat: ${15:# Enable Source NAT for the subnet}
    state: ${16:# Desired state of the subnet configuration}
    subnet: ${17:# Subnet CIDR}
    update: ${18:# If O(state=present) then it will update the subnet if needed}
    validate_certs: ${19:# If V(false), SSL certificates will not be validated}
    vnet: ${20:# The virtual network to which the subnet belongs}
    zone: ${21:# Vnet Zone}
