<snippet>
  <content><![CDATA[- name: ${1:Manage Node Profiles on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_node_profile:
    description: ${2:# The description of the Node Profile}
    host: ${3:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    login_domain: ${4:# The login domain name to use for authentication}
    name: ${5:# The name of the Node Profile}
    node_setting: ${6:# The node setting to associate with the Node Profile}
    node_setting_uuid: ${7:# The UUID of the node setting to associate with the Node Profile}
    nodes: ${8:# The list of node IDs to associate with the Node Profile}
    output_level: ${9:# Influence the output of this MSO module}
    password: ${10:# The password to use for authentication}
    port: ${11:# Port number to be used for the REST connection}
    state: ${12:# Use C(absent) for removing}
    template: ${13:# The name of the template}
    template_id: ${14:# The ID of the template}
    timeout: ${15:# The socket level timeout in seconds}
    use_proxy: ${16:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${17:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${18:# The username to use for authentication}
    uuid: ${19:# The UUID of the Node Profile}
    validate_certs: ${20:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_node_profile]]></content>
