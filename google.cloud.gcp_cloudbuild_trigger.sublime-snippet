<snippet>
  <content><![CDATA[- name: ${1:Creates a GCP CloudBuild}
  google.cloud.gcp_cloudbuild_trigger:
    access_token: ${2:# The access token used to authenticate}
    approval_config: ${3:# Configuration for manual approval to start a build invocation of this BuildTrigger}
    auth_kind: ${4:# The type of credential used}
    bitbucket_server_trigger_config: ${5:# BitbucketServerTriggerConfig describes the configuration of a trigger that creates a build whenever a Bitbucket Server event is received}
    build: ${6:# Contents of the build template}
    description: ${7:# Human-readable description of the trigger}
    disabled: ${8:# Whether the trigger is disabled or not}
    env_type: ${9:# Specifies which Ansible environment you're running this module within}
    filename: ${10:# Path, from the source root, to a file whose contents is used for the template}
    filter: ${11:# A Common Expression Language string}
    git_file_source: ${12:# The file source describing the local or remote Build template}
    github: ${13:# Describes the configuration of a trigger that creates a build whenever a GitHub event is received}
    ignored_files: ${14:# ignoredFiles and includedFiles are file glob matches using https://golang}
    include_build_logs: ${15:# Build logs will be sent back to GitHub as part of the checkrun result}
    included_files: ${16:# ignoredFiles and includedFiles are file glob matches using https://golang}
    location: ${17:# The [Cloud Build location](https://cloud}
    name: ${18:# Name of the trigger}
    project: ${19:# The Google Cloud Platform project to use}
    pubsub_config: ${20:# PubsubConfig describes the configuration of a trigger that creates a build whenever a Pub/Sub message is published}
    repository_event_config: ${21:# The configuration of a trigger that creates a build whenever an event from Repo API is received}
    scopes: ${22:# Array of scopes to be used}
    service_account: ${23:# The service account used for all user-controlled operations including triggers}
    service_account_contents: ${24:# The contents of a Service Account JSON file,}
    service_account_email: ${25:# An optional service account email address if machineaccount is}
    service_account_file: ${26:# The path of a Service Account JSON file if serviceaccount}
    source_to_build: ${27:# The repo and ref of the repository from which to build}
    state: ${28:# Whether the resource should exist in GCP}
    substitutions: ${29:# Substitutions data for Build resource}
    tags: ${30:# Tags for annotation of a BuildTrigger}
    trigger_template: ${31:# Template describing the types of source changes to trigger a build}
    webhook_config: ${32:# WebhookConfig describes the configuration of a trigger that creates a build whenever a webhook is sent to a trigger's webhook URL}
  tags:
    - google
    - cloud
    - gcp_cloudbuild_trigger]]></content>
  <tabTrigger>google.cloud.gcp_cloudbuild_trigger</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Creates a GCP CloudBuild</description>
</snippet>