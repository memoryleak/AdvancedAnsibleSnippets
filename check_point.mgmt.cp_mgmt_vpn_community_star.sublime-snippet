<snippet>
  <content><![CDATA[- name: ${1:Manages vpn-community-star objects on Check Point over Web Services API}
  check_point.mgmt.cp_mgmt_vpn_community_star:
    advanced_properties: ${2:# Advanced properties}
    auto_publish_session: ${3:# Publish the current session if changes have been performed after task completes}
    center_gateways: ${4:# Collection of center VPN Gateway and VPN Device objects identified by the name or UID}
    color: ${5:# Color of the object}
    comments: ${6:# Comments string}
    details_level: ${7:# The level of detail for some of the fields in the response can vary from showing only the UID value of the object to a fully detailed representation of the object}
    disable_nat: ${8:# Indicates whether to disable NAT inside the VPN Community}
    disable_nat_on: ${9:# Indicates on which gateways to disable NAT inside the VPN Community}
    encrypted_traffic: ${10:# Encrypted traffic settings}
    encryption_method: ${11:# The encryption method to be used}
    encryption_suite: ${12:# The encryption suite to be used}
    excluded_services: ${13:# Collection of services that are excluded from the community identified by the name or UID}
    granular_encryptions: ${14:# VPN granular encryption settings}
    ignore_errors: ${15:# Apply changes ignoring errors}
    ignore_warnings: ${16:# Apply changes ignoring warnings}
    ike_phase_1: ${17:# Ike Phase 1 settings}
    ike_phase_2: ${18:# Ike Phase 2 settings}
    mep: ${19:# Multiple Entry Point properties}
    mesh_center_gateways: ${20:# Indicates whether the meshed community is in center}
    name: ${21:# Object name}
    override_vpn_domains: ${22:# The Overrides VPN Domains of the participants GWs}
    permanent_tunnels: ${23:# Permanent tunnels properties}
    routing_mode: ${24:# VPN Community Routing Mode}
    satellite_gateways: ${25:# Collection of Gateway objects representing satellite gateways identified by the name or UID}
    shared_secrets: ${26:# Shared secrets for external gateways}
    state: ${27:# State of the access rule (present or absent)}
    tags: ${28:# Collection of tag identifiers}
    tunnel_granularity: ${29:# VPN tunnel sharing option to be used}
    use_shared_secret: ${30:# Indicates whether the shared secret should be used for all external gateways}
    version: ${31:# Version of checkpoint}
    vpn_routing: ${32:# Enable VPN routing to satellites}
    wait_for_task: ${33:# Wait for the task to end}
    wait_for_task_timeout: ${34:# How many minutes to wait until throwing a timeout error}
    wire_mode: ${35:# VPN Community Wire mode properties}
  tags:
    - check_point
    - mgmt
    - cp_mgmt_vpn_community_star]]></content>
