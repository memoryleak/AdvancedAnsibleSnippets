<snippet>
  <content><![CDATA[- name: ${1:UUID Pool configuration for Cisco Intersight}
  cisco.intersight.intersight_uuid_pool:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    description: ${5:# The user-defined description of the UUID Pool}
    name: ${6:# The name assigned to the UUID Pool}
    organization: ${7:# The name of the Organization this resource is assigned to}
    prefix: ${8:# The UUID prefix used for all UUID suffix blocks}
    state: ${9:# If C(present), will verify the resource is present and will create if needed}
    tags: ${10:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    use_proxy: ${11:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    uuid_suffix_blocks: ${12:# List of UUID suffix blocks that define the range of UUIDs available in the pool}
    validate_certs: ${13:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_uuid_pool]]></content>
  <tabTrigger>cisco.intersight.intersight_uuid_pool</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>UUID Pool configuration for Cisco Intersight</description>
</snippet>