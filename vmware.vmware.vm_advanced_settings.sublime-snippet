<snippet>
  <content><![CDATA[- name: ${1:Manages the advanced settings for a VM}
  vmware.vmware.vm_advanced_settings:
    datacenter: ${2:# The name of the datacenter to search for the VM}
    folder: ${3:# Destination folder, absolute or relative path to find an existing guest}
    folder_paths_are_absolute: ${4:# If true, any folder path parameters are treated as absolute paths}
    hostname: ${5:# The hostname or IP address of the vSphere vCenter server}
    moid: ${6:# Managed Object ID of the instance to manage if known, this is a unique identifier only within a single vCenter instance}
    name: ${7:# Name of the virtual machine to work with}
    name_match: ${8:# If multiple virtual machines matching the name, use the first or last found}
    password: ${9:# The password of the vSphere vCenter server}
    port: ${10:# The port number of the vSphere vCenter server}
    proxy_host: ${11:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${12:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    settings: ${13:# A dictionary that describes the advanced settings you want to manage}
    state: ${14:# Set the state of the advanced settings on the VM}
    use_instance_uuid: ${15:# Whether to use the VMware instance UUID rather than the BIOS UUID}
    username: ${16:# The username of the vSphere vCenter server}
    uuid: ${17:# UUID of the instance to manage if known, this is VMware's unique identifier}
    validate_certs: ${18:# Allows connection when SSL certificates are not valid}
  tags:
    - vmware
    - vmware
    - vm_advanced_settings]]></content>
  <tabTrigger>vmware.vmware.vm_advanced_settings</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manages the advanced settings for a VM</description>
</snippet>