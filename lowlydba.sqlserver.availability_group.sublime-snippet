<snippet>
  <content><![CDATA[- name: ${1:Configures availability group(s)}
  lowlydba.sqlserver.availability_group:
    ag_name: ${2:# Name of the Availability Group}
    all_ags: ${3:# Apply changes to all availability groups on the instance}
    allow_null_backup: ${4:# Allow taking a full backup to C(NULL) if one does not exist and I(seeding_mode=Automatic)}
    automated_backup_preference: ${5:# How to handle backup requests by default}
    availability_mode: ${6:# Whether the replica should be Asynchronous or Synchronous}
    basic_availability_group: ${7:# Indicates whether the availability group is Basic Availability Group}
    cluster_type: ${8:# Cluster type of the Availability Group}
    contained_availability_group: ${9:# Indicates whether the availability group is Contained}
    database: ${10:# Name of the database to create the Availability Group for}
    database_health_trigger: ${11:# Indicates whether the availability group triggers the database health}
    dtc_support_enabled: ${12:# Enables Dtc support}
    failover_mode: ${13:# Whether the replica have Automatic or Manual failover}
    failure_condition_level: ${14:# Specifies the different conditions that can trigger an automatic failover in Availability Group}
    force: ${15:# Drop and recreate the database on remote servers using fresh backup}
    healthcheck_timeout: ${16:# This setting used to specify the length of time, in milliseconds, that the SQL Server resource DLL should wait for information returned by the C(sp_server_diagnostics) stored procedure before reporting the Always On Failover Cluster Instance (FCI) as unresponsive}
    is_distributed_ag: ${17:# Indicates whether the availability group is distributed}
    seeding_mode: ${18:# Default seeding mode for the replica}
    shared_path: ${19:# The network share where the backups will be backed up and restored from}
    sql_instance: ${20:# The SQL Server instance to modify}
    sql_instance_secondary: ${21:# The secondary SQL Server instance for the new Availability Group}
    sql_password: ${22:# Password for SQL Authentication}
    sql_password_secondary: ${23:# Password for SQL Authentication for the secondary replica}
    sql_username: ${24:# Username for SQL Authentication}
    sql_username_secondary: ${25:# Username for SQL Authentication for the secondary replica}
    state: ${26:# Whether or not the object should be C(present) or C(absent)}
    use_last_backup: ${27:# Use the last full and log backup of database}
  tags:
    - lowlydba
    - sqlserver
    - availability_group]]></content>
  <tabTrigger>lowlydba.sqlserver.availability_group</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Configures availability group(s)</description>
</snippet>