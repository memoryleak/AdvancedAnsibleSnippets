<snippet>
  <content><![CDATA[- name: ${1:Manage service apply rules in Icinga2}
  telekom_mms.icinga_director.icinga_service_apply:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    append: ${3:# Do not overwrite the whole object but instead append the defined properties}
    apply_for: ${4:# Evaluates the apply for rule for all objects with the custom attribute specified}
    assign_filter: ${5:# The filter where the service apply rule will take effect}
    check_command: ${6:# Check command definition}
    check_interval: ${7:# Your regular check interval}
    check_period: ${8:# The name of a time period which determines when this object should be monitored}
    check_timeout: ${9:# Check command timeout in seconds}
    client_cert: ${10:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${11:# PEM formatted file that contains your private key to be used for SSL client authentication}
    command_endpoint: ${12:# The host where the service should be executed on}
    display_name: ${13:# Alternative displayed name of the service apply rule}
    enable_active_checks: ${14:# Whether to actively check this object}
    enable_event_handler: ${15:# Whether to enable event handlers this object}
    enable_notifications: ${16:# Whether to send notifications for this object}
    enable_passive_checks: ${17:# Whether to accept passive check results for this object}
    enable_perfdata: ${18:# Whether to process performance data provided by this object}
    event_command: ${19:# Event command for service which gets called on every check execution if one of these conditions matches}
    force: ${20:# If V(yes) do not get a cached copy}
    force_basic_auth: ${21:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    groups: ${22:# Service groups that should be directly assigned to this service}
    http_agent: ${23:# Header to identify as, generally appears in web server logs}
    imports: ${24:# Importable templates, add as many as you want}
    max_check_attempts: ${25:# Defines after how many check attempts a new hard state is reached}
    notes: ${26:# Additional notes for this object}
    notes_url: ${27:# An URL pointing to additional notes for this object}
    object_name: ${28:# Name for the Icinga service apply rule}
    retry_interval: ${29:# Retry interval, will be applied after a state change unless the next hard state is reached}
    state: ${30:# Apply feature state}
    url: ${31:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${32:# The password for use in HTTP basic authentication}
    url_username: ${33:# The username for use in HTTP basic authentication}
    use_gssapi: ${34:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${35:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${36:# If V(no), SSL certificates will not be validated}
    vars: ${37:# Custom properties of the service apply rule}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_service_apply]]></content>
