<snippet>
  <content><![CDATA[- name: ${1:Package manager for FreeBSD >= 9}
  community.general.pkgng:
    annotation: ${2:# A list of keyvalue-pairs of the form C(<+/-/:><key>[=<value>])}
    autoremove: ${3:# Remove automatically installed packages which are no longer needed}
    cached: ${4:# Use local package base instead of fetching an updated one}
    chroot: ${5:# Pkg chroots in the specified environment}
    ignore_osver: ${6:# Ignore FreeBSD OS version check, useful on C(-STABLE) and C(-CURRENT) branches}
    jail: ${7:# Pkg executes in the given jail name or ID}
    name: ${8:# Name or list of names of packages to install/remove}
    pkgsite: ${9:# For C(pkgng) versions before 1}
    rootdir: ${10:# For C(pkgng) versions 1}
    state: ${11:# State of the package}
    use_globs: ${12:# Treat the package names as shell glob patterns}
  tags:
    - community
    - general
    - pkgng]]></content>
  <tabTrigger>community.general.pkgng</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Package manager for FreeBSD &gt;= 9</description>
</snippet>