<snippet>
  <content><![CDATA[- name: ${1:Create, update and delete Activity Log Alerts}
  azure.azcollection.azure_rm_monitoractivitylogalerts:
    actions: ${2:# The actions that will activate when the condition is met}
    ad_user: ${3:# Active Directory username}
    adfs_authority_url: ${4:# Azure AD authority url}
    api_profile: ${5:# Selects an API profile to use when communicating with Azure services}
    append_tags: ${6:# Use to control if tags field is canonical or just appends to existing tags}
    auth_source: ${7:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${8:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${9:# Azure client ID}
    cloud_environment: ${10:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    condition: ${11:# The condition that will cause this alert to activate}
    description: ${12:# A description of this Activity Log Alert rule}
    disable_instance_discovery: ${13:# Determines whether or not instance discovery is performed when attempting to authenticate}
    enabled: ${14:# Indicates whether this activity log alert is enabled}
    location: ${15:# Location of the activity log alert}
    log_mode: ${16:# Parent argument}
    log_path: ${17:# Parent argument}
    name: ${18:# The name of the activity log alert you're creating, updating or deleting}
    password: ${19:# Active Directory user password}
    profile: ${20:# Security profile found in ~/}
    resource_group: ${21:# The name of the resource group}
    scopes: ${22:# A list of resource IDs that will be used as prefixes}
    secret: ${23:# Azure client secret}
    state: ${24:# State of the activity log alert}
    subscription_id: ${25:# Your Azure subscription Id}
    tags: ${26:# Dictionary of string:string pairs to assign as metadata to the object}
    tenant: ${27:# Azure tenant ID}
    thumbprint: ${28:# The thumbprint of the private key specified in I(x509_certificate_path)}
    x509_certificate_path: ${29:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_monitoractivitylogalerts]]></content>
  <tabTrigger>azure.azcollection.azure_rm_monitoractivitylogalerts</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Create, update and delete Activity Log Alerts</description>
