  <content><![CDATA[- name: ${1:Creates a GCP Alloydb}
  google.cloud.gcp_alloydb_cluster:
    access_token: ${2:# The access token used to authenticate}
    annotations: ${3:# Annotations to allow client tools to store small amount of arbitrary data}
    auth_kind: ${4:# The type of credential used}
    automated_backup_policy: ${5:# The automated backup policy for this cluster}
    cluster_id: ${6:# The ID of the alloydb cluster}
    cluster_type: ${7:# The type of cluster}
    continuous_backup_config: ${8:# The continuous backup config for this cluster}
    database_version: ${9:# The database engine major version}
    display_name: ${10:# User-settable and human-readable display name for the Cluster}
    encryption_config: ${11:# EncryptionConfig describes the encryption config of a cluster or a backup that is encrypted with a CMEK (customer-managed encryption key)}
    env_type: ${12:# Specifies which Ansible environment you're running this module within}
    etag: ${13:# For Resource freshness validation (https://google}
    initial_user: ${14:# Initial user to setup during cluster creation}
    labels: ${15:# User-defined labels for the alloydb cluster}
    location: ${16:# The location where the alloydb cluster should reside}
    maintenance_update_policy: ${17:# MaintenanceUpdatePolicy defines the policy for system updates}
    network_config: ${18:# Metadata related to network configuration}
    project: ${19:# The Google Cloud Platform project to use}
    psc_config: ${20:# Configuration for Private Service Connect (PSC) for the cluster}
    restore_backup_source: ${21:# The source when restoring from a backup}
    restore_continuous_backup_source: ${22:# The source when restoring via point in time recovery (PITR)}
