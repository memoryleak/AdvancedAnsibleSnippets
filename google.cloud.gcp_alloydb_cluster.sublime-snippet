    service_account_file: ${27:# The path of a Service Account JSON file if serviceaccount}
    state: ${28:# Whether the resource should exist in GCP}
    subscription_type: ${29:# The subscrition type of cluster}
  tags:
    - google
    - cloud
    - gcp_alloydb_cluster]]></content>
