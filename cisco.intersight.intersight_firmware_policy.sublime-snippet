<snippet>
  <content><![CDATA[- name: ${1:Firmware Policy configuration for Cisco Intersight}
  cisco.intersight.intersight_firmware_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    description: ${5:# The user-defined description for the Firmware Policy}
    exclude_drives: ${6:# When set to C(true), excludes local disk drives from firmware upgrades}
    exclude_storage_controllers: ${7:# When set to C(true), excludes storage controllers from firmware upgrades}
    model_bundle_combo: ${8:# List of server model and firmware version pairs}
    name: ${9:# The name assigned to the Firmware Policy}
    organization: ${10:# The name of the Organization this resource is assigned to}
    state: ${11:# If C(present), will verify the resource is present and will create if needed}
    tags: ${12:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    target_platform: ${13:# The platform type for which the firmware policy is intended}
    use_proxy: ${14:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${15:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_firmware_policy]]></content>
  <tabTrigger>cisco.intersight.intersight_firmware_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Firmware Policy configuration for Cisco Intersight</description>
</snippet>