<snippet>
  <content><![CDATA[- name: ${1:Manages a Django application}
  community.general.django_manage:
    apps: ${2:# A list of space-delimited apps to target}
    cache_table: ${3:# The name of the table used for database-backed caching}
    clear: ${4:# Clear the existing files before trying to copy or link the original file}
    command: ${5:# The name of the Django management command to run}
    database: ${6:# The database to target}
    failfast: ${7:# Fail the command immediately if a test fails}
    fixtures: ${8:# A space-delimited list of fixture file names to load in the database}
    link: ${9:# Creates links to the files instead of copying them, you can only use this parameter with V(collectstatic) command}
    merge: ${10:# Runs out-of-order or missing migrations as they are not rollback migrations, you can only use this parameter with V(migrate) command}
    project_path: ${11:# The path to the root of the Django application where C(manage}
    pythonpath: ${12:# A directory to add to the Python path}
    settings: ${13:# The Python path to the application's settings module, such as V(myapp}
    skip: ${14:# Skips over out-of-order missing migrations, you can only use this parameter with V(migrate) command}
    testrunner: ${15:# Controls the test runner class that is used to execute tests}
    virtualenv: ${16:# An optional path to a C(virtualenv) installation to use while running the manage application}
  tags:
    - community
    - general
    - django_manage]]></content>
