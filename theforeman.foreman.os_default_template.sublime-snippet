<snippet>
  <content><![CDATA[- name: ${1:Manage Default Template Associations To Operating Systems}
  theforeman.foreman.os_default_template:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    operatingsystem: ${3:# Operating systems are looked up by their title which is composed as '<name> <major>}
    password: ${4:# Password of the user accessing the Foreman server}
    provisioning_template: ${5:# name of provisioning template}
    server_url: ${6:# URL of the Foreman server}
    state: ${7:# State of the entity}
    template_kind: ${8:# name of the template kind}
    use_gssapi: ${9:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${10:# Username accessing the Foreman server}
    validate_certs: ${11:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - os_default_template]]></content>
  <tabTrigger>theforeman.foreman.os_default_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Default Template Associations To Operating Systems</description>
</snippet>