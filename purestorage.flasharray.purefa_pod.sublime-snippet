<snippet>
  <content><![CDATA[- name: ${1:Manage AC pods in Pure Storage FlashArrays}
  purestorage.flasharray.purefa_pod:
    api_token: ${2:# FlashArray API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    default_protection_pg: ${4:# Name of the default protection default for the pod}
    delete_contents: ${5:# This enables you to eradicate pods with contents}
    disable_warnings: ${6:# Disable insecure certificate warnings in debug logs}
    eradicate: ${7:# Define whether to eradicate the pod on delete or leave in trash}
    fa_url: ${8:# FlashArray management IPv4 address or Hostname}
    failover: ${9:# The name of the array given priority to stay online if arrays loose contact with each other}
    ignore_usage: ${10:# Flag used to override checks for quota management operations}
    mediator: ${11:# Name of the mediator to use for a pod}
    name: ${12:# The name of the pod}
    promote: ${13:# Promote/demote any pod not in a stretched relationship}
    quiesce: ${14:# Quiesce/Skip quiesce when I(promote) is false and demoting an ActiveDR pod}
    quota: ${15:# Logical quota limit of the pod in K, M, G, T or P units, or bytes}
    retention_lock: ${16:# Define if I(default_protection_pg) has retention lock enabled}
    state: ${17:# Define whether the pod should exist or not}
    stretch: ${18:# The name of the array to stretch to/unstretch from}
    target: ${19:# Name of clone target pod}
    throttle: ${20:# Allows pod creation to fail if array health is not optimal}
    undo: ${21:# Use the I(undo-remote) pod when I(promote) is true and promoting an ActiveDR pod}
    with_default_protection: ${22:# Whether to keep the default container protection for the pod}
  tags:
    - purestorage
    - flasharray
    - purefa_pod]]></content>
  <tabTrigger>purestorage.flasharray.purefa_pod</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage AC pods in Pure Storage FlashArrays</description>
</snippet>