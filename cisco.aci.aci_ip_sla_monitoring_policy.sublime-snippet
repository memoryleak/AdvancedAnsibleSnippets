<snippet>
  <content><![CDATA[- name: ${1:Manage IP SLA Monitoring Policies (fv:IPSLAMonitoringPol)}
  cisco.aci.aci_ip_sla_monitoring_policy:
    annotation: ${2:# User-defined string for annotating an object}
    certificate_name: ${3:# The X}
    description: ${4:# The SLA Policy description}
    frequency: ${5:# Defines the interval at which probes are conducted}
    host: ${6:# IP Address or hostname of APIC resolvable by Ansible control host}
    http_uri: ${7:# The HTTP URI to use as the SLA destination}
    http_version: ${8:# The HTTP version to use}
    multiplier: ${9:# Specifies the number of consecutive probe failures required to determine the SLA as down}
    name: ${10:# The SLA Policy name}
    operation_timeout: ${11:# The amount of time in milliseconds that the IP SLA operation waits for a response from its request packet}
    output_level: ${12:# Influence the output of this ACI module}
    output_path: ${13:# Path to a file that will be used to dump the ACI JSON configuration objects generated by the module}
    owner_key: ${14:# User-defined string for the ownerKey attribute of an ACI object}
    owner_tag: ${15:# User-defined string for the ownerTag attribute of an ACI object}
    password: ${16:# The password to use for authentication}
    port: ${17:# Port number to be used for REST connection}
    private_key: ${18:# Either a PEM-formatted private key file or the private key content used for signature-based authentication}
    request_data_size: ${19:# The number of bytes to send in the request}
    sla_port: ${20:# The Port to monitor for TCP SLAs}
    sla_type: ${21:# The type of monitoring}
    state: ${22:# Use C(present) or C(absent) for adding or removing}
    suppress_previous: ${23:# If C(true), a GET to check previous will not be sent before a POST update to APIC}
    suppress_verification: ${24:# If C(true), a verifying GET will not be sent after a POST update to APIC}
    tenant: ${25:# The name of an existing tenant}
    threshold: ${26:# The upper threshold value in milliseconds for calculating network monitoring statistics created by the IP SLA operation}
    timeout: ${27:# The socket level timeout in seconds}
    traffic_class: ${28:# Sets the Traffic Class value in the IPv6 header}
    type_of_service: ${29:# The Type of Service (ToS) value to set in the IPv4 header}
    use_proxy: ${30:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${31:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${32:# The username to use for authentication}
    validate_certs: ${33:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - aci
    - aci_ip_sla_monitoring_policy]]></content>
