<snippet>
  <content><![CDATA[- name: ${1:Manage Hostgroups}
  theforeman.foreman.hostgroup:
    activation_keys: ${2:# Activation Keys used for deployment}
    ansible_roles: ${3:# A list of ansible roles to associate with the hostgroup}
    architecture: ${4:# Architecture name}
    ca_path: ${5:# PEM formatted file that contains a CA certificate to be used for validation}
    compute_profile: ${6:# Compute profile name}
    compute_resource: ${7:# Compute resource name}
    config_groups: ${8:# Config groups list}
    content_source: ${9:# Content Source (Smart Proxy with Content) name}
    content_view: ${10:# Content view}
    description: ${11:# Description of hostgroup}
    domain: ${12:# Domain name}
    environment: ${13:# Puppet environment name}
    kickstart_repository: ${14:# Kickstart repository name}
    lifecycle_environment: ${15:# Lifecycle environment}
    locations: ${16:# List of locations the entity should be assigned to}
    medium: ${17:# Medium name}
    name: ${18:# Name of hostgroup}
    openscap_proxy: ${19:# OpenSCAP proxy name}
    operatingsystem: ${20:# Operating systems are looked up by their title which is composed as '<name> <major>}
    organization: ${21:# Organization for scoped resources attached to the hostgroup}
    organizations: ${22:# List of organizations the entity should be assigned to}
    parameters: ${23:# Hostgroup specific host parameters}
    parent: ${24:# Title of the parent Hostgroup}
    password: ${25:# Password of the user accessing the Foreman server}
    ptable: ${26:# Partition table name}
    puppet_ca_proxy: ${27:# Puppet CA proxy name}
    puppet_proxy: ${28:# Puppet server proxy name}
    puppetclasses: ${29:# List of puppet classes to include in this host group}
    pxe_loader: ${30:# PXE Bootloader}
    realm: ${31:# Realm name}
    root_pass: ${32:# Root password}
    server_url: ${33:# URL of the Foreman server}
    state: ${34:# State of the entity}
    subnet: ${35:# IPv4 Subnet name}
    subnet6: ${36:# IPv6 Subnet name}
    updated_name: ${37:# New name of hostgroup}
    use_gssapi: ${38:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${39:# Username accessing the Foreman server}
    validate_certs: ${40:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - hostgroup]]></content>
  <tabTrigger>theforeman.foreman.hostgroup</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Hostgroups</description>
</snippet>