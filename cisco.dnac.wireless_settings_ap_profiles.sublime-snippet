<snippet>
  <content><![CDATA[- name: ${1:Resource module for Wireless Settings Ap Profiles}
  cisco.dnac.wireless_settings_ap_profiles:
    apPowerProfileName: ${2:# Name of the existing AP power profile}
    apProfileName: ${3:# Name of the Access Point profile}
    awipsEnabled: ${4:# Indicates if AWIPS is enabled on the AP}
    awipsForensicEnabled: ${5:# Indicates if AWIPS forensic is enabled on the AP}
    calendarPowerProfiles: ${6:# Wireless Settings Ap Profiles's calendarPowerProfiles}
    clientLimit: ${7:# Number of clients}
    countryCode: ${8:# Country Code}
    description: ${9:# Description of the AP profile}
    dnac_debug: ${10:# Flag for Cisco DNA Center SDK to enable debugging}
    dnac_host: ${11:# The Cisco DNA Center hostname}
    dnac_password: ${12:# The Cisco DNA Center password to authenticate}
    dnac_port: ${13:# The Cisco DNA Center port}
    dnac_username: ${14:# The Cisco DNA Center username to authenticate}
    dnac_verify: ${15:# Flag to enable or disable SSL certificate verification}
    dnac_version: ${16:# Informs the SDK which version of Cisco DNA Center to use}
    id: ${17:# Id path parameter}
    managementSetting: ${18:# Wireless Settings Ap Profiles's managementSetting}
    meshEnabled: ${19:# This indicates whether mesh networking is enabled on the AP}
    meshSetting: ${20:# Wireless Settings Ap Profiles's meshSetting}
    pmfDenialEnabled: ${21:# Indicates if PMF denial is active on the AP}
    remoteWorkerEnabled: ${22:# Indicates if remote worker mode is enabled on the AP}
    rogueDetectionSetting: ${23:# Wireless Settings Ap Profiles's rogueDetectionSetting}
    timeZone: ${24:# In the Time Zone area, choose one of the following options}
    timeZoneOffsetHour: ${25:# Enter the hour value (HH)}
    timeZoneOffsetMinutes: ${26:# Enter the minute value (MM)}
    validate_response_schema: ${27:# Flag for Cisco DNA Center SDK to enable the validation of request bodies against a JSON schema}
  tags:
    - cisco
    - dnac
    - wireless_settings_ap_profiles]]></content>
  <tabTrigger>cisco.dnac.wireless_settings_ap_profiles</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Resource module for Wireless Settings Ap Profiles</description>
</snippet>