<snippet>
  <content><![CDATA[- name: ${1:Create, update and delete Scheduled query rules}
  azure.azcollection.azure_rm_monitorscheduledqueryrules:
    action: ${2:# The actions that will activate when the condition is met}
    ad_user: ${3:# Active Directory username}
    adfs_authority_url: ${4:# Azure AD authority url}
    api_profile: ${5:# Selects an API profile to use when communicating with Azure services}
    append_tags: ${6:# Use to control if tags field is canonical or just appends to existing tags}
    auth_source: ${7:# Controls the source of the credentials to use for authentication}
    auto_mitigate: ${8:# The flag that indicates whether the alert should be automatically resolved or not}
    cert_validation_mode: ${9:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${10:# Azure client ID}
    cloud_environment: ${11:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    description: ${12:# The description of the Log Search rule}
    disable_instance_discovery: ${13:# Determines whether or not instance discovery is performed when attempting to authenticate}
    display_name: ${14:# The display name of the alert rule}
    enabled: ${15:# The flag which indicates whether the Log Search rule is enabled}
    location: ${16:# Location of the scheduled query rule}
    log_mode: ${17:# Parent argument}
    log_path: ${18:# Parent argument}
    name: ${19:# The name of the scheduled query rule you're creating/changing}
    password: ${20:# Active Directory user password}
    profile: ${21:# Security profile found in ~/}
    resource_group: ${22:# The name of the resource group}
    schedule: ${23:# Schedule (Frequency, Time Window) for rule}
    secret: ${24:# Azure client secret}
    source: ${25:# Data Source against which rule will Query Data}
    state: ${26:# State of the scheduled query rule}
    subscription_id: ${27:# Your Azure subscription Id}
    tags: ${28:# Dictionary of string:string pairs to assign as metadata to the object}
