<snippet>
  <content><![CDATA[- name: ${1:Manage notifications in Icinga2}
  telekom_mms.icinga_director.icinga_notification:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    append: ${3:# Do not overwrite the whole object but instead append the defined properties}
    apply_to: ${4:# Whether this notification should affect hosts or services}
    assign_filter: ${5:# The filter where the notification will take effect}
    client_cert: ${6:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${7:# PEM formatted file that contains your private key to be used for SSL client authentication}
    disabled: ${8:# Disabled objects will not be deployed}
    force: ${9:# If V(yes) do not get a cached copy}
    force_basic_auth: ${10:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    http_agent: ${11:# Header to identify as, generally appears in web server logs}
    imports: ${12:# Importable templates, add as many as you want}
    notification_interval: ${13:# The notification interval (in seconds)}
    object_name: ${14:# Name of the notification}
    period: ${15:# The name of a time period which determines when this notification should be triggered}
    state: ${16:# Apply feature state}
    states: ${17:# The host or service states you want to get notifications for}
    times_begin: ${18:# First notification delay}
    times_end: ${19:# Last notification}
    types: ${20:# The state transition types you want to get notifications for}
    url: ${21:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${22:# The password for use in HTTP basic authentication}
    url_username: ${23:# The username for use in HTTP basic authentication}
    use_gssapi: ${24:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${25:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    user_groups: ${26:# User Groups that should be notified by this notification}
    users: ${27:# Users that should be notified by this notification}
    validate_certs: ${28:# If V(no), SSL certificates will not be validated}
    vars: ${29:# Custom properties of the notification}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_notification]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_notification</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage notifications in Icinga2</description>
</snippet>