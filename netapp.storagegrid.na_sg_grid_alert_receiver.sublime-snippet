    smtp_port: ${13:# The port to use to communicate with the SMTP server}
    smtp_username: ${14:# Username for the SMTP server}
    state: ${15:# Whether the alert receiver should be present or absent}
    to_emails: ${16:# List of recipient email addresses}
    type: ${17:# The type of notification receiver}
    username: ${18:# Use C(smtp_username) instead}
