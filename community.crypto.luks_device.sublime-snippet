<snippet>
  <content><![CDATA[- name: ${1:Manage encrypted (LUKS) devices}
  community.crypto.luks_device:
    allow_discards: ${2:# Allow discards (also known as TRIM) requests for device}
    cipher: ${3:# This option allows the user to define the cipher specification string for the LUKS container}
    device: ${4:# Device to work with (for example V(/dev/sda1))}
    force_remove_last_key: ${5:# If set to V(true), allows removing the last key from a container}
    hash: ${6:# This option allows the user to specify the hash function used in LUKS key setup scheme and volume key digest}
    keyfile: ${7:# Used to unlock the container}
    keysize: ${8:# Sets the key size only if LUKS container does not exist}
    keyslot: ${9:# Adds the O(keyfile) or O(passphrase) to a specific keyslot when creating a new container on O(device)}
    keyslot_priority: ${10:# Sets the keyslot priority for the keyslot specified by O(keyslot)}
    label: ${11:# This option allow the user to create a LUKS2 format container with label support, respectively to identify the container by label on later usages}
    name: ${12:# Sets container name when O(state=opened)}
    new_keyfile: ${13:# Adds additional key to given container on O(device)}
    new_keyslot: ${14:# Adds the additional O(new_keyfile) or O(new_passphrase) to a specific keyslot on the given O(device)}
    new_passphrase: ${15:# Adds additional passphrase to given container on O(device)}
    new_tpm2: ${16:# Adds a TPM2 security chip to given container on O(device)}
    new_tpm2_pcrs: ${17:# TPM2 PCRs (Platform Configuration Registers) to bind to}
    passphrase: ${18:# Used to unlock the container}
    passphrase_encoding: ${19:# Determine how passphrases are provided to parameters such as O(passphrase), O(new_passphrase), and O(remove_passphrase)}
    pbkdf: ${20:# This option allows the user to configure the Password-Based Key Derivation Function (PBKDF) used}
    perf_no_read_workqueue: ${21:# Allows the user to bypass dm-crypt internal workqueue and process read requests synchronously}
    perf_no_write_workqueue: ${22:# Allows the user to bypass dm-crypt internal workqueue and process write requests synchronously}
    perf_same_cpu_crypt: ${23:# Allows the user to perform encryption using the same CPU that IO was submitted on}
    perf_submit_from_crypt_cpus: ${24:# Allows the user to disable offloading writes to a separate thread after encryption}
    persistent: ${25:# Allows the user to store options into container's metadata persistently and automatically use them next time}
    remove_keyfile: ${26:# Removes given key from the container on O(device)}
    remove_keyslot: ${27:# Removes the key in the given slot on O(device)}
    remove_passphrase: ${28:# Removes given passphrase from the container on O(device)}
    remove_tpm2: ${29:# Removes B(all) key slots on O(device) that are unlocked by a TPM2 device}
    sector_size: ${30:# This option allows the user to specify the sector size (in bytes) used for LUKS2 containers}
    state: ${31:# Desired state of the LUKS container}
    tpm2_device: ${32:# Used to unlock the container, but can not be used for container creation}
    type: ${33:# This option allow the user explicit define the format of LUKS container that wants to work with}
    uuid: ${34:# With this option user can identify the LUKS container by UUID}
  tags:
    - community
    - crypto
    - luks_device]]></content>
  <tabTrigger>community.crypto.luks_device</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage encrypted (LUKS) devices</description>
</snippet>