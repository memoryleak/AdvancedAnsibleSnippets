<snippet>
  <content><![CDATA[- name: ${1:This module manages storage partition on IBM Storage Virtualize family systems}
  ibm.storage_virtualize.ibm_sv_manage_storage_partition:
    clustername: ${2:# The hostname or management IP of the Storage Virtualize system}
    deletenonpreferredmanagementobjects: ${3:# If the storage partition has a replication policy and associated objects, such as volumes, volumes groups, hosts or host mappings, one of the two I(deletenonpreferredmanagementobjects) or I(deletepreferredmanagementobjects) parmeters is required}
    deletepreferredmanagementcopy: ${4:# This parameter is to be used along with I(noreplicationpolicy) parameter and active management system must NOT be the same as the preferred management system}
    deletepreferredmanagementobjects: ${5:# If the storage partition has a replication policy and associated objects, such as volumes, volumes groups, hosts or host mappings, one of the two I(deletenonpreferredmanagementobjects) or I(deletepreferredmanagementobjects) parmeters is required}
    domain: ${6:# Domain for the Storage Virtualize system}
    draft: ${7:# If specified and set to true, creates a partition in draft state}
    drlink_partition_uuid: ${8:# Specifies uuid of the disaster-recovery system's partition}
    location: ${9:# Specifies a desired target system location to migrate an existing storage partition}
    log_path: ${10:# Path of debug log file}
    managementportset: ${11:# Specifies management portset to be assigned to partition}
    migrationaction: ${12:# Indicates how the partition migration should continue on target system}
    name: ${13:# Specifies the name of a storage partition}
    nomanagementportset: ${14:# Removes the management portset from the partition}
    noreplicationpolicy: ${15:# Unassigns the current replication policy from the volume group}
    old_name: ${16:# Specifies the name of the storage partition to be renamed}
    partition_to_merge: ${17:# If specified, merges the I(partition_to_merge) and all its objects into partition specified with I(name)}
    password: ${18:# REST API password for the Storage Virtualize system}
    preferredmanagementsystem: ${19:# Changes the preferred management system for the storage partition}
    remotesystem: ${20:# Specifies the disaster-recovery system}
    removedrlink: ${21:# Removes the disaster recovery link from this partition}
    replicationpolicy: ${22:# Specifies the replication policy for the storage partition}
    state: ${23:# Creates, updates (C(present)) or deletes (C(absent)) a storage partition}
    token: ${24:# The authentication token to verify a user on the Storage Virtualize system}
    username: ${25:# REST API username for the Storage Virtualize system}
    validate_certs: ${26:# Validates certification}
  tags:
    - ibm
    - storage_virtualize
    - ibm_sv_manage_storage_partition]]></content>
  <tabTrigger>ibm.storage_virtualize.ibm_sv_manage_storage_partition</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>This module manages storage partition on IBM Storage Virtualize family systems</description>
</snippet>