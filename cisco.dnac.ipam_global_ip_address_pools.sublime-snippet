<snippet>
  <content><![CDATA[- name: ${1:Resource module for Ipam Global Ip Address Pools}
  cisco.dnac.ipam_global_ip_address_pools:
    addressSpace: ${2:# Ipam Global Ip Address Pools's addressSpace}
    dnac_debug: ${3:# Flag for Cisco DNA Center SDK to enable debugging}
    dnac_host: ${4:# The Cisco DNA Center hostname}
    dnac_password: ${5:# The Cisco DNA Center password to authenticate}
    dnac_port: ${6:# The Cisco DNA Center port}
    dnac_username: ${7:# The Cisco DNA Center username to authenticate}
    dnac_verify: ${8:# Flag to enable or disable SSL certificate verification}
    dnac_version: ${9:# Informs the SDK which version of Cisco DNA Center to use}
    id: ${10:# Id path parameter}
    name: ${11:# The name for this reserve IP pool}
    poolType: ${12:# Once created, a global pool type cannot be changed}
    validate_response_schema: ${13:# Flag for Cisco DNA Center SDK to enable the validation of request bodies against a JSON schema}
