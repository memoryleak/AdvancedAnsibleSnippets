<snippet>
  <content><![CDATA[- name: ${1:Manages user objects on Checkpoint over Web Services API}
  check_point.mgmt.cp_mgmt_user:
    allowed_locations: ${2:# User allowed locations}
    authentication_method: ${3:# Authentication method}
    auto_publish_session: ${4:# Publish the current session if changes have been performed after task completes}
    color: ${5:# Color of the object}
    comments: ${6:# Comments string}
    connect_daily: ${7:# Connect every day}
    connect_on_days: ${8:# Days users allow to connect}
    details_level: ${9:# The level of detail for some of the fields in the response can vary from showing only the UID value of the object to a fully detailed representation of the object}
    email: ${10:# User email}
    encryption: ${11:# User encryption}
    expiration_date: ${12:# Expiration date in format, yyyy-MM-dd}
    from_hour: ${13:# Allow users connect from hour}
    groups: ${14:# Collection of group identifiers}
    ignore_errors: ${15:# Apply changes ignoring errors}
    ignore_warnings: ${16:# Apply changes ignoring warnings}
    name: ${17:# Object name}
    password: ${18:# Check Point password authentication method identified by the name or UID}
    phone_number: ${19:# User phone number}
    radius_server: ${20:# RADIUS server object identified by the name or UID}
    state: ${21:# State of the access rule (present or absent)}
    tacacs_server: ${22:# TACACS server object identified by the name or UID}
    tags: ${23:# Collection of tag identifiers}
    template: ${24:# User template name or UID}
    to_hour: ${25:# Allow users connect until hour}
    version: ${26:# Version of checkpoint}
    wait_for_task: ${27:# Wait for the task to end}
    wait_for_task_timeout: ${28:# How many minutes to wait until throwing a timeout error}
