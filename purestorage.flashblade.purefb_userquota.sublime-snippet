<snippet>
  <content><![CDATA[- name: ${1:Manage filesystem user quotas}
  purestorage.flashblade.purefb_userquota:
    api_token: ${2:# FlashBlade API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    disable_warnings: ${4:# Disable insecure certificate warnings}
    fb_url: ${5:# FlashBlade management IP address or Hostname}
    name: ${6:# Filesystem Name}
    quota: ${7:# User quota in M, G, T or P units}
    state: ${8:# Create, delete or modifies a quota}
    uid: ${9:# The user id on which the quota is enforced}
    uname: ${10:# The user name on which the quota is enforced}
  tags:
    - purestorage
    - flashblade
    - purefb_userquota]]></content>
  <tabTrigger>purestorage.flashblade.purefb_userquota</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage filesystem user quotas</description>
</snippet>