<snippet>
  <content><![CDATA[- name: ${1:Manage Smart Proxies}
  theforeman.foreman.smart_proxy:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    download_policy: ${3:# The download policy for the Smart Proxy}
    lifecycle_environments: ${4:# Lifecycle Environments synced to the Smart Proxy}
    locations: ${5:# List of locations the entity should be assigned to}
    name: ${6:# Name of the Smart Proxy}
    organizations: ${7:# List of organizations the entity should be assigned to}
    password: ${8:# Password of the user accessing the Foreman server}
    server_url: ${9:# URL of the Foreman server}
    state: ${10:# State of the entity}
    url: ${11:# URL of the Smart Proxy}
    use_gssapi: ${12:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${13:# Username accessing the Foreman server}
    validate_certs: ${14:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - smart_proxy]]></content>
  <tabTrigger>theforeman.foreman.smart_proxy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Smart Proxies</description>
</snippet>