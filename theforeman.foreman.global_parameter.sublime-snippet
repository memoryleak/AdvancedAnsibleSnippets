<snippet>
  <content><![CDATA[- name: ${1:Manage Global Parameters}
  theforeman.foreman.global_parameter:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    hidden_value: ${3:# Whether the value should be hidden in the GUI}
    name: ${4:# Name of the Global Parameter}
    parameter_type: ${5:# Type of value}
    password: ${6:# Password of the user accessing the Foreman server}
    server_url: ${7:# URL of the Foreman server}
    state: ${8:# State of the entity}
    updated_name: ${9:# New name of the Global Parameter}
    use_gssapi: ${10:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${11:# Username accessing the Foreman server}
    validate_certs: ${12:# Whether or not to verify the TLS certificates of the Foreman server}
    value: ${13:# Value of the Global Parameter}
  tags:
    - theforeman
    - foreman
    - global_parameter]]></content>
  <tabTrigger>theforeman.foreman.global_parameter</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Global Parameters</description>
</snippet>