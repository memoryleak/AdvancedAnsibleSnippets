<snippet>
  <content><![CDATA[- name: ${1:Manage dependency templates in Icinga2}
  telekom_mms.icinga_director.icinga_dependency_template:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    append: ${3:# Do not overwrite the whole object but instead append the defined properties}
    client_cert: ${4:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${5:# PEM formatted file that contains your private key to be used for SSL client authentication}
    disable_checks: ${6:# Whether to disable checks when this dependency fails}
    disable_notifications: ${7:# Whether to disable notifications when this dependency fails}
    force: ${8:# If V(yes) do not get a cached copy}
    force_basic_auth: ${9:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    http_agent: ${10:# Header to identify as, generally appears in web server logs}
    ignore_soft_states: ${11:# Whether to ignore soft states for the reachability calculation}
    object_name: ${12:# Name for the Icinga dependency apply rule}
    parent_host: ${13:# The parent host}
    parent_service: ${14:# The parent service}
    period: ${15:# The name of a time period which determines when this notification should be triggered}
    state: ${16:# Apply feature state}
    states: ${17:# The host/service states you want to get notifications for}
    url: ${18:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${19:# The password for use in HTTP basic authentication}
    url_username: ${20:# The username for use in HTTP basic authentication}
    use_gssapi: ${21:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${22:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${23:# If V(no), SSL certificates will not be validated}
    zone: ${24:# Icinga cluster zone}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_dependency_template]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_dependency_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage dependency templates in Icinga2</description>
</snippet>