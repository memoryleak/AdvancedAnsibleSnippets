<snippet>
  <content><![CDATA[- name: ${1:Manage command templates in Icinga2}
  telekom_mms.icinga_director.icinga_command_template:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    append: ${3:# Do not overwrite the whole object but instead append the defined properties}
    arguments: ${4:# Arguments of the command template}
    client_cert: ${5:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${6:# PEM formatted file that contains your private key to be used for SSL client authentication}
    command: ${7:# The command Icinga should run}
    disabled: ${8:# Disabled objects will not be deployed}
    force: ${9:# If V(yes) do not get a cached copy}
    force_basic_auth: ${10:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    http_agent: ${11:# Header to identify as, generally appears in web server logs}
    imports: ${12:# Importable templates, add as many as you want}
    methods_execute: ${13:# Plugin Check commands are what you need when running checks against your infrastructure}
    object_name: ${14:# Name of the command template}
    state: ${15:# Apply feature state}
    timeout: ${16:# Optional command timeout}
    url: ${17:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${18:# The password for use in HTTP basic authentication}
    url_username: ${19:# The username for use in HTTP basic authentication}
    use_gssapi: ${20:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${21:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${22:# If V(no), SSL certificates will not be validated}
    vars: ${23:# Custom properties of the command template}
    zone: ${24:# Icinga cluster zone}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_command_template]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_command_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage command templates in Icinga2</description>
</snippet>