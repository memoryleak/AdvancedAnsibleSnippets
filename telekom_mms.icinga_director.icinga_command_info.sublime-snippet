<snippet>
  <content><![CDATA[- name: ${1:Query commands in Icinga2}
  telekom_mms.icinga_director.icinga_command_info:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    client_cert: ${3:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${4:# PEM formatted file that contains your private key to be used for SSL client authentication}
    external: ${5:# Also include external objects in output}
    force: ${6:# If V(yes) do not get a cached copy}
    force_basic_auth: ${7:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    http_agent: ${8:# Header to identify as, generally appears in web server logs}
    query: ${9:# Text to filter search results}
    resolved: ${10:# Resolve all inherited object properties and omit templates in output}
    url: ${11:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${12:# The password for use in HTTP basic authentication}
    url_username: ${13:# The username for use in HTTP basic authentication}
    use_gssapi: ${14:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${15:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${16:# If V(no), SSL certificates will not be validated}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_command_info]]></content>
