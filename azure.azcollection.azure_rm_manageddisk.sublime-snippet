<snippet>
  <content><![CDATA[- name: ${1:Manage Azure Manage Disks}
  azure.azcollection.azure_rm_manageddisk:
    ad_user: ${2:# Active Directory username}
    adfs_authority_url: ${3:# Azure AD authority url}
    api_profile: ${4:# Selects an API profile to use when communicating with Azure services}
    append_tags: ${5:# Use to control if tags field is canonical or just appends to existing tags}
    attach_caching: ${6:# Disk caching policy controlled by VM}
    auth_source: ${7:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${8:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${9:# Azure client ID}
    cloud_environment: ${10:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    create_option: ${11:# C(import) from a VHD file in I(source_uri) and C(copy) from previous managed disk I(source_uri)}
    disable_instance_discovery: ${12:# Determines whether or not instance discovery is performed when attempting to authenticate}
    disk_access_id: ${13:# ARM ID of the DiskAccess resource for using private endpoints on disks}
    disk_iops_read_only: ${14:# The total throughput (MBps) that will be allowed across all VMs mounting the shared disk as ReadOnly}
    disk_iops_read_write: ${15:# The number of IOPS allowed for this disk}
    disk_m_bps_read_only: ${16:# The total throughput (MBps) that will be allowed across all VMs mounting the shared disk as ReadOnly}
    disk_m_bps_read_write: ${17:# The bandwidth allowed for this disk}
    disk_size_gb: ${18:# Size in GB of the managed disk to be created}
    gallery_image_reference: ${19:# Required if creating from a Gallery Image}
    image_reference: ${20:# Disk source information for PIR or user images or Gallery Image}
    location: ${21:# Valid Azure location}
    log_mode: ${22:# Parent argument}
    log_path: ${23:# Parent argument}
    logical_sector_size: ${24:# Logical sector size in bytes for Ultra disks}
    lun: ${25:# The logical unit number for data disk}
    managed_by: ${26:# Name of an existing virtual machine with which the disk is or will be associated, this VM should be in the same resource group}
    managed_by_extended: ${27:# List of name and resource group of the VMs that have the disk attached}
    max_shares: ${28:# The maximum number of VMs that can attach to the disk at the same time}
    name: ${29:# Name of the managed disk}
    network_access_policy: ${30:# Policy for accessing the disk via network}
    os_type: ${31:# Type of Operating System}
    password: ${32:# Active Directory user password}
    performance_plus: ${33:# Set this flag to true to get a boost on the performance target of the disk deployed, see here on the respective performance target}
    profile: ${34:# Security profile found in ~/}
    public_network_access: ${35:# Policy for controlling export on the disk}
    resource_group: ${36:# Name of a resource group where the managed disk exists or will be created}
    secret: ${37:# Azure client secret}
    security_profile: ${38:# Contains the security related information for the resource}
    source_resource_id: ${39:# If I(create_option=copy), this is the ARM id of the source snapshot or disk}
    source_uri: ${40:# URI to a valid VHD file to be used or the resource ID of the managed disk to copy}
    state: ${41:# Assert the state of the managed disk}
    storage_account_id: ${42:# The full path to the storage account the image is to be imported from}
    storage_account_type: ${43:# Type of storage for the managed disk}
    subscription_id: ${44:# Your Azure subscription Id}
    tags: ${45:# Dictionary of string:string pairs to assign as metadata to the object}
    tenant: ${46:# Azure tenant ID}
    thumbprint: ${47:# The thumbprint of the private key specified in I(x509_certificate_path)}
    tier: ${48:# Performance tier assigned to this disk}
    upload_size_bytes: ${49:# If I(create_option=upload), this is the size of the contents of the upload including the VHD footer}
    write_accelerator_enabled: ${50:# Specifies whether writeAccelerator should be enabled or disabled on the disk}
    x509_certificate_path: ${51:# Path to the X509 certificate used to create the service principal in PEM format}
    zone: ${52:# The Azure managed disk's zone}
  tags:
    - azure
    - azcollection
    - azure_rm_manageddisk]]></content>
  <tabTrigger>azure.azcollection.azure_rm_manageddisk</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Azure Manage Disks</description>
</snippet>