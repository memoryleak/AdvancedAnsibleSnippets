<snippet>
  <content><![CDATA[- name: ${1:Manage Hetzner's vSwitch}
  community.hrobot.v_switch:
    hetzner_password: ${2:# The password for the Robot web-service user}
    hetzner_user: ${3:# The username for the Robot web-service user}
    name: ${4:# The vSwitch's name}
    rate_limit_retry_timeout: ${5:# Timeout (in seconds) for waiting when rate limit exceeded errors are returned}
    servers: ${6:# List of server identifiers (server's numeric ID or server's main IPv4 or IPv6)}
    state: ${7:# State of the vSwitch}
    timeout: ${8:# Timeout (in seconds) for waiting for vSwitch servers to be configured}
    vlan: ${9:# The vSwitch's VLAN ID}
    wait: ${10:# Whether to wait until the vSwitch has been successfully configured before determining what to do, and before returning from the module}
    wait_delay: ${11:# Delay to wait (in seconds) before checking again whether the vSwitch servers has been configured}
  tags:
    - community
    - hrobot
    - v_switch]]></content>
