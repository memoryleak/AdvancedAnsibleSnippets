<snippet>
  <content><![CDATA[- name: ${1:Manage L4-L7 Policy Based Redirection Policies (vns:SvcRedirectPol)}
  cisco.aci.aci_l4l7_policy_based_redirect:
    annotation: ${2:# User-defined string for annotating an object}
    anycast_enabled: ${3:# Whether to enable anycast services}
    certificate_name: ${4:# The X}
    description: ${5:# The description of the Policy Based Redirection Policy}
    destination_type: ${6:# The destination type}
    hash_algorithm: ${7:# The hashing algorithm}
    host: ${8:# IP Address or hostname of APIC resolvable by Ansible control host}
    ip_sla_monitor_policy: ${9:# The name of the IP SLA Monitoring Policy to bind to the L4-L7 Redirect Policy}
    max_threshold: ${10:# The maximum percent when threshold is enabled}
    min_threshold: ${11:# The minimum percent when threshold is enabled}
    output_level: ${12:# Influence the output of this ACI module}
    output_path: ${13:# Path to a file that will be used to dump the ACI JSON configuration objects generated by the module}
    owner_key: ${14:# User-defined string for the ownerKey attribute of an ACI object}
    owner_tag: ${15:# User-defined string for the ownerTag attribute of an ACI object}
    password: ${16:# The password to use for authentication}
    pod_aware: ${17:# Whether to enable Pod ID aware redirection}
    policy_name: ${18:# The name of the Policy Based Redirection Policy}
    port: ${19:# Port number to be used for REST connection}
    private_key: ${20:# Either a PEM-formatted private key file or the private key content used for signature-based authentication}
    resilient_hash: ${21:# Whether to enable resilient hashing}
    rewrite_source_mac: ${22:# Whether to rewrite the source MAC address of forwarded traffic}
    state: ${23:# Use C(present) or C(absent) for adding or removing}
    suppress_previous: ${24:# If C(true), a GET to check previous will not be sent before a POST update to APIC}
    suppress_verification: ${25:# If C(true), a verifying GET will not be sent after a POST update to APIC}
    tenant: ${26:# The name of an existing tenant}
    threshold_down_action: ${27:# The action to take when threshold is breached}
    threshold_enable: ${28:# Whether to enable the threshold for the policy}
    timeout: ${29:# The socket level timeout in seconds}
    use_proxy: ${30:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${31:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${32:# The username to use for authentication}
    validate_certs: ${33:# If C(false), SSL certificates will not be validated}
