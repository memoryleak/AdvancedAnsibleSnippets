<snippet>
  <content><![CDATA[- name: ${1:Manage filesystem group quotas}
  purestorage.flashblade.purefb_groupquota:
    api_token: ${2:# FlashBlade API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    disable_warnings: ${4:# Disable insecure certificate warnings}
    fb_url: ${5:# FlashBlade management IP address or Hostname}
    gid: ${6:# The group id on which the quota is enforced}
    gname: ${7:# The group name on which the quota is enforced}
    name: ${8:# Filesystem Name}
    quota: ${9:# Group quota in M, G, T or P units}
    state: ${10:# Create, delete or modifies a quota}
  tags:
    - purestorage
    - flashblade
    - purefb_groupquota]]></content>
  <tabTrigger>purestorage.flashblade.purefb_groupquota</tabTrigger>
