<snippet>
  <content><![CDATA[- name: ${1:Manage L4-L7 Policy Based Redirect Destinations (vns:RedirectDest and vns:L1L2RedirectDest)}
  cisco.aci.aci_l4l7_policy_based_redirect_destination:
    additional_ip: ${2:# The Additional IP Address for the Destination}
    annotation: ${3:# User-defined string for annotating an object}
    certificate_name: ${4:# The X}
    concrete_device: ${5:# The destination Concrete Device for redirection}
    concrete_interface: ${6:# The destination Concrete Interface for redirection}
    description: ${7:# The description for redirection}
    destination_name: ${8:# The name for Policy Based Redirect destination}
    destination_type: ${9:# The destination type}
    health_group: ${10:# The Health Group to bind the Policy Based Redirection Destination to}
    host: ${11:# IP Address or hostname of APIC resolvable by Ansible control host}
    ip: ${12:# The destination IP for redirection}
    logical_device: ${13:# The destination Logical Device for redirection}
    mac: ${14:# The destination MAC address for redirection}
    output_level: ${15:# Influence the output of this ACI module}
    output_path: ${16:# Path to a file that will be used to dump the ACI JSON configuration objects generated by the module}
    password: ${17:# The password to use for authentication}
    pod_id: ${18:# The Pod ID to deploy Policy Based Redirect destination on}
    policy: ${19:# The name of an existing Policy Based Redirect Policy}
    port: ${20:# Port number to be used for REST connection}
    private_key: ${21:# Either a PEM-formatted private key file or the private key content used for signature-based authentication}
    state: ${22:# Use C(present) or C(absent) for adding or removing}
    suppress_previous: ${23:# If C(true), a GET to check previous will not be sent before a POST update to APIC}
    suppress_verification: ${24:# If C(true), a verifying GET will not be sent after a POST update to APIC}
    tenant: ${25:# The name of an existing tenant}
    timeout: ${26:# The socket level timeout in seconds}
    use_proxy: ${27:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${28:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${29:# The username to use for authentication}
    validate_certs: ${30:# If C(false), SSL certificates will not be validated}
    weight: ${31:# The weight of the fault in calculating the health score of an object}
