<snippet>
  <content><![CDATA[- name: ${1:Scaleway Container management}
  community.general.scaleway_container:
    api_timeout: ${2:# HTTP timeout to Scaleway API in seconds}
    api_token: ${3:# Scaleway OAuth token}
    api_url: ${4:# Scaleway API URL}
    container_timeout: ${5:# The length of time your handler can spend processing a request before being stopped}
    cpu_limit: ${6:# Resources define performance characteristics of your container}
    description: ${7:# Description of the container namespace}
    environment_variables: ${8:# Environment variables of the container namespace}
    max_concurrency: ${9:# Maximum number of connections per container}
    max_scale: ${10:# Maximum number of replicas for the container}
    memory_limit: ${11:# Resources define performance characteristics of your container}
    min_scale: ${12:# Minimum number of replicas for the container}
    name: ${13:# Name of the container namespace}
    namespace_id: ${14:# Container namespace identifier}
    port: ${15:# Listen port used to expose the container}
    privacy: ${16:# Privacy policies define whether a container can be executed anonymously}
    profile: ${17:# The config profile in config file to load the Scaleway OAuth token from, use instead of O(api_token)}
    protocol: ${18:# Communication protocol of the container}
    query_parameters: ${19:# List of parameters passed to the query string}
    redeploy: ${20:# Redeploy the container if update is required}
    region: ${21:# Scaleway region to use (for example V(fr-par))}
    registry_image: ${22:# The name of image used for the container}
    secret_environment_variables: ${23:# Secret environment variables of the container namespace}
    state: ${24:# Indicate desired state of the container}
    validate_certs: ${25:# Validate SSL certs of the Scaleway API}
    wait: ${26:# Wait for the resource to reach its desired state before returning}
    wait_sleep_time: ${27:# Time to wait before every attempt to check the state of the resource}
    wait_timeout: ${28:# Time to wait for the resource to reach the expected state}
  tags:
    - community
    - general
    - scaleway_container]]></content>
  <tabTrigger>community.general.scaleway_container</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Scaleway Container management</description>
</snippet>