<snippet>
  <content><![CDATA[- name: ${1:Manage Docker networks}
  community.docker.docker_network:
    api_version: ${2:# The version of the Docker API running on the Docker Host}
    appends: ${3:# By default the connected list is canonical, meaning containers not on the list are removed from the network}
    attachable: ${4:# If enabled, and the network is in the global scope, non-service containers on worker nodes will be able to connect to the network}
    ca_path: ${5:# Use a CA certificate when performing server verification by providing the path to a CA certificate file}
    client_cert: ${6:# Path to the client's TLS certificate file}
    client_key: ${7:# Path to the client's TLS key file}
    config_from: ${8:# Specifies the config only network to use the config from}
    config_only: ${9:# Sets that this is a config only network}
    connected: ${10:# List of container names or container IDs to connect to a network}
    debug: ${11:# Debug mode}
    docker_host: ${12:# The URL or Unix socket path used to connect to the Docker API}
    driver: ${13:# Specify the type of network}
    driver_options: ${14:# Dictionary of network settings}
    enable_ipv4: ${15:# Enable IPv4 networking}
    enable_ipv6: ${16:# Enable IPv6 networking}
    force: ${17:# With state V(present) will disconnect all containers for existing networks, delete the network and re-create the network}
    ingress: ${18:# Enable Swarm routing-mesh}
    internal: ${19:# Restrict external access to the network}
    ipam_config: ${20:# List of IPAM config blocks}
    ipam_driver: ${21:# Specify an IPAM driver}
    ipam_driver_options: ${22:# Dictionary of IPAM driver options}
    labels: ${23:# Dictionary of labels}
    name: ${24:# Name of the network to operate on}
    scope: ${25:# Specify the network's scope}
    state: ${26:# V(absent) deletes the network}
    timeout: ${27:# The maximum amount of time in seconds to wait on a response from the API}
    tls: ${28:# Secure the connection to the API by using TLS without verifying the authenticity of the Docker host server}
    tls_hostname: ${29:# When verifying the authenticity of the Docker Host server, provide the expected name of the server}
    use_ssh_client: ${30:# For SSH transports, use the C(ssh) CLI tool instead of paramiko}
    validate_certs: ${31:# Secure the connection to the API by using TLS and verifying the authenticity of the Docker host server}
  tags:
    - community
    - docker
    - docker_network]]></content>
  <tabTrigger>community.docker.docker_network</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Docker networks</description>
</snippet>