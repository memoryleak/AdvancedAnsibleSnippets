<snippet>
  <content><![CDATA[- name: ${1:IPMI over LAN Policy configuration for Cisco Intersight}
  cisco.intersight.intersight_ipmi_over_lan_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    description: ${5:# The user-defined description for the IPMI over LAN Policy}
    enabled: ${6:# State of the IPMI Over LAN service on the endpoint}
    encryption_key: ${7:# The encryption key to use for IPMI communication}
    name: ${8:# The name assigned to the IPMI over LAN Policy}
    organization: ${9:# The name of the Organization this resource is assigned to}
    privilege: ${10:# The highest privilege level that can be assigned to an IPMI session on a server}
    state: ${11:# If C(present), will verify the resource is present and will create if needed}
    tags: ${12:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    use_proxy: ${13:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${14:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_ipmi_over_lan_policy]]></content>
  <tabTrigger>cisco.intersight.intersight_ipmi_over_lan_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
