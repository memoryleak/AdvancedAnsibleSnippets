<snippet>
  <content><![CDATA[- name: ${1:Manage Azure private endpoint}
  azure.azcollection.azure_rm_privateendpoint:
    ad_user: ${2:# Active Directory username}
    adfs_authority_url: ${3:# Azure AD authority url}
    api_profile: ${4:# Selects an API profile to use when communicating with Azure services}
    append_tags: ${5:# Use to control if tags field is canonical or just appends to existing tags}
    application_security_groups: ${6:# The application security group in a resource group}
    auth_source: ${7:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${8:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${9:# Azure client ID}
    cloud_environment: ${10:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    custom_dns_configs: ${11:# An array of custom dns configurations}
    custom_network_interface_name: ${12:# The custom name of the network interface attached to the private endpoint}
    disable_instance_discovery: ${13:# Determines whether or not instance discovery is performed when attempting to authenticate}
    ip_configurations: ${14:# A list of IP configurations of the private endpoint}
    location: ${15:# Valid Azure location}
    log_mode: ${16:# Parent argument}
    log_path: ${17:# Parent argument}
    manual_private_link_service_connections: ${18:# A grouping of information about the connection to the remote resource}
    name: ${19:# Name of the private endpoint}
    password: ${20:# Active Directory user password}
    private_link_service_connections: ${21:# A grouping of information about the connection to the remote resource}
    profile: ${22:# Security profile found in ~/}
    resource_group: ${23:# Name of resource group}
    secret: ${24:# Azure client secret}
    state: ${25:# State of the virtual network}
    subnet: ${26:# The ID of the subnet from which the private IP will be allocated}
    subscription_id: ${27:# Your Azure subscription Id}
    tags: ${28:# Dictionary of string:string pairs to assign as metadata to the object}
    tenant: ${29:# Azure tenant ID}
    thumbprint: ${30:# The thumbprint of the private key specified in I(x509_certificate_path)}
    x509_certificate_path: ${31:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_privateendpoint]]></content>
  <tabTrigger>azure.azcollection.azure_rm_privateendpoint</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Azure private endpoint</description>
</snippet>