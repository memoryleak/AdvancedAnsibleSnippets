<snippet>
  <content><![CDATA[- name: ${1:Manage volumes on Pure Storage FlashArrays}
  purestorage.flasharray.purefa_volume:
    add_to_pgs: ${2:# A new volume will be added to the specified protection groups on creation}
    api_token: ${3:# FlashArray API token for admin privileged user}
    bw_qos: ${4:# Bandwidth limit for volume in M or G units}
    context: ${5:# Name of fleet member on which to perform the operation}
    count: ${6:# Number of volumes to be created in a multiple volume creation}
    digits: ${7:# Number of digits to use for multiple volume count}
    disable_warnings: ${8:# Disable insecure certificate warnings in debug logs}
    eradicate: ${9:# Define whether to eradicate the volume on delete or leave in trash}
    fa_url: ${10:# FlashArray management IPv4 address or Hostname}
    iops_qos: ${11:# IOPs limit for volume - use value or K or M K will mean 1000 M will mean 1000000 To clear an existing IOPs setting use 0 (zero)}
    move: ${12:# Move a volume in and out of a pod or vgroup}
    name: ${13:# The name of the volume}
    overwrite: ${14:# Define whether to overwrite a target volume if it already exists}
    pgroup: ${15:# Name of existing, not deleted, protection group to add volume to}
    priority_operator: ${16:# DMM Priority Adjustment operator}
    priority_value: ${17:# DMM Priority Adjustment value}
    promotion_state: ${18:# Promote or demote the volume so that the volume starts or stops accepting write requests}
    rename: ${19:# Value to rename the specified volume to}
    size: ${20:# Volume size in M, G, T or P units}
    start: ${21:# Number at which to start the multiple volume creation index}
    state: ${22:# Define whether the volume should exist or not}
    suffix: ${23:# Suffix string, if required, for multiple volume create}
    target: ${24:# The name of the target volume, if copying}
    with_default_protection: ${25:# Whether to add the default container protection groups to those specified in I(add_to_pgs) as the initial protection of a new volume}
  tags:
    - purestorage
    - flasharray
    - purefa_volume]]></content>
  <tabTrigger>purestorage.flasharray.purefa_volume</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage volumes on Pure Storage FlashArrays</description>
</snippet>