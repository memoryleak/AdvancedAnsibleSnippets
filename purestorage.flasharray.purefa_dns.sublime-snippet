<snippet>
  <content><![CDATA[- name: ${1:Configure FlashArray DNS settings}
  purestorage.flasharray.purefa_dns:
    api_token: ${2:# FlashArray API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    disable_warnings: ${4:# Disable insecure certificate warnings in debug logs}
    domain: ${5:# Domain suffix to be appended when perofrming DNS lookups}
    fa_url: ${6:# FlashArray management IPv4 address or Hostname}
    name: ${7:# Name of the DNS configuration}
    nameservers: ${8:# List of up to 3 unique DNS server IP addresses}
    service: ${9:# Type of service the DNS will work with}
    source: ${10:# A virtual network interface (vif)}
    state: ${11:# Set or delete directory service configuration}
  tags:
    - purestorage
    - flasharray
    - purefa_dns]]></content>
  <tabTrigger>purestorage.flasharray.purefa_dns</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Configure FlashArray DNS settings</description>
</snippet>