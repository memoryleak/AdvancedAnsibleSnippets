<snippet>
  <content><![CDATA[- name: ${1:Manage MACsec Policies on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_macsec_policy:
    admin_state: ${2:# The administrative state of the MACsec Policy}
    cipher_suite: ${3:# The cipher suite to be used for encryption}
    confidentiality_offset: ${4:# The confidentiality offset for the MACsec Policy}
    description: ${5:# The description of the MACsec Policy}
    host: ${6:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    interface_type: ${7:# The type of the interfaces this policy will be applied to}
    key_server_priority: ${8:# The key server priority for the MACsec Policy}
    login_domain: ${9:# The login domain name to use for authentication}
    macsec_keys: ${10:# List of the MACsec Keys}
    macsec_policy: ${11:# The name of the MACsec Policy}
    macsec_policy_uuid: ${12:# The UUID of the MACsec Policy}
    output_level: ${13:# Influence the output of this MSO module}
    password: ${14:# The password to use for authentication}
    port: ${15:# Port number to be used for the REST connection}
    sak_expiry_time: ${16:# The expiry time for the Security Association Key (SAK) for the MACsec Policy}
    security_policy: ${17:# The security policy to allow traffic on the link for the MACsec Policy}
    state: ${18:# Use C(absent) for removing}
    template: ${19:# The name of the template}
    timeout: ${20:# The socket level timeout in seconds}
    use_proxy: ${21:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${22:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${23:# The username to use for authentication}
    validate_certs: ${24:# If C(false), SSL certificates will not be validated}
    window_size: ${25:# The window size defines the maximum number of frames that can be received out of order}
  tags:
    - cisco
    - mso
    - ndo_macsec_policy]]></content>
  <tabTrigger>cisco.mso.ndo_macsec_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage MACsec Policies on Cisco Nexus Dashboard Orchestrator (NDO)</description>
</snippet>