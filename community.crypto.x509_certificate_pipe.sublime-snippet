<snippet>
  <content><![CDATA[- name: ${1:Generate and/or check OpenSSL certificates}
  community.crypto.x509_certificate_pipe:
    content: ${2:# The existing certificate}
    csr_content: ${3:# Content of the Certificate Signing Request (CSR) used to generate this certificate}
    csr_path: ${4:# Path to the Certificate Signing Request (CSR) used to generate this certificate}
    force: ${5:# Generate the certificate, even if it already exists}
    ignore_timestamps: ${6:# Whether the 'not before' and 'not after' timestamps should be ignored for idempotency checks}
    ownca_content: ${7:# Content of the CA (Certificate Authority) certificate}
    ownca_create_authority_key_identifier: ${8:# Create a Authority Key Identifier from the CA's certificate}
    ownca_create_subject_key_identifier: ${9:# Whether to create the Subject Key Identifier (SKI) from the public key}
    ownca_digest: ${10:# The digest algorithm to be used for the V(ownca) certificate}
    ownca_not_after: ${11:# The point in time at which the certificate stops being valid}
    ownca_not_before: ${12:# The point in time the certificate is valid from}
    ownca_path: ${13:# Remote absolute path of the CA (Certificate Authority) certificate}
    ownca_privatekey_content: ${14:# Content of the CA (Certificate Authority) private key to use when signing the certificate}
    ownca_privatekey_passphrase: ${15:# The passphrase for the O(ownca_privatekey_path) resp}
    ownca_privatekey_path: ${16:# Path to the CA (Certificate Authority) private key to use when signing the certificate}
    ownca_version: ${17:# The version of the V(ownca) certificate}
    privatekey_content: ${18:# Content of the private key to use when signing the certificate}
    privatekey_passphrase: ${19:# The passphrase for the O(privatekey_path) resp}
    privatekey_path: ${20:# Path to the private key to use when signing the certificate}
    provider: ${21:# Name of the provider to use to generate/retrieve the OpenSSL certificate}
    select_crypto_backend: ${22:# Determines which crypto backend to use}
    selfsigned_create_subject_key_identifier: ${23:# Whether to create the Subject Key Identifier (SKI) from the public key}
    selfsigned_digest: ${24:# Digest algorithm to be used when self-signing the certificate}
    selfsigned_not_after: ${25:# The point in time at which the certificate stops being valid}
    selfsigned_not_before: ${26:# The point in time the certificate is valid from}
    selfsigned_version: ${27:# Version of the V(selfsigned) certificate}
  tags:
    - community
    - crypto
    - x509_certificate_pipe]]></content>
  <tabTrigger>community.crypto.x509_certificate_pipe</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Generate and/or check OpenSSL certificates</description>
</snippet>