<snippet>
  <content><![CDATA[- name: ${1:Configure SSH proxy for ARC hosts}
  azure.azcollection.azure_rm_arcssh:
    ad_user: ${2:# Active Directory username}
    adfs_authority_url: ${3:# Azure AD authority url}
    ansible_host: ${4:# The discovered hostname that is generated by the inventory config}
    api_profile: ${5:# Selects an API profile to use when communicating with Azure services}
    auth_source: ${6:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${7:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${8:# Azure client ID}
    cloud_environment: ${9:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    disable_instance_discovery: ${10:# Determines whether or not instance discovery is performed when attempting to authenticate}
    inventory_hostname: ${11:# The inventory configured hostname}
    local_user: ${12:# The local user that you use to log into your server}
    log_mode: ${13:# Parent argument}
    log_path: ${14:# Parent argument}
    password: ${15:# Active Directory user password}
    port: ${16:# The port that your ssh server is listening on}
    private_key_file: ${17:# The Private key that matches the public key that you have already added to your authorized_hosts of local_user}
    profile: ${18:# Security profile found in ~/}
    resource_group: ${19:# The name of the Resource Group to which the server belongs}
    resource_type: ${20:# The name of the Resource Type to which the server belongs}
    secret: ${21:# Azure client secret}
    ssh_config_file: ${22:# Host specific file location for ssh config}
    ssh_proxy_folder: ${23:# The folder which will store the client ssh proxy}
    ssh_relay_file: ${24:# Host specific file location for the relay file}
    subscription_id: ${25:# Your Azure subscription Id}
    tenant: ${26:# Azure tenant ID}
    thumbprint: ${27:# The thumbprint of the private key specified in I(x509_certificate_path)}
    x509_certificate_path: ${28:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_arcssh]]></content>
  <tabTrigger>azure.azcollection.azure_rm_arcssh</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Configure SSH proxy for ARC hosts</description>
</snippet>