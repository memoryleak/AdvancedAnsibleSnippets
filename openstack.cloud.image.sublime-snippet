<snippet>
  <content><![CDATA[- name: ${1:Manage images of OpenStack image (Glance) service}
  openstack.cloud.image:
    api_timeout: ${2:# How long should the socket layer wait before timing out for API calls}
    auth: ${3:# Dictionary containing auth information as needed by the cloud's auth plugin strategy}
    auth_type: ${4:# Name of the auth plugin to use}
    ca_cert: ${5:# A path to a CA Cert bundle that can be used as part of verifying SSL API requests}
    checksum: ${6:# The checksum of the image}
    client_cert: ${7:# A path to a client certificate to use as part of the SSL transaction}
    client_key: ${8:# A path to a client key to use as part of the SSL transaction}
    cloud: ${9:# Named cloud or cloud config to operate against}
    container_format: ${10:# The format of the container}
    disk_format: ${11:# The format of the disk that is getting uploaded}
    filename: ${12:# The path to the file which has to be uploaded}
    id: ${13:# The ID of the image when uploading an image}
    import_method: ${14:# Method to use for importing the image}
    interface: ${15:# Endpoint URL type to fetch from the service catalog}
    is_protected: ${16:# Prevent image from being deleted}
    is_public: ${17:# Whether the image can be accessed publicly}
    kernel: ${18:# The name of an existing kernel image that will be associated with this image}
    min_disk: ${19:# The minimum disk space (in GB) required to boot this image}
    min_ram: ${20:# The minimum ram (in MB) required to boot this image}
    name: ${21:# The name of the image when uploading - or the name/ID of the image if deleting}
    owner: ${22:# The name or ID of the project owning the image}
    owner_domain: ${23:# The name or id of the domain the project owning the image belongs to}
    properties: ${24:# Additional properties to be associated with this image}
    ramdisk: ${25:# The name of an existing ramdisk image that will be associated with this image}
    region_name: ${26:# Name of the region}
    sdk_log_level: ${27:# Log level of the OpenStackSDK}
    sdk_log_path: ${28:# Path to the logfile of the OpenStackSDK}
    state: ${29:# Should the resource be present, absent or inactive}
    tags: ${30:# List of tags to be applied to the image}
    timeout: ${31:# How long should ansible wait for the requested resource}
    uri: ${32:# Required only if using the web-download import method}
    use_import: ${33:# Use the 'glance-direct' method of the interoperable image import mechanism}
    validate_certs: ${34:# Whether or not SSL API requests should be verified}
    visibility: ${35:# The image visibility}
    volume: ${36:# ID of a volume to create an image from}
    wait: ${37:# Should ansible wait until the requested resource is complete}
  tags:
    - openstack
    - cloud
    - image]]></content>
  <tabTrigger>openstack.cloud.image</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage images of OpenStack image (Glance) service</description>
</snippet>