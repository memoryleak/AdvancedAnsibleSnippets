<snippet>
  <content><![CDATA[- name: ${1:Template a file out to a remote server}
  ansible.windows.win_template:
    backup: ${2:# Determine whether a backup should be created}
    block_end_string: ${3:# The string marking the end of a block}
    block_start_string: ${4:# The string marking the beginning of a block}
    comment_end_string: ${5:# The string marking the end of a comment statement}
    comment_start_string: ${6:# The string marking the beginning of a comment statement}
    dest: ${7:# Location to render the template to on the remote machine}
    force: ${8:# Determine when the file is being transferred if the destination already exists}
    lstrip_blocks: ${9:# Determine when leading spaces and tabs should be stripped}
    newline_sequence: ${10:# Specify the newline sequence to use for templating files}
    output_encoding: ${11:# Overrides the encoding used to write the template file defined by C(dest)}
    src: ${12:# Path of a Jinja2 formatted template on the Ansible controller}
    trim_blocks: ${13:# Determine when newlines should be removed from blocks}
    variable_end_string: ${14:# The string marking the end of a print statement}
    variable_start_string: ${15:# The string marking the beginning of a print statement}
  tags:
    - win_template]]></content>
  <tabTrigger>ansible.windows.win_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Template a file out to a remote server</description>
</snippet>