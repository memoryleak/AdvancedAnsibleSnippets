<snippet>
  <content><![CDATA[- name: ${1:Manages Out-Of-Band controllers using Redfish APIs}
  community.general.redfish_command:
    account_properties: ${2:# Properties of account service to update}
    account_types: ${3:# Array of account types to apply to a user account}
    auth_token: ${4:# Security token for authenticating to OOB controller}
    baseuri: ${5:# Base URI of OOB controller}
    bios_attributes: ${6:# BIOS attributes that needs to be verified in the given server}
    boot_next: ${7:# BootNext target when bootdevice is 'UefiBootNext'}
    boot_override_mode: ${8:# Boot mode when using an override}
    bootdevice: ${9:# Boot device when setting boot configuration}
    ca_path: ${10:# PEM formatted file that contains a CA certificate to be used for validation}
    category: ${11:# Category to execute on OOB controller}
    ciphers: ${12:# TLS/SSL Ciphers to use for the request}
    command: ${13:# List of commands to execute on OOB controller}
    id: ${14:# ID of account to delete/modify}
    new_password: ${15:# New password of account to add/modify}
    new_username: ${16:# Username of account to add/delete/modify}
    oem_account_types: ${17:# Array of OEM account types to apply to a user account}
    password: ${18:# Password for authenticating to OOB controller}
    reset_to_defaults_mode: ${19:# Mode to apply when reseting to default}
    resource_id: ${20:# ID of the System, Manager or Chassis to modify}
    roleid: ${21:# Role of account to add/modify}
    session_uri: ${22:# URI of the session resource}
    strip_etag_quotes: ${23:# Removes surrounding quotes of etag used in C(If-Match) header of C(PATCH) requests}
    timeout: ${24:# Timeout in seconds for HTTP requests to OOB controller}
    uefi_target: ${25:# UEFI boot target when bootdevice is 'UefiTarget'}
    update_apply_time: ${26:# Time when to apply the update}
    update_creds: ${27:# Credentials for retrieving the update image}
    update_custom_oem_header: ${28:# Optional OEM header, sent as separate form-data for the Multipart HTTP push update}
    update_custom_oem_mime_type: ${29:# MIME Type for custom OEM properties for HTTP Multipart Push updates}
    update_custom_oem_params: ${30:# Custom OEM properties for HTTP Multipart Push updates}
    update_handle: ${31:# Handle to check the status of an update in progress}
    update_image_file: ${32:# Filename, with optional path, of the image for the update}
    update_image_uri: ${33:# URI of the image for the update}
    update_oem_params: ${34:# Properties for HTTP Multipart Push Updates}
    update_protocol: ${35:# Protocol for the update}
    update_targets: ${36:# List of target resource URIs to apply the update to}
    update_username: ${37:# New user name for updating account_username}
    username: ${38:# Username for authenticating to OOB controller}
    validate_certs: ${39:# If V(false), TLS/SSL certificates are not validated}
    virtual_media: ${40:# Options for VirtualMedia commands}
    wait: ${41:# Block until the service is ready again}
    wait_timeout: ${42:# How long to block until the service is ready again before giving up}
  tags:
    - community
    - general
    - redfish_command]]></content>
