<snippet>
  <content><![CDATA[- name: ${1:Manage Fibre Channel Zone Policies for Cisco Intersight}
  cisco.intersight.intersight_fibre_channel_zone_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    description: ${5:# The user-defined description for the Fibre Channel Zone Policy}
    fc_target_members: ${6:# List of FC target members (zones) to be created within the FC zone policy}
    fc_target_zoning_type: ${7:# Type of FC zoning configuration}
    name: ${8:# The name assigned to the Fibre Channel Zone Policy}
    organization: ${9:# The name of the Organization this resource is assigned to}
    state: ${10:# If C(present), will verify the resource is present and will create if needed}
    tags: ${11:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    use_proxy: ${12:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${13:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_fibre_channel_zone_policy]]></content>
