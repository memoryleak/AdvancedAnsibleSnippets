<snippet>
  <content><![CDATA[- name: ${1:Manage Hosts}
  theforeman.foreman.host:
    activation_keys: ${2:# Activation Keys used for deployment}
    architecture: ${3:# Architecture name}
    build: ${4:# Whether or not to setup build context for the host}
    ca_path: ${5:# PEM formatted file that contains a CA certificate to be used for validation}
    comment: ${6:# Comment about the host}
    compute_attributes: ${7:# Additional compute resource specific attributes}
    compute_profile: ${8:# Compute profile name}
    compute_resource: ${9:# Compute resource name}
    config_groups: ${10:# Config groups list}
    content_source: ${11:# Content Source (Smart Proxy with Content) name}
    content_view: ${12:# Content view}
    domain: ${13:# Domain name}
    enabled: ${14:# Include this host within reporting}
    environment: ${15:# Puppet environment name}
    hostgroup: ${16:# Title of related hostgroup}
    image: ${17:# The image to use when I(provision_method=image)}
    interfaces_attributes: ${18:# Additional interfaces specific attributes}
    ip: ${19:# IP address of the primary interface of the host}
    kickstart_repository: ${20:# Kickstart repository name}
    lifecycle_environment: ${21:# Lifecycle environment}
    location: ${22:# Name of related location}
    mac: ${23:# MAC address of the primary interface of the host}
    managed: ${24:# Whether a host is managed or unmanaged}
    medium: ${25:# Medium name}
    name: ${26:# Fully Qualified Domain Name of host}
    openscap_proxy: ${27:# OpenSCAP proxy name}
    operatingsystem: ${28:# Operating systems are looked up by their title which is composed as '<name> <major>}
    organization: ${29:# Name of related organization}
    owner: ${30:# Owner (user) of the host}
    owner_group: ${31:# Owner (user group) of the host}
    parameters: ${32:# Entity domain specific host parameters}
    password: ${33:# Password of the user accessing the Foreman server}
    provision_method: ${34:# The method used to provision the host}
    ptable: ${35:# Partition table name}
    puppet_ca_proxy: ${36:# Puppet CA proxy name}
    puppet_proxy: ${37:# Puppet server proxy name}
    puppetclasses: ${38:# List of puppet classes to include in this host group}
    pxe_loader: ${39:# PXE Bootloader}
    realm: ${40:# Realm name}
    root_pass: ${41:# Root password}
    server_url: ${42:# URL of the Foreman server}
    state: ${43:# State of the entity}
    subnet: ${44:# IPv4 Subnet name}
    subnet6: ${45:# IPv6 Subnet name}
    use_gssapi: ${46:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${47:# Username accessing the Foreman server}
    validate_certs: ${48:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - host]]></content>
  <tabTrigger>theforeman.foreman.host</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Hosts</description>
</snippet>