<snippet>
  <content><![CDATA[- name: ${1:Manage services in Icinga2}
  telekom_mms.icinga_director.icinga_service:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    append: ${3:# Do not overwrite the whole object but instead append the defined properties}
    check_command: ${4:# Check command definition}
    check_interval: ${5:# Your regular check interval}
    check_period: ${6:# The name of a time period which determines when this object should be monitored}
    check_timeout: ${7:# Check command timeout in seconds}
    client_cert: ${8:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${9:# PEM formatted file that contains your private key to be used for SSL client authentication}
    disabled: ${10:# Disabled objects will not be deployed}
    display_name: ${11:# Alternative name for this service}
    enable_active_checks: ${12:# Whether to actively check this object}
    enable_event_handler: ${13:# Whether to enable event handlers this object}
    enable_flapping: ${14:# Whether flap detection is enabled on this object}
    enable_notifications: ${15:# Whether to send notifications for this object}
    enable_passive_checks: ${16:# Whether to accept passive check results for this object}
    enable_perfdata: ${17:# Whether to process performance data provided by this object}
    event_command: ${18:# Event command for service which gets called on every check execution if one of these conditions matches}
    flapping_threshold_high: ${19:# Flapping upper bound in percent for a service to be considered flapping}
    flapping_threshold_low: ${20:# Flapping lower bound in percent for a service to be considered not flapping}
    force: ${21:# If V(yes) do not get a cached copy}
    force_basic_auth: ${22:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    groups: ${23:# Service groups that should be directly assigned to this service}
    host: ${24:# Choose the host this single service should be assigned to}
    http_agent: ${25:# Header to identify as, generally appears in web server logs}
    icon_image: ${26:# An URL pointing to an icon for this object}
    icon_image_alt: ${27:# Alternative text to be shown in case above icon is missing}
    imports: ${28:# Importable templates, add as many as you want}
    max_check_attempts: ${29:# Defines after how many check attempts a new hard state is reached}
    notes: ${30:# Additional notes for this object}
    notes_url: ${31:# An URL pointing to additional notes for this object}
    object_name: ${32:# Name of the service}
    retry_interval: ${33:# Retry interval, will be applied after a state change unless the next hard state is reached}
    service_set: ${34:# Choose the service set name this single service should be assigned to}
    state: ${35:# Apply feature state}
    url: ${36:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${37:# The password for use in HTTP basic authentication}
    url_username: ${38:# The username for use in HTTP basic authentication}
    use_agent: ${39:# Whether the check command for this service should be executed on the Icinga agent}
    use_gssapi: ${40:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${41:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${42:# If V(no), SSL certificates will not be validated}
    vars: ${43:# Custom properties of the service}
    volatile: ${44:# Whether this check is volatile}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_service]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_service</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage services in Icinga2</description>
</snippet>