    radiusCoaSupportEnabled: ${36:# Change of authentication for RADIUS re-authentication and disconnection}
    radiusGroupAttribute: ${37:# Acceptable values are `''` for None, or `'11'` for Group Policies ACL}
    radiusServers: ${38:# List of RADIUS servers to require connecting devices to authenticate against before granting network access}
    radiusTestingEnabled: ${39:# If enabled, Meraki devices will periodically send access-request messages to these RADIUS servers}
    urlRedirectWalledGardenEnabled: ${40:# Enable to restrict access for clients to a specific set of IP addresses or hostnames prior to authentication}
    urlRedirectWalledGardenRanges: ${41:# IP address ranges, in CIDR notation, to restrict access for clients to a specific set of IP addresses or hostnames prior to authentication}
