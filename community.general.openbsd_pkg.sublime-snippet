<snippet>
  <content><![CDATA[- name: ${1:Manage packages on OpenBSD}
  community.general.openbsd_pkg:
    autoremove: ${2:# Calls C(pkg_delete -a) to remove automatically installed packages which are no longer needed}
    build: ${3:# Build the package from source instead of downloading and installing a binary}
    clean: ${4:# When updating or removing packages, delete the extra configuration file(s) in the old packages which are annotated with C(@extra) in the packaging-list}
    name: ${5:# A name or a list of names of the packages}
    ports_dir: ${6:# When used in combination with the O(build) option, allows overriding the default ports source directory}
    quick: ${7:# Replace or delete packages quickly; do not bother with checksums before removing normal files}
    snapshot: ${8:# Force C(%c) and C(%m) to expand to C(snapshots), even on a release kernel}
    state: ${9:# V(present) ensures the package is installed}
  tags:
    - community
    - general
    - openbsd_pkg]]></content>
