<snippet>
  <content><![CDATA[- name: ${1:Update Zabbix global settings}
  community.zabbix.zabbix_settings:
    alert_usrgrp: ${2:# A name of user group which user belongs to receive an alerm message when database down}
    auditlog_enabled: ${3:# Enable audit logging if C(true)}
    auditlog_mode: ${4:# Enable logging of system actions (changes by low-level discovery, network discovery and autoregistration) if C(true)}
    blink_period: ${5:# A time of period for blinking status changed triggers}
    connect_timeout: ${6:# A time of connection timeout with Zabbix server}
    custom_color: ${7:# Custom event color settings will be activated if C(true)}
    default_inventory_mode: ${8:# A default value for host inventory mode}
    default_lang: ${9:# Default language for users}
    default_theme: ${10:# Default theme for users}
    default_timezone: ${11:# Default time zone for users}
    discovery_group: ${12:# A hostgroup which discovered hosts will belong to}
    frontend_url: ${13:# A URL of frontend}
    geomaps_attribution: ${14:# A text of Geomap attribution}
    geomaps_max_zoom: ${15:# Max zoom level of geomap}
    geomaps_tile_provider: ${16:# A provider of Geomap tile}
    geomaps_tile_url: ${17:# A URL of geomap tile}
    history_period: ${18:# Max period of displaying history data}
    http_login_password: ${19:# Basic Auth password}
    http_login_user: ${20:# Basic Auth login}
    iframe_sandboxing_enabled: ${21:# The Zabbix uses iframe sandboxing if C(true)}
    iframe_sandboxing_exceptions: ${22:# A text of iframe sandboxing exceptions}
    item_test_timeout: ${23:# A time of network timeout for item tests}
    login_attempts: ${24:# A number of login attempts you can try with non blocked}
    login_block: ${25:# A time of interval to reset login attempts when the user is blocked}
    max_in_table: ${26:# Max count of elements to show inside table cell}
    max_overview_table_size: ${27:# Max number of columns and rows in overview tables}
    max_period: ${28:# Max period for time filter}
    media_type_test_timeout: ${29:# A time of network timeout for media type test}
    ok_ack_color: ${30:# A custom color for acknowledged RESOLVED events}
    ok_ack_style: ${31:# Acknowledged RESOLVED events blink if C(true)}
    ok_period: ${32:# A time of period for displaying OK triggers}
    ok_unack_color: ${33:# A custom color for unacknowledged RESOLVED events}
    ok_unack_style: ${34:# Unacknowledged RESOLVED events blink if C(true)}
    period_default: ${35:# Default period value for time filter}
    problem_ack_color: ${36:# A custom color for acknowledged PROBLEM events}
    problem_ack_style: ${37:# Acknowledged PROBLEM events blink if C(true)}
    problem_unack_color: ${38:# A custom color for unacknowledged PROBLEM events}
    problem_unack_style: ${39:# Unacknowledged PROBLEM events blink if C(true)}
    report_test_timeout: ${40:# A time of network timeout for scheduled report test}
    script_timeout: ${41:# A time of network timeout for script execution}
    search_limit: ${42:# A number of search and filter results limit}
    server_check_interval: ${43:# The Zabbix shows 'Zabbix server is down' warning if C(true)}
    severity_color_0: ${44:# A custom color for not classified severity}
    severity_color_1: ${45:# A custom color for information severity}
    severity_color_2: ${46:# A custom color for warning severity}
    severity_color_3: ${47:# A custom color for average severity}
    severity_color_4: ${48:# A custom color for high severity}
    severity_color_5: ${49:# A custom color for disaster severity}
    severity_name_0: ${50:# A custom name for not classified severity}
    severity_name_1: ${51:# A custom name for information severity}
    severity_name_2: ${52:# A custom name for warning severity}
    severity_name_3: ${53:# A custom name for average severity}
    severity_name_4: ${54:# A custom name for high severity}
    severity_name_5: ${55:# A custom name for disaster severity}
    show_technical_errors: ${56:# The Zabbix shows PHP and SQL technical errors to users who are non-Super admin or belong to user groups with debug mode not enabled if C(true)}
    snmptrap_logging: ${57:# Logging unmatched SNMP traps will be ebabled if C(true)}
    socket_timeout: ${58:# A time of network default timeout}
    timeout_browser: ${59:# A time of browser timeout}
    timeout_db_monitor: ${60:# A time of db monitor timeout}
    timeout_external_check: ${61:# A time of external check timeout}
    timeout_http_agent: ${62:# A time of HTTP agent timeout}
    timeout_script: ${63:# A time of script timeout}
    timeout_simple_check: ${64:# A time of simple check timeout}
    timeout_snmp_agent: ${65:# A time of SNMP agent timeout}
    timeout_ssh_agent: ${66:# A time of SSH agent timeout}
    timeout_telnet_agent: ${67:# A time of telnet agent timeout}
    timeout_zabbix_agent: ${68:# A time of zabbix agent timeout}
    uri_valid_schemes: ${69:# A list of valid URI scheme}
    validate_uri_schemes: ${70:# Validate URI schemes if C(true)}
    vault_provider: ${71:# A name of vault provider}
    work_period: ${72:# Working time setting}
    x_frame_options: ${73:# A text of X-Frame-Options of HTTP header}
  tags:
    - community
    - zabbix
    - zabbix_settings]]></content>
  <tabTrigger>community.zabbix.zabbix_settings</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Update Zabbix global settings</description>
</snippet>