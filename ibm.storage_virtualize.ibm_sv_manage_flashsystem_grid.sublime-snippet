  <content><![CDATA[- name: ${1:This module manages flashsystem-grid operations on IBM Storage Virtualize family storage systems}
  ibm.storage_virtualize.ibm_sv_manage_flashsystem_grid:
    action: ${2:# Specifies action to be run}
    clustername: ${3:# The hostname or management IP of the Storage Virtualize storage system}
    domain: ${4:# Domain for the Storage Virtualize storage system}
    log_path: ${5:# Path of debug log file}
    name: ${6:# Specifies the name of the flashsystem-grid}
    password: ${7:# REST API password for the Storage Virtualize storage system}
    state: ${8:# Specify as C(present) to create, and to update, and C(absent) to remove a flashsystem-grid}
    target_cluster_name: ${9:# The FQDN or IP of the flashsystem-grid coordinator (in case of join action) or member cluster (in case of accept or remove action)}
    token: ${10:# The authentication token to verify a user on the Storage Virtualize storage system}
    truststore: ${11:# Specifies the truststore name to be used for join or accept}
    username: ${12:# REST API username for the Storage Virtualize storage system}
    validate_certs: ${13:# Validates certification}
