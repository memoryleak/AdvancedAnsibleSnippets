<snippet>
  <content><![CDATA[- name: ${1:Manage a subscribed content library}
  vmware.vmware.subscribed_content_library:
    always_update_password: ${2:# If true and O(authentication_password) is set, this module will always report a change and set the password value to O(authentication_password)}
    authentication_method: ${3:# The method of authentication to use if this is a subscribed or published local library}
    authentication_password: ${4:# The password to use when O(authentication_method) is V(BASIC)}
    datastore: ${5:# The name of the datastore that should be a storage backing for the library}
    description: ${6:# The description for the content library}
    hostname: ${7:# The hostname or IP address of the vSphere vCenter server}
    name: ${8:# The name of the subscribed content library to manage}
    password: ${9:# The password of the vSphere vCenter server}
    port: ${10:# The port number of the vSphere vCenter server}
    proxy_host: ${11:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${12:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    proxy_protocol: ${13:# The proxy connection protocol to use}
    ssl_thumbprint: ${14:# If specified, the thumbprint presented by the subscribed URL will be validated against this value}
    state: ${15:# Whether the content library should be present or absent}
    subscription_url: ${16:# The URL of the remote library to which you want to subscribe}
    update_on_demand: ${17:# Whether to download all content on demand, or download all content ahead of time}
    username: ${18:# The username of the vSphere vCenter server}
    validate_certs: ${19:# Allows connection when SSL certificates are not valid}
  tags:
    - vmware
    - vmware
    - subscribed_content_library]]></content>
  <tabTrigger>vmware.vmware.subscribed_content_library</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage a subscribed content library</description>
</snippet>