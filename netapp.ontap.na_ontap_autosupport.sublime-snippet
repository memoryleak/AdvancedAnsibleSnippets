<snippet>
  <content><![CDATA[- name: ${1:NetApp ONTAP autosupport}
  netapp.ontap.na_ontap_autosupport:
    cert_filepath: ${2:# path to SSL client cert file (}
    feature_flags: ${3:# Enable or disable a new feature}
    force: ${4:# Set the force flag to true to modify some of the AutoSupport configurations that are otherwise blocked when the automatic update feature is enabled}
    force_ontap_version: ${5:# Override the cluster ONTAP version when using REST}
    from_address: ${6:# specify the e-mail address from which the node sends AutoSupport messages}
    hostname: ${7:# The hostname or IP address of the ONTAP instance}
    hostname_in_subject: ${8:# Specify whether the hostname of the node is included in the subject line of the AutoSupport message}
    http_port: ${9:# Override the default port (80 or 443) with this port}
    https: ${10:# Enable and disable https}
    is_minimal: ${11:# Specifies whether the system information is collected in compliant form, to remove private data or in complete form, to enhance diagnostics}
    key_filepath: ${12:# path to SSL client key file}
    local_collection_enabled: ${13:# Specify whether collection of AutoSupport data when the AutoSupport daemon is disabled}
    mail_hosts: ${14:# List of mail server(s) used to deliver AutoSupport messages via SMTP}
    max_http_size: ${15:# Specify delivery size limit for the HTTP transport protocol (in bytes)}
    max_smtp_size: ${16:# Specify delivery size limit for the SMTP transport protocol (in bytes)}
    nht_data_enabled: ${17:# Specify whether the disk health data is collected as part of the AutoSupport data}
    node_name: ${18:# The name of the filer that owns the AutoSupport Configuration}
    noteto: ${19:# Specifies up to five recipients of short AutoSupport e-mail messages}
    ondemand_enabled: ${20:# Specify whether the AutoSupport OnDemand Download feature is enabled}
    ontapi: ${21:# The ontap api version to use}
    partner_addresses: ${22:# Specifies up to five partner vendor recipients of full AutoSupport e-mail messages}
    password: ${23:# Password for the specified user}
    perf_data_enabled: ${24:# Specify whether the performance data is collected as part of the AutoSupport data}
    post_url: ${25:# The URL used to deliver AutoSupport messages via HTTP POST}
    private_data_removed: ${26:# Specify the removal of customer-supplied data}
    proxy_url: ${27:# specify an HTTP or HTTPS proxy if the 'transport' parameter is set to HTTP or HTTPS and your organization uses a proxy}
    reminder_enabled: ${28:# Specify whether AutoSupport reminders are enabled or disabled}
    retry_count: ${29:# Specify the maximum number of delivery attempts for an AutoSupport message}
    smtp_encryption: ${30:# The encryption protocol used to deliver AutoSupport messages via SMTP to the configured mail_hosts}
    state: ${31:# Specifies whether the AutoSupport daemon is to be enabled or disabled}
    support: ${32:# Specifies whether AutoSupport notification to technical support is enabled}
    to_addresses: ${33:# Specifies up to five recipients of full AutoSupport e-mail messages}
    transport: ${34:# The name of the transport protocol used to deliver AutoSupport messages}
    use_lambda: ${35:# Specifies if AWS Lambda proxy functionality should be used to connect to the ONTAP system}
    use_rest: ${36:# Whether to use REST or ZAPI}
    username: ${37:# This can be a Cluster-scoped or SVM-scoped account, depending on whether a Cluster-level or SVM-level API is required}
    validate_certs: ${38:# If set to C(no), the SSL certificates will not be validated}
    validate_digital_certificate: ${39:# When set to true each node will validate the digital certificates that it receives}
  tags:
    - netapp
    - ontap
    - na_ontap_autosupport]]></content>
  <tabTrigger>netapp.ontap.na_ontap_autosupport</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>NetApp ONTAP autosupport</description>
</snippet>