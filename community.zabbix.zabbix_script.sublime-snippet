<snippet>
  <content><![CDATA[- name: ${1:Create/update/delete Zabbix scripts}
  community.zabbix.zabbix_script:
    authtype: ${2:# Authentication method used for SSH script type}
    command: ${3:# Command to run}
    confirmation: ${4:# Confirmation pop up text}
    description: ${5:# Description of the script}
    execute_on: ${6:# Where to run the script}
    host_access: ${7:# Host permissions needed to run the script}
    host_group: ${8:# host group name that the script can be run on}
    http_login_password: ${9:# Basic Auth password}
    http_login_user: ${10:# Basic Auth login}
    menu_path: ${11:# Folders separated by slash that form a menu like navigation in frontend when clicked on host or event}
    name: ${12:# Name of the script}
    new_window: ${13:# Should URL be opened in a new window?}
    parameters: ${14:# Array of webhook input parameters}
    password: ${15:# Password used for SSH scripts with password authentication and Telnet scripts}
    port: ${16:# Port number used for SSH and Telnet scripts}
    privatekey: ${17:# Name of the private key file used for SSH scripts with public key authentication}
    publickey: ${18:# Name of the public key file used for SSH scripts with public key authentication}
    scope: ${19:# Script scope}
    script_timeout: ${20:# Webhook script execution timeout in seconds}
    script_type: ${21:# Script type}
    state: ${22:# State of the script}
    url: ${23:# The URL for quick access}
    user_group: ${24:# user group name that will be allowed to run the script}
    user_input_default_input: ${25:# Default user input}
    user_input_enabled: ${26:# Allow advanced user input configuration}
    user_input_list: ${27:# A list of possible choices for the user}
    user_input_prompt: ${28:# Prompt to display when user input is enabled}
    user_input_regex: ${29:# A regular expression to validate user input}
    user_input_type: ${30:# Choosing 'regex' allows the use of a regular expression}
    username: ${31:# User name used for authentication}
  tags:
    - community
    - zabbix
    - zabbix_script]]></content>
  <tabTrigger>community.zabbix.zabbix_script</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Create/update/delete Zabbix scripts</description>
</snippet>