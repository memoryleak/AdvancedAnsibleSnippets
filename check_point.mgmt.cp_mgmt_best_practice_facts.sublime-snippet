<snippet>
  <content><![CDATA[- name: ${1:Get best-practice objects facts on Checkpoint over Web Services API}
  check_point.mgmt.cp_mgmt_best_practice_facts:
    best_practice_id: ${2:# Best Practice ID}
    blade: ${3:# Returns all the relevant Best Practices of the selected Software Blades}
    defined_by: ${4:# Returns all the relevant Best Practices of the selected type}
    details_level: ${5:# The level of detail for some of the fields in the response can vary from showing only the UID value of the object to a fully detailed representation of the object}
    gateway_name: ${6:# Returns all the relevant Best Practices of the selected Security Gateway object}
    limit: ${7:# The maximal number of returned results}
    name: ${8:# Best Practice Name}
    offset: ${9:# Number of the results to initially skip}
    show_only_local_domain: ${10:# Indicates whether the query should return only objects from the current local domain}
    show_regulations: ${11:# Show the applicable regulations of the Best Practice}
    status: ${12:# Returns all the relevant best practices with the selected statuses}
    version: ${13:# Version of checkpoint}
  tags:
    - check_point
    - mgmt
    - cp_mgmt_best_practice_facts]]></content>
