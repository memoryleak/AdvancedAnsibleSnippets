<snippet>
  <content><![CDATA[- name: ${1:Generate SSL certificate}
  ieisystem.inmanage.generate_ssl:
    city_locality: ${2:# City or Locality}
    common_name: ${3:# Common name for which the certificate is to be generated}
    country: ${4:# Country code}
    email: ${5:# Email Address of the organization}
    host: ${6:# Specifies the DNS host name or address for connecting to the remote device over the specified transport}
    organization: ${7:# Name of the organization for which certificate is to be generated}
    organization_unit: ${8:# Section or Unit of the organization for which certificate is to be generated}
    password: ${9:# Specifies the password to use to authenticate the connection to the remote device}
    provider: ${10:# A dict object containing connection details}
    state_province: ${11:# State or Province}
    username: ${12:# Configures the username to use to authenticate the connection to the remote device}
    valid_time: ${13:# Requested validity days for the certificate}
  tags:
    - ieisystem
    - inmanage
    - generate_ssl]]></content>
  <tabTrigger>ieisystem.inmanage.generate_ssl</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Generate SSL certificate</description>
</snippet>