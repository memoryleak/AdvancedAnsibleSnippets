<snippet>
  <content><![CDATA[- name: ${1:Manage Partition Table Templates}
  theforeman.foreman.partition_table:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    file_name: ${3:# The path of a template file, that shall be imported}
    layout: ${4:# The content of the Partitioning Table Template}
    locations: ${5:# List of locations the entity should be assigned to}
    locked: ${6:# Determines whether the template shall be locked}
    name: ${7:# The name of the Partition Table}
    organizations: ${8:# List of organizations the entity should be assigned to}
    os_family: ${9:# The OS family the template shall be assigned with}
    password: ${10:# Password of the user accessing the Foreman server}
    server_url: ${11:# URL of the Foreman server}
    state: ${12:# State of the entity}
    updated_name: ${13:# New name of the template}
    use_gssapi: ${14:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${15:# Username accessing the Foreman server}
    validate_certs: ${16:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - partition_table]]></content>
  <tabTrigger>theforeman.foreman.partition_table</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Partition Table Templates</description>
</snippet>