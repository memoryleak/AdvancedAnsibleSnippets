<snippet>
  <content><![CDATA[- name: ${1:Manage User Groups}
  theforeman.foreman.usergroup:
    admin: ${2:# Whether or not the users in this group are administrators}
    ca_path: ${3:# PEM formatted file that contains a CA certificate to be used for validation}
    name: ${4:# Name of the group}
    password: ${5:# Password of the user accessing the Foreman server}
    roles: ${6:# List of roles assigned to the group}
    server_url: ${7:# URL of the Foreman server}
    state: ${8:# State of the entity}
    updated_name: ${9:# New user group name}
    use_gssapi: ${10:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    usergroups: ${11:# List of other groups assigned to the group}
    username: ${12:# Username accessing the Foreman server}
    users: ${13:# List of users assigned to the group}
    validate_certs: ${14:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - usergroup]]></content>
  <tabTrigger>theforeman.foreman.usergroup</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage User Groups</description>
</snippet>