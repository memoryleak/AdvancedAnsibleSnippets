<snippet>
  <content><![CDATA[- name: ${1:Manage Subnets}
  theforeman.foreman.subnet:
    bmc_proxy: ${2:# BMC Smart proxy for this subnet}
    boot_mode: ${3:# Boot mode used by hosts in this subnet}
    ca_path: ${4:# PEM formatted file that contains a CA certificate to be used for validation}
    cidr: ${5:# CIDR prefix length; Required if I(network_type=IPv4) and no I(mask) provided}
    description: ${6:# Description of the subnet}
    dhcp_proxy: ${7:# DHCP Smart proxy for this subnet}
    discovery_proxy: ${8:# Discovery Smart proxy for this subnet}
    dns_primary: ${9:# Primary DNS server for this subnet}
    dns_proxy: ${10:# Reverse DNS Smart proxy for this subnet}
    dns_secondary: ${11:# Secondary DNS server for this subnet}
    domains: ${12:# List of DNS domains the subnet should assigned to}
    externalipam_group: ${13:# External IPAM group for this subnet}
    externalipam_proxy: ${14:# External IPAM proxy for this subnet}
    from_ip: ${15:# First IP address of the host IP allocation pool}
    gateway: ${16:# Subnet gateway IP address}
    httpboot_proxy: ${17:# HTTP Boot Smart proxy for this subnet}
    ipam: ${18:# IPAM mode for this subnet}
    locations: ${19:# List of locations the entity should be assigned to}
    mask: ${20:# Subnet netmask}
    mtu: ${21:# MTU}
    name: ${22:# Subnet name}
    network: ${23:# Subnet IP address}
    network_type: ${24:# Subnet type}
    organizations: ${25:# List of organizations the entity should be assigned to}
    parameters: ${26:# Subnet specific host parameters}
    password: ${27:# Password of the user accessing the Foreman server}
    remote_execution_proxies: ${28:# Remote execution Smart proxies for this subnet}
    server_url: ${29:# URL of the Foreman server}
    state: ${30:# State of the entity}
    template_proxy: ${31:# Template Smart proxy for this subnet}
    tftp_proxy: ${32:# TFTP Smart proxy for this subnet}
    to_ip: ${33:# Last IP address of the host IP allocation pool}
    updated_name: ${34:# New subnet name}
    use_gssapi: ${35:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${36:# Username accessing the Foreman server}
    validate_certs: ${37:# Whether or not to verify the TLS certificates of the Foreman server}
    vlanid: ${38:# VLAN ID}
  tags:
    - theforeman
    - foreman
    - subnet]]></content>
  <tabTrigger>theforeman.foreman.subnet</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Subnets</description>
</snippet>