<snippet>
  <content><![CDATA[- name: ${1:Manage podman system connections}
  containers.podman.podman_system_connection:
    default: ${2:# Make this connection the default for this user}
    destination: ${3:# Destination for the connection}
    executable: ${4:# Path to C(podman) executable if it is not in the C($PATH) on the machine running C(podman)}
    identity: ${5:# Path to SSH identity file}
    name: ${6:# Name of the connection}
    new_name: ${7:# New name for the connection when renaming (used with I(state=present))}
    port: ${8:# SSH port (default is 22)}
    socket_path: ${9:# Path to the Podman service unix domain socket on the ssh destination host}
    state: ${10:# State of the connection}
  tags:
    - containers
    - podman
    - podman_system_connection]]></content>
