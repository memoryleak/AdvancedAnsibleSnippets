<snippet>
  <content><![CDATA[- name: ${1:Resource module for Iot Fabric Rep Rings}
  cisco.dnac.iot_fabric_rep_rings:
    deploymentMode: ${2:# Deployment mode of the configured REP ring}
    dnac_debug: ${3:# Flag for Cisco DNA Center SDK to enable debugging}
    dnac_host: ${4:# The Cisco DNA Center hostname}
    dnac_password: ${5:# The Cisco DNA Center password to authenticate}
    dnac_port: ${6:# The Cisco DNA Center port}
    dnac_username: ${7:# The Cisco DNA Center username to authenticate}
    dnac_verify: ${8:# Flag to enable or disable SSL certificate verification}
    dnac_version: ${9:# Informs the SDK which version of Cisco DNA Center to use}
    ringName: ${10:# Unique name of REP ring to be configured}
    rootNeighbourNetworkDeviceIds: ${11:# It contains the network device IDs of the immediate neighboring ring members of the root node}
    rootNetworkDeviceId: ${12:# RootNetworkDeviceId is the network device ID of the root node in the REP ring}
    validate_response_schema: ${13:# Flag for Cisco DNA Center SDK to enable the validation of request bodies against a JSON schema}
  tags:
    - cisco
    - dnac
    - iot_fabric_rep_rings]]></content>
  <tabTrigger>cisco.dnac.iot_fabric_rep_rings</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Resource module for Iot Fabric Rep Rings</description>
</snippet>