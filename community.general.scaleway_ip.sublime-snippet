<snippet>
  <content><![CDATA[- name: ${1:Scaleway IP management module}
  community.general.scaleway_ip:
    api_timeout: ${2:# HTTP timeout to Scaleway API in seconds}
    api_token: ${3:# Scaleway OAuth token}
    api_url: ${4:# Scaleway API URL}
    id: ${5:# ID of the Scaleway IP (UUID)}
    organization: ${6:# Scaleway organization identifier}
    profile: ${7:# The config profile in config file to load the Scaleway OAuth token from, use instead of O(api_token)}
    project: ${8:# Project identifier}
    query_parameters: ${9:# List of parameters passed to the query string}
    region: ${10:# Scaleway region to use (for example par1)}
    reverse: ${11:# Reverse to assign to the IP}
    server: ${12:# ID of the server you want to attach an IP to}
    state: ${13:# Indicate desired state of the IP}
    validate_certs: ${14:# Validate SSL certs of the Scaleway API}
  tags:
    - community
    - general
    - scaleway_ip]]></content>
  <tabTrigger>community.general.scaleway_ip</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Scaleway IP management module</description>
</snippet>