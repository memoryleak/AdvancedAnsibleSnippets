<snippet>
  <content><![CDATA[- name: ${1:Creates a GCP Alloydb}
  google.cloud.gcp_alloydb_instance:
    access_token: ${2:# The access token used to authenticate}
    activation_policy: ${3:# 'Specifies whether an instance needs to spin up}
    annotations: ${4:# Annotations to allow client tools to store small amount of arbitrary data}
    auth_kind: ${5:# The type of credential used}
    availability_type: ${6:# 'Availability type of an Instance}
    client_connection_config: ${7:# Client connection specific configurations}
    cluster: ${8:# Identifies the alloydb cluster}
    database_flags: ${9:# Database flags}
    display_name: ${10:# User-settable and human-readable display name for the Instance}
    env_type: ${11:# Specifies which Ansible environment you're running this module within}
    gce_zone: ${12:# The Compute Engine zone that the instance should serve from, per https://cloud}
    instance_id: ${13:# The ID of the alloydb instance}
    instance_type: ${14:# The type of the instance}
    labels: ${15:# User-defined labels for the alloydb instance}
    machine_config: ${16:# Configurations for the machines that host the underlying database engine}
    network_config: ${17:# Instance level network configuration}
    observability_config: ${18:# Configuration for enhanced query insights}
    project: ${19:# The Google Cloud Platform project to use}
    psc_instance_config: ${20:# Configuration for Private Service Connect (PSC) for the instance}
    query_insights_config: ${21:# Configuration for query insights}
    read_pool_config: ${22:# Read pool specific config}
    scopes: ${23:# Array of scopes to be used}
    service_account_contents: ${24:# The contents of a Service Account JSON file,}
    service_account_email: ${25:# An optional service account email address if machineaccount is}
    service_account_file: ${26:# The path of a Service Account JSON file if serviceaccount}
    state: ${27:# Whether the resource should exist in GCP}
  tags:
    - google
    - cloud
    - gcp_alloydb_instance]]></content>
  <tabTrigger>google.cloud.gcp_alloydb_instance</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Creates a GCP Alloydb</description>
