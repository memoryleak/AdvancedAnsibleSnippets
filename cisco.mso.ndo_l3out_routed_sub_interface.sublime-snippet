<snippet>
  <content><![CDATA[- name: ${1:Manage L3Out Routed Sub-Interfaces on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_l3out_routed_sub_interface:
    encapsulation_type: ${2:# The encapsulation type of the interface}
    encapsulation_value: ${3:# The encapsulation value of the interface}
    host: ${4:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    interface_group_policy: ${5:# The name of the interface group policy}
    ipv4_address: ${6:# The IPv4 address of the interface}
    ipv6_address: ${7:# The IPv6 address of the interface}
    ipv6_dad: ${8:# Whether to enable IPv6 Duplicate Address Detection (DAD)}
    ipv6_link_local_address: ${9:# The IPv6 link-local address of the interface}
    l3out: ${10:# The name of the L3Out}
    l3out_uuid: ${11:# The UUID of the L3Out}
    login_domain: ${12:# The login domain name to use for authentication}
    mac: ${13:# The MAC address of the interface}
    mtu: ${14:# The Maximum Transmission Unit (MTU) of the interface}
    node_group_policy: ${15:# The name of the node group policy}
    node_id: ${16:# The ID of the node (border leaf switch) where to deploy the L3Out routing protocol and node-level protocol configurations}
    node_loopback_ip: ${17:# The loopback IP address of the node}
    node_router_id: ${18:# The router ID of the node}
    output_level: ${19:# Influence the output of this MSO module}
    password: ${20:# The password to use for authentication}
    path: ${21:# The path of the interface}
    port: ${22:# Port number to be used for the REST connection}
    port_channel: ${23:# The port channel details}
    ptp: ${24:# The Precision Time Protocol (PTP) configuration for the interface}
    state: ${25:# Determines the desired state of the resource}
    target_dscp: ${26:# The target Differentiated Services Code Point (DSCP) of the interface}
    template: ${27:# The name of the template}
    template_id: ${28:# The ID of the L3Out template}
    timeout: ${29:# The socket level timeout in seconds}
    use_proxy: ${30:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_router_id_as_loopback: ${31:# Whether to use the router ID as the loopback address of the node}
    use_ssl: ${32:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${33:# The username to use for authentication}
    validate_certs: ${34:# If C(false), SSL certificates will not be validated}
