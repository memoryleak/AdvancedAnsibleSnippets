<snippet>
  <content><![CDATA[- name: ${1:This module allows users to manage the initial setup configuration on IBM Storage Virtualize family systems}
  ibm.storage_virtualize.ibm_svc_initial_setup:
    chapsecret: ${2:# Specify the CHAP secret to authenticate the system using iSCSI}
    cloud: ${3:# Specifies the number of enclosures for the transparent cloud tiering function}
    clustername: ${4:# The hostname or management IP of the Storage Virtualize system}
    compression: ${5:# Changes system licensing for the compression function}
    dnsip: ${6:# Specifies the DNS server Internet Protocol (IP) address}
    dnsname: ${7:# Specifies a unique name for the system DNS server being created}
    domain: ${8:# Domain for the Storage Virtualize system}
    easytier: ${9:# Specifies the number of enclosures on which user can run Easy Tier}
    encryption: ${10:# Specifies whether the encryption license function is enabled or disabled}
    flash: ${11:# Changes system licensing for the FlashCopy function}
    flashcopydefaultgrainsize: ${12:# Allow a user to change the FC grainsize to be one of either 64K or 256K}
    iscsiauthmethod: ${13:# Specify the authentication method for iSCSI communications on the system}
    license_key: ${14:# Provides the license key to activate a feature that contains 16 hexadecimal characters organized in four groups of four numbers with each group separated by a hyphen (such as 0123-4567-89AB-CDEF)}
    log_path: ${15:# Path of debug log file}
    ntpip: ${16:# Specifies the IPv4 address or fully qualified domain name (FQDN) for the Network Time Protocol (NTP) server}
    password: ${17:# REST API password for the Storage Virtualize system}
    physical_flash: ${18:# For physical disk licensing, this parameter enables or disables the FlashCopy function}
    remote: ${19:# Changes system licensing for remote-copy functions such as Metro Mirror, Global Mirror, and HyperSwap}
    storageinsightscontrolaccess: ${20:# Indicates whether the storage insights control access for the system is enabled or disabled}
    system_name: ${21:# Specifies system name}
    time: ${22:# Specifies the time to which the system must be set}
    timezone: ${23:# Specifies the time zone to set for the system}
    token: ${24:# The authentication token to verify a user on the Storage Virtualize system}
    username: ${25:# REST API username for the Storage Virtualize system}
    validate_certs: ${26:# Validates certification}
    vdiskprotectionenabled: ${27:# Specifies whether the volume protection is enabled or disabled}
    vdiskprotectiontime: ${28:# Specifies the volume protection time (in minutes)}
    virtualization: ${29:# Changes system licensing for the Virtualization function}
  tags:
    - ibm
    - storage_virtualize
    - ibm_svc_initial_setup]]></content>
