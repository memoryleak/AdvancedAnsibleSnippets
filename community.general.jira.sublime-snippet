<snippet>
  <content><![CDATA[- name: ${1:Create and modify issues in a JIRA instance}
  community.general.jira:
    account_id: ${2:# Sets the account identifier for the assignee when O(operation) is V(create), V(transition), or V(edit)}
    assignee: ${3:# Sets the assignee when O(operation) is V(create), V(transition), or V(edit)}
    attachment: ${4:# Information about the attachment being uploaded}
    client_cert: ${5:# Client certificate if required}
    client_key: ${6:# Client certificate key if required}
    comment: ${7:# The comment text to add}
    comment_visibility: ${8:# Used to specify comment comment visibility}
    description: ${9:# The issue description, where appropriate}
    fields: ${10:# This is a free-form data structure that can contain arbitrary data}
    inwardissue: ${11:# Set issue from which link is created}
    issue: ${12:# An existing issue key to operate on}
    issuetype: ${13:# The issue type, for issue creation}
    jql: ${14:# Query JIRA in JQL Syntax, for example V('CMDB Hostname' = test}
    linktype: ${15:# Set type of link, when action 'link' selected}
    maxresults: ${16:# Limit the result of O(operation=search)}
    operation: ${17:# The operation to perform}
    outwardissue: ${18:# Set issue to which link is created}
    password: ${19:# The password to log-in with}
    project: ${20:# The project for this operation}
    status: ${21:# Only used when O(operation) is V(transition), and a bit of a misnomer, it actually refers to the transition name}
    status_id: ${22:# Only used when O(operation) is V(transition), and refers to the transition ID}
    summary: ${23:# The issue summary, where appropriate}
    timeout: ${24:# Set timeout, in seconds, on requests to JIRA API}
    token: ${25:# The personal access token to log-in with}
    uri: ${26:# Base URI for the JIRA instance}
    username: ${27:# The username to log-in with}
    validate_certs: ${28:# Require valid SSL certificates (set to V(false) if you would like to use self-signed certificates)}
  tags:
    - community
    - general
    - jira]]></content>
