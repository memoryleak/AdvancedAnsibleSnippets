<snippet>
  <content><![CDATA[- name: ${1:Manage iSCSI Static Target Policies for Cisco Intersight}
  cisco.intersight.intersight_iscsi_static_target_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    description: ${5:# The user-defined description for the iSCSI Static Target Policy}
    ip_protocol: ${6:# Type of the IP address requested for iSCSI vNIC}
    ipv4_address: ${7:# The IPv4 address assigned to the iSCSI target}
    ipv6_address: ${8:# The IPv6 address assigned to the iSCSI target}
    lun_id: ${9:# The Logical Unit Number (LUN) Identifier for the iSCSI target}
    name: ${10:# The name assigned to the iSCSI Static Target Policy}
    organization: ${11:# The name of the Organization this resource is assigned to}
    port: ${12:# The port associated with the iSCSI target}
    state: ${13:# If C(present), will verify the resource is present and will create if needed}
    tags: ${14:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    target_name: ${15:# Qualified Name (IQN) or Extended Unique Identifier (EUI) name of the iSCSI target}
    use_proxy: ${16:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${17:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_iscsi_static_target_policy]]></content>
  <tabTrigger>cisco.intersight.intersight_iscsi_static_target_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage iSCSI Static Target Policies for Cisco Intersight</description>
</snippet>