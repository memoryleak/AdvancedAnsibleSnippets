  <content><![CDATA[- name: ${1:Resource module for devices _switch _ports}
  cisco.meraki.devices_switch_ports:
    accessPolicyNumber: ${2:# The number of a custom access policy to configure on the switch port}
    accessPolicyType: ${3:# The type of the access policy of the switch port}
    adaptivePolicyGroupId: ${4:# The adaptive policy group ID that will be used to tag traffic through this switch port}
    allowedVlans: ${5:# The VLANs allowed on the switch port}
    daiTrusted: ${6:# If true, ARP packets for this port will be considered trusted, and Dynamic ARP Inspection will allow the traffic}
    dot3az: ${7:# Dot3az settings for the port}
    enabled: ${8:# The status of the switch port}
    flexibleStackingEnabled: ${9:# For supported switches (e}
    highSpeed: ${10:# High speed port enablement settings for C9500-32QC}
    isolationEnabled: ${11:# The isolation status of the switch port}
    linkNegotiation: ${12:# The link speed for the switch port}
    macAllowList: ${13:# Only devices with MAC addresses specified in this list will have access to this port}
    macWhitelistLimit: ${14:# The maximum number of MAC addresses for regular MAC allow list}
    meraki_action_batch_retry_wait_time: ${15:# meraki_action_batch_retry_wait_time (integer), action batch concurrency error retry wait time}
    meraki_api_key: ${16:# meraki_api_key (string), API key generated in dashboard; can also be set as an environment variable MERAKI_DASHBOARD_API_KEY}
    meraki_base_url: ${17:# meraki_base_url (string), preceding all endpoint resources}
    meraki_be_geo_id: ${18:# meraki_be_geo_id (string), optional partner identifier for API usage tracking; can also be set as an environment variable BE_GEO_ID}
    meraki_certificate_path: ${19:# meraki_certificate_path (string), path for TLS/SSL certificate verification if behind local proxy}
    meraki_inherit_logging_config: ${20:# meraki_inherit_logging_config (boolean), Inherits your own logger instance}
    meraki_log_file_prefix: ${21:# meraki_log_file_prefix (string), log file name appended with date and timestamp}
    meraki_log_path: ${22:# log_path (string), path to output log; by default, working directory of script if not specified}
    meraki_maximum_retries: ${23:# meraki_maximum_retries (integer), retry up to this many times when encountering 429s or other server-side errors}
    meraki_nginx_429_retry_wait_time: ${24:# meraki_nginx_429_retry_wait_time (integer), Nginx 429 retry wait time}
    meraki_output_log: ${25:# meraki_output_log (boolean), create an output log file?}
    meraki_print_console: ${26:# meraki_print_console (boolean), print logging output to console?}
    meraki_requests_proxy: ${27:# meraki_requests_proxy (string), proxy server and port, if needed, for HTTPS}
    meraki_retry_4xx_error: ${28:# meraki_retry_4xx_error (boolean), retry if encountering other 4XX error (besides 429)?}
    meraki_retry_4xx_error_wait_time: ${29:# meraki_retry_4xx_error_wait_time (integer), other 4XX error retry wait time}
    meraki_simulate: ${30:# meraki_simulate (boolean), simulate POST/PUT/DELETE calls to prevent changes?}
    meraki_single_request_timeout: ${31:# meraki_single_request_timeout (integer), maximum number of seconds for each API call}
    meraki_suppress_logging: ${32:# meraki_suppress_logging (boolean), disable all logging? you're on your own then!}
    meraki_use_iterator_for_get_pages: ${33:# meraki_use_iterator_for_get_pages (boolean), list* methods will return an iterator with each object instead of a complete list with all items}
    meraki_wait_on_rate_limit: ${34:# meraki_wait_on_rate_limit (boolean), retry if 429 rate limit error encountered?}
    name: ${35:# The name of the switch port}
    peerSgtCapable: ${36:# If true, Peer SGT is enabled for traffic through this switch port}
    poeEnabled: ${37:# The PoE status of the switch port}
    portId: ${38:# PortId path parameter}
    portScheduleId: ${39:# The ID of the port schedule}
    profile: ${40:# Profile attributes}
    rstpEnabled: ${41:# The rapid spanning tree protocol status}
    serial: ${42:# Serial path parameter}
    stickyMacAllowList: ${43:# The initial list of MAC addresses for sticky Mac allow list}
    stickyMacAllowListLimit: ${44:# The maximum number of MAC addresses for sticky MAC allow list}
    stormControlEnabled: ${45:# The storm control status of the switch port}
    stpGuard: ${46:# The state of the STP guard ('disabled', 'root guard', 'bpdu guard' or 'loop guard')}
    stpPortFastTrunk: ${47:# The state of STP PortFast Trunk on the switch port}
    tags: ${48:# The list of tags of the switch port}
    type: ${49:# The type of the switch port ('access', 'trunk', 'stack', 'routed', 'svl' or 'dad')}
    udld: ${50:# The action to take when Unidirectional Link is detected (Alert only, Enforce)}
    vlan: ${51:# The VLAN of the switch port}
    voiceVlan: ${52:# The voice VLAN of the switch port}
