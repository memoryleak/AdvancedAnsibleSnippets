<snippet>
  <content><![CDATA[- name: ${1:Manage Compute Profiles}
  theforeman.foreman.compute_profile:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    compute_attributes: ${3:# Compute attributes related to this compute profile}
    name: ${4:# compute profile name}
    password: ${5:# Password of the user accessing the Foreman server}
    server_url: ${6:# URL of the Foreman server}
    state: ${7:# State of the entity}
    updated_name: ${8:# new compute profile name}
    use_gssapi: ${9:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${10:# Username accessing the Foreman server}
    validate_certs: ${11:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - compute_profile]]></content>
  <tabTrigger>theforeman.foreman.compute_profile</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Compute Profiles</description>
</snippet>