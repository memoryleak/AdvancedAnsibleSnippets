<snippet>
  <content><![CDATA[- name: ${1:Manage Images}
  theforeman.foreman.image:
    architecture: ${2:# architecture of the image}
    ca_path: ${3:# PEM formatted file that contains a CA certificate to be used for validation}
    compute_resource: ${4:# Compute resource the image is assigned to}
    image_password: ${5:# Password that is used to login into the operating system}
    image_username: ${6:# Username that is used to login into the operating system}
    name: ${7:# Image name}
    operatingsystem: ${8:# Operating systems are looked up by their title which is composed as '<name> <major>}
    password: ${9:# Password of the user accessing the Foreman server}
    server_url: ${10:# URL of the Foreman server}
    state: ${11:# State of the entity}
    use_gssapi: ${12:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    user_data: ${13:# Image supports user_data}
    username: ${14:# Username accessing the Foreman server}
    uuid: ${15:# UUID or Marketplace URN of the operatingsystem image}
    validate_certs: ${16:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - image]]></content>
  <tabTrigger>theforeman.foreman.image</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Images</description>
</snippet>