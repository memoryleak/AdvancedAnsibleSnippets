<snippet>
  <content><![CDATA[- name: ${1:Manage bucket replica links between Pure Storage FlashBlades}
  purestorage.flashblade.purefb_bucket_replica:
    api_token: ${2:# FlashBlade API token for admin privileged user}
    cascading: ${3:# Objects replicated to this bucket via a replica link from another array will also be replicated by this link to the remote bucket}
    context: ${4:# Name of fleet member on which to perform the operation}
    credential: ${5:# Name of remote credential name to use}
    disable_warnings: ${6:# Disable insecure certificate warnings}
    fb_url: ${7:# FlashBlade management IP address or Hostname}
    name: ${8:# Local Bucket Name}
    paused: ${9:# State of the bucket replica link}
    state: ${10:# Creates or modifies a bucket replica link}
    target: ${11:# Remote array or target name to create replica on}
    target_bucket: ${12:# Name of target bucket name}
  tags:
    - purestorage
    - flashblade
    - purefb_bucket_replica]]></content>
