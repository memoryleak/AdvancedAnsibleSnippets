<snippet>
  <content><![CDATA[- name: ${1:Render chart templates}
  kubernetes.core.helm_template:
    binary_path: ${2:# The path of a helm binary to use}
    chart_ref: ${3:# Chart reference with repo prefix, for example, C(nginx-stable/nginx-ingress)}
    chart_repo_url: ${4:# Chart repository URL where the requested chart is located}
    chart_version: ${5:# Chart version to use}
    dependency_update: ${6:# Run helm dependency update before the operation}
    disable_hook: ${7:# Prevent hooks from running during install}
    include_crds: ${8:# Include custom resource descriptions in rendered templates}
    insecure_registry: ${9:# Skip TLS certificate checks for the chart download}
    output_dir: ${10:# Output directory where templates will be written}
    plain_http: ${11:# Use HTTP instead of HTTPS when working with OCI registries}
    release_name: ${12:# Release name to use in rendered templates}
    release_namespace: ${13:# namespace scope for this request}
    release_values: ${14:# Values to pass to chart}
    set_values: ${15:# Values to pass to chart configuration}
    show_only: ${16:# Only show manifests rendered from the given templates}
    update_repo_cache: ${17:# Run C(helm repo update) before the operation}
    values_files: ${18:# Value files to pass to chart}
  tags:
    - kubernetes
    - core
    - helm_template]]></content>
  <tabTrigger>kubernetes.core.helm_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Render chart templates</description>
</snippet>