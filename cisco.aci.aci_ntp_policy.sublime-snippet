<snippet>
  <content><![CDATA[- name: ${1:Manage NTP policies (datetime:Pol)}
  cisco.aci.aci_ntp_policy:
    admin_state: ${2:# Admin state of the policy}
    annotation: ${3:# User-defined string for annotating an object}
    auth_state: ${4:# Enable authentication}
    certificate_name: ${5:# The X}
    description: ${6:# Description of the NTP policy}
    host: ${7:# IP Address or hostname of APIC resolvable by Ansible control host}
    master_mode: ${8:# Enable master mode}
    name: ${9:# Name of the NTP policy}
    output_level: ${10:# Influence the output of this ACI module}
    output_path: ${11:# Path to a file that will be used to dump the ACI JSON configuration objects generated by the module}
    owner_key: ${12:# User-defined string for the ownerKey attribute of an ACI object}
    owner_tag: ${13:# User-defined string for the ownerTag attribute of an ACI object}
    password: ${14:# The password to use for authentication}
    port: ${15:# Port number to be used for REST connection}
    private_key: ${16:# Either a PEM-formatted private key file or the private key content used for signature-based authentication}
    server_state: ${17:# Allow switches to act as NTP servers}
    state: ${18:# Use C(present) or C(absent) for adding or removing}
    stratum: ${19:# The NTP stratum value}
    suppress_previous: ${20:# If C(true), a GET to check previous will not be sent before a POST update to APIC}
    suppress_verification: ${21:# If C(true), a verifying GET will not be sent after a POST update to APIC}
    timeout: ${22:# The socket level timeout in seconds}
    use_proxy: ${23:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${24:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${25:# The username to use for authentication}
    validate_certs: ${26:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - aci
    - aci_ntp_policy]]></content>
