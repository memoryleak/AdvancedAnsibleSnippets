<snippet>
  <content><![CDATA[- name: ${1:Generate or  renegenerate the Azure Container Registry Token Password}
  azure.azcollection.azure_rm_containerregistrytokenpassword:
    ad_user: ${2:# Active Directory username}
    adfs_authority_url: ${3:# Azure AD authority url}
    api_profile: ${4:# Selects an API profile to use when communicating with Azure services}
    auth_source: ${5:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${6:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${7:# Azure client ID}
    cloud_environment: ${8:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    disable_instance_discovery: ${9:# Determines whether or not instance discovery is performed when attempting to authenticate}
    expiry: ${10:# The expiry datetime of the password}
    log_mode: ${11:# Parent argument}
    log_path: ${12:# Parent argument}
    name: ${13:# The name of the password}
    password: ${14:# Active Directory user password}
    profile: ${15:# Security profile found in ~/}
    registry_name: ${16:# The name of the container registry}
    resource_group: ${17:# The name of the resource group to which the container registry belongs}
    secret: ${18:# Azure client secret}
    subscription_id: ${19:# Your Azure subscription Id}
    tenant: ${20:# Azure tenant ID}
    thumbprint: ${21:# The thumbprint of the private key specified in I(x509_certificate_path)}
    token_id: ${22:# The ID of the container registry token}
    x509_certificate_path: ${23:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_containerregistrytokenpassword]]></content>
  <tabTrigger>azure.azcollection.azure_rm_containerregistrytokenpassword</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Generate or renegenerate the Azure Container Registry Token Password</description>
</snippet>