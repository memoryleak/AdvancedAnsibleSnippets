<snippet>
  <content><![CDATA[- name: ${1:Fetch information about a Content View Filter Rule}
  theforeman.foreman.content_view_filter_rule_info:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    content_view: ${3:# the name of the content view that the filter applies to}
    content_view_filter: ${4:# the name of the content view filter that the rule applies to}
    errata_id: ${5:# for erratum fitlers using errata_by_id, the errata id to search for}
    location: ${6:# Label of the Location to scope the search for}
    name: ${7:# Name of the resource to fetch information for}
    organization: ${8:# Name of the Organization to scope the search for}
    password: ${9:# Password of the user accessing the Foreman server}
    search: ${10:# Search query to use}
    server_url: ${11:# URL of the Foreman server}
    use_gssapi: ${12:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${13:# Username accessing the Foreman server}
    validate_certs: ${14:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - content_view_filter_rule_info]]></content>
  <tabTrigger>theforeman.foreman.content_view_filter_rule_info</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Fetch information about a Content View Filter Rule</description>
</snippet>