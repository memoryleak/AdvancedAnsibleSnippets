<snippet>
  <content><![CDATA[- name: ${1:Multicast Policy configuration for Cisco Intersight}
  cisco.intersight.intersight_multicast_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    description: ${5:# The user-defined description for the Multicast Policy}
    name: ${6:# The name assigned to the Multicast Policy}
    organization: ${7:# The name of the Organization this resource is assigned to}
    querier_ip_address: ${8:# Used to define the IGMP Querier IP address}
    querier_ip_address_peer: ${9:# Used to define the IGMP Querier IP address of the peer switch}
    querier_state: ${10:# Administrative state of the IGMP Querier for this VLAN}
    snooping_state: ${11:# Administrative state of the IGMP Snooping for this VLAN}
    src_ip_proxy: ${12:# Administrative state of the IGMP source IP proxy for this VLAN}
    state: ${13:# If C(present), will verify the resource is present and will create if needed}
    tags: ${14:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    use_proxy: ${15:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${16:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_multicast_policy]]></content>
  <tabTrigger>cisco.intersight.intersight_multicast_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Multicast Policy configuration for Cisco Intersight</description>
</snippet>