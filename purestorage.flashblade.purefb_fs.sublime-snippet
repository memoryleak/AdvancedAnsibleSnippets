<snippet>
  <content><![CDATA[- name: ${1:Manage filesystemon Pure Storage FlashBlade`}
  purestorage.flashblade.purefb_fs:
    access_control: ${2:# The access control style that is utilized for client actions such as setting file and directory ACLs}
    api_token: ${3:# FlashBlade API token for admin privileged user}
    cancel_in_progress: ${4:# Whether to cancel any existing storage class transitons that are in progress if the file system is requested to changed to another storage class}
    client_policy: ${5:# Name of SMB client policy to assign to filesystem}
    context: ${6:# Name of fleet member on which to perform the operation}
    continuous_availability: ${7:# Defines if the file system will be continuously available during disruptive scenarios such as network disruption, blades failover, etc}
    delete_link: ${8:# Define if the filesystem can be deleted even if it has a replica link}
    disable_warnings: ${9:# Disable insecure certificate warnings}
    discard_snaps: ${10:# Allow a filesystem to be demoted}
    eradicate: ${11:# Define whether to eradicate the filesystem on delete or leave in trash}
    export_policy: ${12:# Name of NFS export policy to assign to filesystem}
    fastremove: ${13:# Define whether the fast remove directory is enabled for the filesystem}
    fb_url: ${14:# FlashBlade management IP address or Hostname}
    group_ownership: ${15:# The group ownership for new files and directories in a file system}
    group_quota: ${16:# Default quota in M, G, T or P units for a group under this file system}
    hard_limit: ${17:# Define whether the capacity for a filesystem is a hard limit}
    http: ${18:# Define whether to HTTP/HTTPS protocol is enabled for the filesystem}
    ignore_usage: ${19:# Allow update operations that lead to a hard_limit_enabled file system with usage over its limiting value}
    name: ${20:# Filesystem Name}
    nfs_rules: ${21:# Define the NFS rules in operation}
    nfsv3: ${22:# Define whether to NFSv3 protocol is enabled for the filesystem}
    nfsv4: ${23:# Define whether to NFSv4}
    policy: ${24:# Filesystem policy to assign to or remove from a filesystem}
    policy_state: ${25:# Add or delete a policy from a filesystem}
    promote: ${26:# Promote/demote a filesystem}
    safeguard_acls: ${27:# Safeguards ACLs on a filesystem}
    share_policy: ${28:# Name of SMB share policy to assign to filesystem}
    size: ${29:# Volume size in M, G, T or P units}
    smb: ${30:# Define whether to SMB protocol is enabled for the filesystem}
    smb_aclmode: ${31:# Specify the ACL mode for the SMB protocol}
    snapshot: ${32:# Define whether a snapshot directory is enabled for the filesystem}
    state: ${33:# Create, delete or modifies a filesystem}
    storage_class: ${34:# Name of storage class in Fusion fleet file system is associated with}
    user_quota: ${35:# Default quota in M, G, T or P units for a user under this file system}
    writable: ${36:# Define if a filesystem is writable}
  tags:
    - purestorage
    - flashblade
    - purefb_fs]]></content>
  <tabTrigger>purestorage.flashblade.purefb_fs</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage filesystemon Pure Storage FlashBlade`</description>
</snippet>