<snippet>
  <content><![CDATA[- name: ${1:Configures an IIS website}
  microsoft.iis.website:
    application_pool: ${2:# Specifies the application pool in which the website runs}
    bindings: ${3:# Specifies the website bindings to add, remove or set}
    name: ${4:# The name of the website to manage}
    physical_path: ${5:# Specifies the physical folder path on the remote host to use for the website}
    site_id: ${6:# Explicitly set the IIS website numeric ID}
    state: ${7:# State of the website}
  tags:
    - microsoft
    - iis
    - website]]></content>
  <tabTrigger>microsoft.iis.website</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Configures an IIS website</description>
</snippet>