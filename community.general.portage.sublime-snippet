<snippet>
  <content><![CDATA[- name: ${1:Package manager for Gentoo}
  community.general.portage:
    backtrack: ${2:# Set backtrack value (C(--backtrack))}
    changed_deps: ${3:# Tells emerge to replace installed packages for which the ebuild dependencies have changed since the packages were built (C(--changed-deps))}
    changed_use: ${4:# Include installed packages where USE flags have changed, except when}
    deep: ${5:# Consider the entire dependency tree of packages (C(--deep))}
    depclean: ${6:# Remove packages not needed by explicitly merged packages (C(--depclean))}
    getbinpkg: ${7:# Prefer packages specified at C(PORTAGE_BINHOST) in C(make}
    getbinpkgonly: ${8:# Merge only packages specified at C(PORTAGE_BINHOST) in C(make}
    jobs: ${9:# Specifies the number of packages to build simultaneously}
    keepgoing: ${10:# Continue as much as possible after an error}
    loadavg: ${11:# Specifies that no new builds should be started if there are other builds running and the load average is at least LOAD}
    newuse: ${12:# Include installed packages where USE flags have changed (C(--newuse))}
    nodeps: ${13:# Only merge packages but not their dependencies (C(--nodeps))}
    noreplace: ${14:# Do not re-emerge installed packages (C(--noreplace))}
    oneshot: ${15:# Do not add the packages to the world file (C(--oneshot))}
    onlydeps: ${16:# Only merge packages' dependencies but not the packages (C(--onlydeps))}
    package: ${17:# Package atom or set, for example V(sys-apps/foo) or V(>foo-2}
    quiet: ${18:# Run emerge in quiet mode (C(--quiet))}
    quietbuild: ${19:# Redirect all build output to logs alone, and do not display it on stdout (C(--quiet-build))}
    quietfail: ${20:# Suppresses display of the build log on stdout (--quiet-fail)}
    select: ${21:# If set to V(true), explicitely add the package to the world file}
    state: ${22:# State of the package atom}
    sync: ${23:# Sync package repositories first}
    update: ${24:# Update packages to the best version available (C(--update))}
    usepkg: ${25:# Tries to use the binary package(s) in the locally available packages directory}
    usepkgonly: ${26:# Merge only binaries (no compiling)}
    verbose: ${27:# Run emerge in verbose mode (C(--verbose))}
    withbdeps: ${28:# Specifies that build time dependencies should be installed}
  tags:
    - community
    - general
    - portage]]></content>
  <tabTrigger>community.general.portage</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Package manager for Gentoo</description>
</snippet>