<snippet>
  <content><![CDATA[- name: ${1:Manage action rule profiles (rtctrl:AttrP)}
  cisco.aci.aci_tenant_action_rule_profile:
    action_rule: ${2:# The name of the action rule profile}
    annotation: ${3:# User-defined string for annotating an object}
    certificate_name: ${4:# The X}
    description: ${5:# The description for the action rule profile}
    host: ${6:# IP Address or hostname of APIC resolvable by Ansible control host}
    multipath: ${7:# Set action rule based on set redistribute multipath configuration}
    name_alias: ${8:# The alias for the current object}
    next_hop_propagation: ${9:# The set action rule based on nexthop unchanged configuration}
    output_level: ${10:# Influence the output of this ACI module}
    output_path: ${11:# Path to a file that will be used to dump the ACI JSON configuration objects generated by the module}
    password: ${12:# The password to use for authentication}
    port: ${13:# Port number to be used for REST connection}
    private_key: ${14:# Either a PEM-formatted private key file or the private key content used for signature-based authentication}
    set_as_path: ${15:# List of Autonomous System (AS) path prepend configurations}
    set_communities: ${16:# List of additional communities to add to the action rule profile using the append criteria}
    set_community: ${17:# The set action rule based on communities}
    set_dampening: ${18:# The set action rule based on dampening}
    set_metric: ${19:# The set action rule based on metric}
    set_metric_type: ${20:# The set action rule based on a metric type}
    set_next_hop: ${21:# The set action rule based on the next hop address}
    set_policy_tag: ${22:# The set action rule based on policy tag (External EPG or ESG)}
    set_preference: ${23:# The set action rule based on preference}
    set_route_tag: ${24:# The set action rule based on route tag}
    set_weight: ${25:# The set action rule based on weight}
    state: ${26:# Use C(present) or C(absent) for adding or removing}
    suppress_previous: ${27:# If C(true), a GET to check previous will not be sent before a POST update to APIC}
    suppress_verification: ${28:# If C(true), a verifying GET will not be sent after a POST update to APIC}
    tenant: ${29:# The name of the tenant}
    timeout: ${30:# The socket level timeout in seconds}
    use_proxy: ${31:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${32:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${33:# The username to use for authentication}
    validate_certs: ${34:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - aci
    - aci_tenant_action_rule_profile]]></content>
  <tabTrigger>cisco.aci.aci_tenant_action_rule_profile</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage action rule profiles (rtctrl:AttrP)</description>
</snippet>