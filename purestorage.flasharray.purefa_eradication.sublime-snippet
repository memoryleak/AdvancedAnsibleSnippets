<snippet>
  <content><![CDATA[- name: ${1:Configure Pure Storage FlashArray Eradication Timer}
  purestorage.flasharray.purefa_eradication:
    api_token: ${2:# FlashArray API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    disable_warnings: ${4:# Disable insecure certificate warnings in debug logs}
    disabled_delay: ${5:# Configures the eradication delay for destroyed objects that I(are) protected by SafeMode (objects for which eradication is disabled)}
    enabled_delay: ${6:# Configures the eradication delay for destroyed objects that I(are not) protected by SafeMode (objects for which eradication is disabled)}
    fa_url: ${7:# FlashArray management IPv4 address or Hostname}
    timer: ${8:# Set the eradication timer for the FlashArray}
  tags:
    - purestorage
    - flasharray
    - purefa_eradication]]></content>
  <tabTrigger>purestorage.flasharray.purefa_eradication</tabTrigger>
