<snippet>
  <content><![CDATA[- name: ${1:This module configures and manages replication policies on IBM Storage Virtualize family systems}
  ibm.storage_virtualize.ibm_sv_manage_replication_policy:
    clustername: ${2:# The hostname or management IP or Partition IP of the Storage Virtualize system}
    domain: ${3:# Domain for the Storage Virtualize system}
    ha_snapshots: ${4:# When specified as I(yes), snapshots created for volumes and volume groups associated with the policy will be replicated to the remote system}
    location1iogrp: ${5:# Specifies the ID of the I/O group of the system in location 1 of the topology}
    location1system: ${6:# Specifies the name or ID of the system in location 1 of the topology}
    location2iogrp: ${7:# Specifies the ID of the I/O group of the system in location 2 of the topology}
    location2system: ${8:# Specifies the name or ID of the system in location 2 of the topology}
    log_path: ${9:# Path of debug log file}
    name: ${10:# Specifies the name of the replication policy}
    partition: ${11:# Specifies the name of the storage partition to be assigned to async-dr replication policy}
    password: ${12:# REST API password for the Storage Virtualize system}
    rpoalert: ${13:# Specifies the RPO alert threshold in seconds}
    state: ${14:# Creates, updates (C(present)), or deletes (C(absent)) a replication policy}
    token: ${15:# The authentication token to verify a user on the Storage Virtualize system}
    topology: ${16:# Specifies the policy topology}
    username: ${17:# REST API username for the Storage Virtualize system}
    validate_certs: ${18:# Validates certification}
  tags:
    - ibm
    - storage_virtualize
    - ibm_sv_manage_replication_policy]]></content>
  <tabTrigger>ibm.storage_virtualize.ibm_sv_manage_replication_policy</tabTrigger>
