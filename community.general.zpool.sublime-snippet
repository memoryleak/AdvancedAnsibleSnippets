  <content><![CDATA[- name: ${1:Manage ZFS zpools}
  community.general.zpool:
    altroot: ${2:# Alternate root for mounting filesystems}
    disable_new_features: ${3:# If V(true), disable new ZFS feature flags when creating}
    filesystem_properties: ${4:# Dictionary of ZFS filesystem properties to set on the root dataset (for example V(compression), V(dedup))}
