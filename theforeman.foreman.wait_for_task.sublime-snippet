<snippet>
  <content><![CDATA[- name: ${1:Wait for a task}
  theforeman.foreman.wait_for_task:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    password: ${3:# Password of the user accessing the Foreman server}
    server_url: ${4:# URL of the Foreman server}
    task: ${5:# Task id to wait for}
    timeout: ${6:# How much time the task should take to be finished}
