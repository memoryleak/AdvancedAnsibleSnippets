<snippet>
  <content><![CDATA[- name: ${1:Manage Jenkins credentials and domains through API}
  community.general.jenkins_credential:
    api_uri: ${2:# Link to Github API}
    appID: ${3:# GitHub App ID}
    description: ${4:# Description of the credential or domain}
    exc_hostname: ${5:# List of hostnames to exclude from scope}
    exc_hostname_port: ${6:# List of host:port to exclude from scope}
    exc_path: ${7:# List of URL paths to exclude}
    file_path: ${8:# File path to secret file (for example O(type=file) or O(type=certificate))}
    force: ${9:# Force update if the credential already exists, used with O(state=present)}
    id: ${10:# The ID of the Jenkins credential or domain}
    inc_hostname: ${11:# List of hostnames to include in scope}
    inc_hostname_port: ${12:# List of V(host:port) to include in scope}
    inc_path: ${13:# List of URL paths to include when matching credentials to domains}
    jenkins_password: ${14:# Jenkins password for token creation}
    jenkins_user: ${15:# Jenkins user for authentication}
    location: ${16:# Location of the credential}
    name: ${17:# Name of the token to generate}
    owner: ${18:# GitHub App owner}
    passphrase: ${19:# SSH passphrase if needed}
    password: ${20:# Password for credentials types that require it (for example O(type=user_and_passs) or O(type=certificate))}
    private_key_path: ${21:# Path to private key file for PEM certificates or GitHub Apps}
    schemes: ${22:# List of schemes (for example V(http) or V(https)) to match}
    scope: ${23:# Jenkins credential domain scope}
    secret: ${24:# Secret text (used when O(type=text))}
    state: ${25:# The state of the credential}
    token: ${26:# Jenkins API token}
    type: ${27:# Type of the credential or action}
    url: ${28:# Jenkins server URL}
    username: ${29:# Username for credentials types that require it (for example O(type=ssh_key) or O(type=user_and_pass))}
  tags:
    - community
    - general
    - jenkins_credential]]></content>
  <tabTrigger>community.general.jenkins_credential</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Jenkins credentials and domains through API</description>
</snippet>