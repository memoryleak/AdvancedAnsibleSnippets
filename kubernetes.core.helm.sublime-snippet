<snippet>
  <content><![CDATA[- name: ${1:Manages Kubernetes packages with the Helm package manager}
  kubernetes.core.helm:
    api_key: ${2:# Token used to authenticate with the API}
    atomic: ${3:# If set, the installation process deletes the installation on failure}
    binary_path: ${4:# The path of a helm binary to use}
    ca_cert: ${5:# Path to a CA certificate used to authenticate with the API}
    chart_ref: ${6:# chart_reference on chart repository}
    chart_repo_url: ${7:# Chart repository URL where to locate the requested chart}
    chart_version: ${8:# Chart version to install}
    context: ${9:# Helm option to specify which kubeconfig context to use}
    create_namespace: ${10:# Create the release namespace if not present}
    dependency_update: ${11:# Run standalone C(helm dependency update CHART) before the operation}
    disable_hook: ${12:# Helm option to disable hook on install/upgrade/delete}
    force: ${13:# Helm option to force reinstall, ignore on new install}
    history_max: ${14:# Limit the maximum number of revisions saved per release}
    host: ${15:# Provide a URL for accessing the API}
    insecure_skip_tls_verify: ${16:# Skip tls certificate checks for the chart download}
    kubeconfig: ${17:# Helm option to specify kubeconfig path to use}
    plain_http: ${18:# Use HTTP instead of HTTPS when working with OCI registries}
    post_renderer: ${19:# Path to an executable to be used for post rendering}
    purge: ${20:# Remove the release from the store and make its name free for later use}
    release_name: ${21:# Release name to manage}
    release_namespace: ${22:# Kubernetes namespace where the chart should be installed}
    release_state: ${23:# Desirated state of release}
    release_values: ${24:# Value to pass to chart}
    replace: ${25:# Reuse the given name, only if that name is a deleted release which remains in the history}
    reset_then_reuse_values: ${26:# When upgrading package, reset the values to the ones built into the chart, apply the last release's values and merge in any overrides from parameters O(release_values), O(values_files) or O(set_values)}
    reset_values: ${27:# When upgrading package, reset the values to the ones built into the chart}
    reuse_values: ${28:# When upgrading package, specifies wether to reuse the last release's values and merge in any overrides from parameters I(release_values), I(values_files) or I(set_values)}
    set_values: ${29:# Values to pass to chart configuration}
    skip_crds: ${30:# Skip custom resource definitions when installing or upgrading}
    skip_schema_validation: ${31:# Disables JSON schema validation for Chart and values}
    take_ownership: ${32:# When upgrading, Helm will ignore the check for helm annotations and take ownership of the existing resources}
    timeout: ${33:# A Go duration (described here I(https://pkg}
    update_repo_cache: ${34:# Run C(helm repo update) before the operation}
    validate_certs: ${35:# Whether or not to verify the API server's SSL certificates}
    values_files: ${36:# Value files to pass to chart}
    wait: ${37:# When I(release_state) is set to C(present), wait until all Pods, PVCs, Services, and minimum number of Pods of a Deployment are in a ready state before marking the release as successful}
    wait_timeout: ${38:# Timeout when wait option is enabled (helm2 is a number of seconds, helm3 is a duration)}
  tags:
    - kubernetes
    - core
    - helm]]></content>
  <tabTrigger>kubernetes.core.helm</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manages Kubernetes packages with the Helm package manager</description>
</snippet>