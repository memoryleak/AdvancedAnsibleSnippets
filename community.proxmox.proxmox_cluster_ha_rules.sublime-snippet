<snippet>
  <content><![CDATA[- name: ${1:Management of HA rules}
  community.proxmox.proxmox_cluster_ha_rules:
    affinity: ${2:# Describes whether the HA resource are supposed to be kept on the same node V(positive),}
    api_host: ${3:# Specify the target host of the Proxmox VE cluster}
    api_password: ${4:# Specify the password to authenticate with}
    api_port: ${5:# Specify the target port of the Proxmox VE cluster}
    api_token_id: ${6:# Specify the token ID}
    api_token_secret: ${7:# Specify the token secret}
    api_user: ${8:# Specify the user to authenticate with}
    comment: ${9:# Description}
    disable: ${10:# Whether the HA rule is disabled}
    force: ${11:# Existing rules with a specific O(type) can not be changed to the other type}
    name: ${12:# HA rule identifier}
    nodes: ${13:# List of cluster node members, where a priority can be given to each node}
    resources: ${14:# List of HA resource IDs}
    state: ${15:# create or delete rule}
    strict: ${16:# If false, the HA resource can also be moved to other nodes if there is none of the specified nodes available}
    type: ${17:# HA rule type}
    validate_certs: ${18:# If V(false), SSL certificates will not be validated}
  tags:
    - community
    - proxmox
    - proxmox_cluster_ha_rules]]></content>
  <tabTrigger>community.proxmox.proxmox_cluster_ha_rules</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Management of HA rules</description>
</snippet>