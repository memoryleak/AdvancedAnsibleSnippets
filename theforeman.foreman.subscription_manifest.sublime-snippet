<snippet>
  <content><![CDATA[- name: ${1:Manage Subscription Manifests}
  theforeman.foreman.subscription_manifest:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    manifest_path: ${3:# Path to the manifest zip file}
    organization: ${4:# Organization that the entity is in}
    password: ${5:# Password of the user accessing the Foreman server}
    repository_url: ${6:# URL to retrieve content from}
    server_url: ${7:# URL of the Foreman server}
    state: ${8:# The state of the manifest}
    use_gssapi: ${9:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${10:# Username accessing the Foreman server}
    validate_certs: ${11:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - subscription_manifest]]></content>
  <tabTrigger>theforeman.foreman.subscription_manifest</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Subscription Manifests</description>
</snippet>