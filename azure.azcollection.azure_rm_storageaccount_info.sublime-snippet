<snippet>
  <content><![CDATA[- name: ${1:Get storage account facts}
  azure.azcollection.azure_rm_storageaccount_info:
    ad_user: ${2:# Active Directory username}
    adfs_authority_url: ${3:# Azure AD authority url}
    api_profile: ${4:# Selects an API profile to use when communicating with Azure services}
    auth_mode: ${5:# The mode in which to run the command}
    auth_source: ${6:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${7:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${8:# Azure client ID}
    cloud_environment: ${9:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    disable_instance_discovery: ${10:# Determines whether or not instance discovery is performed when attempting to authenticate}
    log_mode: ${11:# Parent argument}
    log_path: ${12:# Parent argument}
    name: ${13:# Only show results for a specific account}
    password: ${14:# Active Directory user password}
    profile: ${15:# Security profile found in ~/}
    resource_group: ${16:# Limit results to a resource group}
    secret: ${17:# Azure client secret}
    show_blob_cors: ${18:# Show the blob CORS settings for each blob related to the storage account}
    show_connection_string: ${19:# Show the connection string for each of the storageaccount's endpoints}
    show_georeplication_stats: ${20:# Show the Geo Replication Stats for each storage account}
    subscription_id: ${21:# Your Azure subscription Id}
    tags: ${22:# Limit results by providing a list of tags}
    tenant: ${23:# Azure tenant ID}
    thumbprint: ${24:# The thumbprint of the private key specified in I(x509_certificate_path)}
    x509_certificate_path: ${25:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_storageaccount_info]]></content>
  <tabTrigger>azure.azcollection.azure_rm_storageaccount_info</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Get storage account facts</description>
</snippet>