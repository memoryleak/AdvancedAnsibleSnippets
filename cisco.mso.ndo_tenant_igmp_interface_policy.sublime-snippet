<snippet>
  <content><![CDATA[- name: ${1:Manage Internet Group Management Protocol (IGMP) Interface Policies in Tenant Policy Templates on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_tenant_igmp_interface_policy:
    description: ${2:# The description of the IGMP Interface Policy}
    fast_leave: ${3:# Enable or disable fast leave}
    group_timeout: ${4:# The group timeout value in seconds}
    host: ${5:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    igmp_version: ${6:# The IGMP version of the IGMP Interface Policy}
    last_member_count: ${7:# The last member query count value}
    last_member_response_time: ${8:# The last member query response time value in seconds}
    login_domain: ${9:# The login domain name to use for authentication}
    maximum_multicast_entries: ${10:# The maximum multicast entries value}
    name: ${11:# The name of the IGMP Interface Policy}
    output_level: ${12:# Influence the output of this MSO module}
    password: ${13:# The password to use for authentication}
    port: ${14:# Port number to be used for the REST connection}
    querier_timeout: ${15:# The querier timeout value in seconds}
    query_interval: ${16:# The query interval value in seconds}
    query_response_interval: ${17:# The query response interval value in seconds}
    report_link_local_groups: ${18:# Enable or disable reporting link-local groups}
    report_policy_route_map: ${19:# The Route Map Policy for Multicast}
    report_policy_route_map_uuid: ${20:# The UUID of the report policy route map}
    reserved_multicast_entries: ${21:# The reserved multicast entries value}
    robustness_variable: ${22:# The robustness variable value}
    startup_query_count: ${23:# The startup query count value}
    startup_query_interval: ${24:# The startup query interval value in seconds}
    state: ${25:# Use C(absent) for removing}
    state_limit_route_map: ${26:# The Route Map Policy for Multicast}
    state_limit_route_map_uuid: ${27:# The UUID of the state limit route map}
    static_report_route_map: ${28:# The Route Map Policy for Multicast}
    static_report_route_map_uuid: ${29:# The UUID of the static report route map}
    template: ${30:# The name of the tenant template}
    template_id: ${31:# The ID of the L3Out template}
    timeout: ${32:# The socket level timeout in seconds}
    use_proxy: ${33:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${34:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${35:# The username to use for authentication}
    uuid: ${36:# The UUID of the IGMP Interface Policy}
    validate_certs: ${37:# If C(false), SSL certificates will not be validated}
    version3_asm: ${38:# Enable or disable IGMP version 3 ASM}
  tags:
    - cisco
    - mso
    - ndo_tenant_igmp_interface_policy]]></content>
