<snippet>
  <content><![CDATA[- name: ${1:Generate OpenSSL PKCS#12 archive}
  community.crypto.openssl_pkcs12:
    action: ${2:# V(export) or V(parse) a PKCS#12}
    attributes: ${3:# The attributes the resulting filesystem object should have}
    backup: ${4:# Create a backup file including a timestamp so you can get the original output file back if you overwrote it with a new one by accident}
    certificate_content: ${5:# Content of the certificate file in PEM format}
    certificate_path: ${6:# The path to read certificates and private keys from}
    encryption_level: ${7:# Determines the encryption level used}
    force: ${8:# Should the file be regenerated even if it already exists}
    friendly_name: ${9:# Specifies the friendly name for the certificate and private key}
    group: ${10:# Name of the group that should own the filesystem object, as would be fed to C(chown)}
    iter_size: ${11:# Number of times to repeat the encryption step}
    maciter_size: ${12:# Number of times to repeat the MAC step}
    mode: ${13:# The permissions the resulting filesystem object should have}
    other_certificates: ${14:# List of other certificates to include}
    other_certificates_content: ${15:# List of other certificates to include}
    other_certificates_parse_all: ${16:# If set to V(true), assumes that the files mentioned in O(other_certificates)/O(other_certificates_content) can contain more than one certificate per file/item (or even none per file/item)}
    owner: ${17:# Name of the user that should own the filesystem object, as would be fed to C(chown)}
    passphrase: ${18:# The PKCS#12 password}
    path: ${19:# Filename to write the PKCS#12 file to}
    privatekey_content: ${20:# Content of the private key file}
    privatekey_passphrase: ${21:# Passphrase source to decrypt any input private keys with}
    privatekey_path: ${22:# File to read private key from}
    return_content: ${23:# If set to V(true), will return the (current or generated) PKCS#12's content as RV(pkcs12)}
    select_crypto_backend: ${24:# Determines which crypto backend to use}
    selevel: ${25:# The level part of the SELinux filesystem object context}
    serole: ${26:# The role part of the SELinux filesystem object context}
    setype: ${27:# The type part of the SELinux filesystem object context}
    seuser: ${28:# The user part of the SELinux filesystem object context}
    src: ${29:# PKCS#12 file path to parse}
    state: ${30:# Whether the file should exist or not}
    unsafe_writes: ${31:# Influence when to use atomic operation to prevent data corruption or inconsistent reads from the target filesystem object}
  tags:
    - community
    - crypto
    - openssl_pkcs12]]></content>
  <tabTrigger>community.crypto.openssl_pkcs12</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Generate OpenSSL PKCS#12 archive</description>
</snippet>