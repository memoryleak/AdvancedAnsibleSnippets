<snippet>
  <content><![CDATA[- name: ${1:Manage LDAP Authentication Sources}
  theforeman.foreman.auth_source_ldap:
    account: ${2:# Account name to use when accessing the LDAP server}
    account_password: ${3:# Account password to use when accessing the LDAP server}
    attr_firstname: ${4:# Attribute containing first name}
    attr_lastname: ${5:# Attribute containing last name}
    attr_login: ${6:# Attribute containing login ID}
    attr_mail: ${7:# Attribute containing email address}
    attr_photo: ${8:# Attribute containing user photo}
    base_dn: ${9:# The base DN to use when searching}
    ca_path: ${10:# PEM formatted file that contains a CA certificate to be used for validation}
    groups_base: ${11:# Base DN where groups reside}
    host: ${12:# The hostname of the LDAP server}
    ldap_filter: ${13:# Filter to apply to LDAP searches}
    ldap_group_membership: ${14:# Which group membership method to use, not valid for I(server_type=active_directory)}
    locations: ${15:# List of locations the entity should be assigned to}
    name: ${16:# The name of the LDAP authentication source}
    onthefly_register: ${17:# Whether or not to register users on the fly}
    organizations: ${18:# List of organizations the entity should be assigned to}
    password: ${19:# Password of the user accessing the Foreman server}
    port: ${20:# The port number of the LDAP server}
    server_type: ${21:# Type of the LDAP server}
    server_url: ${22:# URL of the Foreman server}
    state: ${23:# State of the entity}
    tls: ${24:# Whether or not to use TLS when contacting the LDAP server}
    use_gssapi: ${25:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_netgroups: ${26:# Whether to use NIS netgroups instead of posix groups, not valid for I(server_type=active_directory)}
    usergroup_sync: ${27:# Whether or not to sync external user groups on login}
    username: ${28:# Username accessing the Foreman server}
    validate_certs: ${29:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - auth_source_ldap]]></content>
  <tabTrigger>theforeman.foreman.auth_source_ldap</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage LDAP Authentication Sources</description>
</snippet>