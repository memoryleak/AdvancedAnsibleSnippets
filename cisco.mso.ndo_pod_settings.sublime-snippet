<snippet>
  <content><![CDATA[- name: ${1:Manage Pod Settings on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_pod_settings:
    description: ${2:# The description of the Pod Settings}
    host: ${3:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    login_domain: ${4:# The login domain name to use for authentication}
    macsec_policy: ${5:# The MACsec Policy to be used}
    macsec_policy_uuid: ${6:# The UUID of the MACsec Policy to be used}
    name: ${7:# The name of the Pod Settings}
    ntp_policy: ${8:# The NTP Policy to be used}
    ntp_policy_uuid: ${9:# The UUID of the NTP Policy to be used}
    output_level: ${10:# Influence the output of this MSO module}
    password: ${11:# The password to use for authentication}
    port: ${12:# Port number to be used for the REST connection}
    state: ${13:# Use C(absent) for removing}
    template: ${14:# The name of the template}
    template_id: ${15:# The ID of the template}
    timeout: ${16:# The socket level timeout in seconds}
    use_proxy: ${17:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${18:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${19:# The username to use for authentication}
    uuid: ${20:# The UUID of the Pod Settings}
    validate_certs: ${21:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_pod_settings]]></content>
