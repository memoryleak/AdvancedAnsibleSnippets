<snippet>
  <content><![CDATA[- name: ${1:Manage L3Outs on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_l3out_template:
    attached_host_route_redistribution: ${2:# The name of the Route Map Policy for Route Control that needs to be associated with Attached Host Route Redistribution route map}
    bgp: ${3:# The BGP routing protocol configuration of the L3Out}
    connected_route_redistribution: ${4:# The name of the Route Map Policy for Route Control that needs to be associated with Connected Route Redistribution route map}
    description: ${5:# The description of the L3Out}
    host: ${6:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    interleak: ${7:# The name of the Route Map Policy for Route Control that needs to be associated with Interleak route map}
    l3_domain: ${8:# The name of the L3 Domain}
    login_domain: ${9:# The login domain name to use for authentication}
    name: ${10:# The name of the L3Out}
    ospf: ${11:# The OSPF routing protocol configuration of the L3Out}
    output_level: ${12:# Influence the output of this MSO module}
    password: ${13:# The password to use for authentication}
    pim: ${14:# The protocol independent multicast (PIM) flag of the L3Out}
    port: ${15:# Port number to be used for the REST connection}
    state: ${16:# Use C(absent) for removing}
    static_route_redistribution: ${17:# The name of the Route Map Policy for Route Control that needs to be associated with Static Route Redistribution route map}
    target_dscp: ${18:# The DSCP Level of the L3Out}
    template: ${19:# The name of the L3Out template}
    timeout: ${20:# The socket level timeout in seconds}
    use_proxy: ${21:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${22:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${23:# The username to use for authentication}
    uuid: ${24:# The UUID of the L3Out}
    validate_certs: ${25:# If C(false), SSL certificates will not be validated}
    vrf: ${26:# The VRF associated with the L3Out}
  tags:
    - cisco
    - mso
    - ndo_l3out_template]]></content>
  <tabTrigger>cisco.mso.ndo_l3out_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage L3Outs on Cisco Nexus Dashboard Orchestrator (NDO)</description>
</snippet>