<snippet>
  <content><![CDATA[- name: ${1:Resource module for Sites Device Credentials Apply}
  cisco.dnac.sites_device_credentials_apply:
    configureDevice: ${2:# If the value is true and the devices at the applied site are locally authenticated, the applied CLI credentials will be configured on the devices}
    deviceCredentialId: ${3:# It must be cli/snmpV2Read/snmpV2Write/snmpV3 Id}
    dnac_debug: ${4:# Flag for Cisco DNA Center SDK to enable debugging}
    dnac_host: ${5:# The Cisco DNA Center hostname}
    dnac_password: ${6:# The Cisco DNA Center password to authenticate}
    dnac_port: ${7:# The Cisco DNA Center port}
    dnac_username: ${8:# The Cisco DNA Center username to authenticate}
    dnac_verify: ${9:# Flag to enable or disable SSL certificate verification}
    dnac_version: ${10:# Informs the SDK which version of Cisco DNA Center to use}
    siteId: ${11:# Site Id}
    validate_response_schema: ${12:# Flag for Cisco DNA Center SDK to enable the validation of request bodies against a JSON schema}
  tags:
    - cisco
    - dnac
    - sites_device_credentials_apply]]></content>
  <tabTrigger>cisco.dnac.sites_device_credentials_apply</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Resource module for Sites Device Credentials Apply</description>
</snippet>