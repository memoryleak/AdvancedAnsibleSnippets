<snippet>
  <content><![CDATA[- name: ${1:Manage Domains}
  theforeman.foreman.domain:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    description: ${3:# Full name describing the domain}
    dns_proxy: ${4:# DNS proxy to use within this domain for managing A records}
    locations: ${5:# List of locations the entity should be assigned to}
    name: ${6:# The full DNS domain name}
    organizations: ${7:# List of organizations the entity should be assigned to}
    parameters: ${8:# Domain specific host parameters}
    password: ${9:# Password of the user accessing the Foreman server}
    server_url: ${10:# URL of the Foreman server}
    state: ${11:# State of the entity}
    updated_name: ${12:# New domain name}
    use_gssapi: ${13:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${14:# Username accessing the Foreman server}
    validate_certs: ${15:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - domain]]></content>
  <tabTrigger>theforeman.foreman.domain</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Domains</description>
</snippet>