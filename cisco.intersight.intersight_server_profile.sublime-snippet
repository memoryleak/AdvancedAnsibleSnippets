<snippet>
  <content><![CDATA[- name: ${1:Server Profile configuration for Cisco Intersight}
  cisco.intersight.intersight_server_profile:
    adapter_policy: ${2:# Name of Adapter Policy to associate with this profile}
    api_key_id: ${3:# Public API Key ID associated with the private key}
    api_private_key: ${4:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${5:# URI used to access the Intersight API}
    assigned_server: ${6:# Managed Obect ID (MOID) of assigned server}
    bios_policy: ${7:# Name of BIOS Policy to associate with this profile}
    boot_order_policy: ${8:# Name of Boot Order Policy to associate with this profile}
    certificate_policy: ${9:# Name of Certificate Policy to associate with this profile}
    description: ${10:# The user-defined description of the Server Profile}
    drive_security_policy: ${11:# Name of Drive Security Policy to associate with this profile}
    firmware_policy: ${12:# Name of Firmware Policy to associate with this profile}
    imc_access_policy: ${13:# Name of IMC Access Policy to associate with this profile}
    ipmi_over_lan_policy: ${14:# Name of IPMI over LAN Policy to associate with this profile}
    lan_connectivity_policy: ${15:# Name of LAN Connectivity Policy to associate with this profile}
    ldap_policy: ${16:# Name of LDAP Policy to associate with this profile}
    local_user_policy: ${17:# Name of Local User Policy to associate with this profile}
    name: ${18:# The name assigned to the Server Profile}
    network_connectivity_policy: ${19:# Name of Network Connectivity Policy to associate with this profile}
    ntp_policy: ${20:# Name of NTP Policy to associate with this profile}
    organization: ${21:# The name of the Organization this resource is assigned to}
    power_policy: ${22:# Name of Power Policy to associated with this profile}
    san_connectivity_policy: ${23:# Name of SAN Connectivity Policy to associate with this profile}
    sd_card_policy: ${24:# Name of SD Card Policy to associate with this profile}
    serial_over_lan_policy: ${25:# Name of Serial over LAN Policy to associate with this profile}
    smtp_policy: ${26:# Name of SMTP Policy to associate with this profile}
    snmp_policy: ${27:# Name of SNMP Policy to associate with this profile}
    ssh_policy: ${28:# Name of SSH Policy to associate with this profile}
    state: ${29:# If C(present), will verify the resource is present and will create if needed}
    static_uuid_address: ${30:# Static UUID address to assign to the server}
    storage_policy: ${31:# Name of Storage Policy to associate with this profile}
    syslog_policy: ${32:# Name of Syslog Policy to associate with this profile}
    tags: ${33:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    target_platform: ${34:# The platform for which the server profile is applicable}
    thermal_policy: ${35:# Name of Thermal Policy to associate with this profile}
    use_proxy: ${36:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    uuid_address_type: ${37:# UUID address allocation type for the server}
    uuid_pool: ${38:# Name of the UUID pool to assign UUID from}
    validate_certs: ${39:# Boolean control for verifying the api_uri TLS certificate}
    virtual_kvm_policy: ${40:# Name of Virtual KVM Policy to associate with this profile}
    virtual_media_policy: ${41:# Name of Virtual Media Policy to associate with this profile}
  tags:
    - cisco
    - intersight
    - intersight_server_profile]]></content>
  <tabTrigger>cisco.intersight.intersight_server_profile</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Server Profile configuration for Cisco Intersight</description>
</snippet>