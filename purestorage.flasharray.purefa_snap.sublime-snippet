<snippet>
  <content><![CDATA[- name: ${1:Manage volume snapshots on Pure Storage FlashArrays}
  purestorage.flasharray.purefa_snap:
    api_token: ${2:# FlashArray API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    disable_warnings: ${4:# Disable insecure certificate warnings in debug logs}
    eradicate: ${5:# Define whether to eradicate the snapshot on delete or leave in trash}
    fa_url: ${6:# FlashArray management IPv4 address or Hostname}
    ignore_repl: ${7:# Only valid for Purity//FA 6}
    name: ${8:# The name of the source volume}
    offload: ${9:# Only valid for Purity//FA 6}
    overwrite: ${10:# Define whether to overwrite existing volume when creating from snapshot}
    state: ${11:# Define whether the volume snapshot should exist or not}
    suffix: ${12:# Suffix of snapshot name}
    target: ${13:# Name of target volume if creating from snapshot}
    throttle: ${14:# If set to true, allows snapshot to fail if array health is not optimal}
  tags:
    - purestorage
    - flasharray
    - purefa_snap]]></content>
  <tabTrigger>purestorage.flasharray.purefa_snap</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage volume snapshots on Pure Storage FlashArrays</description>
</snippet>