  <content><![CDATA[- name: ${1:Manage the state of a virtual host in RabbitMQ}
  community.rabbitmq.rabbitmq_vhost:
    ca_cert: ${2:# CA certificate to verify SSL connection to management API}
    client_cert: ${3:# Client certificate to send on SSL connections to management API}
    client_key: ${4:# Private key matching the client certificate}
    login_host: ${5:# RabbitMQ host for connection}
    login_password: ${6:# RabbitMQ password for connection}
    login_port: ${7:# RabbitMQ management API port}
    login_protocol: ${8:# RabbitMQ management API protocol}
    login_user: ${9:# RabbitMQ user for connection}
    name: ${10:# The name of the vhost to manage}
    node: ${11:# erlang node name of the rabbit we wish to configure}
    state: ${12:# The state of vhost}
    tracing: ${13:# Enable/disable tracing for a vhost}
  tags:
    - community
    - rabbitmq
    - rabbitmq_vhost]]></content>
