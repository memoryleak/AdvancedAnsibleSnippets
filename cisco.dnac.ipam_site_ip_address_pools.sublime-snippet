    ipV6AddressSpace: ${11:# Ipam Site Ip Address Pools's ipV6AddressSpace}
    name: ${12:# The name for this reserve IP pool}
    poolType: ${13:# Once created, a subpool type cannot be changed}
    siteId: ${14:# The `id` of the site that this subpool belongs to}
    siteName: ${15:# The name of the site that this subpool belongs to}
    validate_response_schema: ${16:# Flag for Cisco DNA Center SDK to enable the validation of request bodies against a JSON schema}
