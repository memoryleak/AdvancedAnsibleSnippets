<snippet>
  <content><![CDATA[- name: ${1:Configure Infoblox NIOS VLANs}
  infoblox.nios_modules.nios_vlan:
    comment: ${2:# Configures a text string comment to be associated with the instance of this object}
    contact: ${3:# Contact information for person/team managing or using VLAN}
    department: ${4:# Department where VLAN is used}
    description: ${5:# Description for the VLAN object, may be potentially used for longer VLAN names}
    extattrs: ${6:# Allows for the configuration of Extensible Attributes on the instance of the object}
    id: ${7:# Specifies the vlan id to add or remove from the system}
    name: ${8:# Specifies the vlan name to add or remove from the system}
    parent: ${9:# Specifies the vlan parent to add or remove from the system}
    provider: ${10:# A dict object containing connection details}
    reserved: ${11:# When set VLAN can only be assigned to IPAM object manually}
    state: ${12:# Configures the intended state of the instance of the object on the NIOS server}
  tags:
    - infoblox
    - nios_modules
    - nios_vlan]]></content>
  <tabTrigger>infoblox.nios_modules.nios_vlan</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Configure Infoblox NIOS VLANs</description>
</snippet>