<snippet>
  <content><![CDATA[- name: ${1:Manage Eventgrid Topics}
  azure.azcollection.azure_rm_eventgrid_topic:
    ad_user: ${2:# Active Directory username}
    adfs_authority_url: ${3:# Azure AD authority url}
    api_profile: ${4:# Selects an API profile to use when communicating with Azure services}
    append_tags: ${5:# Use to control if tags field is canonical or just appends to existing tags}
    auth_source: ${6:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${7:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${8:# Azure client ID}
    cloud_environment: ${9:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    disable_instance_discovery: ${10:# Determines whether or not instance discovery is performed when attempting to authenticate}
    extended_location_name: ${11:# The extended location name}
    extended_location_type: ${12:# The extended location type}
    identity: ${13:# Identity for the Server}
    inbound_ip_rules: ${14:# List of inbound IP rules}
    input_mapping_default_values: ${15:# When input_schema is specified as CustomEventSchema, this parameter can be used to specify input mappings based on default values}
    input_mapping_fields: ${16:# When input_schema is specified as CustomEventSchema, this parameter is used to specify input mappings based on field names}
    input_schema: ${17:# Schema in which incoming events will be published to this topic/domain}
    kind: ${18:# The kind of topic resource}
    location: ${19:# Valid azure location}
    log_mode: ${20:# Parent argument}
    log_path: ${21:# Parent argument}
    name: ${22:# Name of the topic}
    password: ${23:# Active Directory user password}
    profile: ${24:# Security profile found in ~/}
    public_network_access: ${25:# This determines if traffic is allowed over public network}
    regenerate_keys: ${26:# if C(present) and topic exsists (ie update action) this will force the listed key to be regeneratd}
    resource_group: ${27:# Name of a resource group where the topic exists or will be created}
    secret: ${28:# Azure client secret}
    state: ${29:# State of the Eventgrid Topic}
    subscription_id: ${30:# Your Azure subscription Id}
    tags: ${31:# Dictionary of string:string pairs to assign as metadata to the object}
    tenant: ${32:# Azure tenant ID}
    thumbprint: ${33:# The thumbprint of the private key specified in I(x509_certificate_path)}
    x509_certificate_path: ${34:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_eventgrid_topic]]></content>
  <tabTrigger>azure.azcollection.azure_rm_eventgrid_topic</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Eventgrid Topics</description>
</snippet>