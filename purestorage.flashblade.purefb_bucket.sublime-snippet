<snippet>
  <content><![CDATA[- name: ${1:Manage Object Store Buckets on a  Pure Storage FlashBlade}
  purestorage.flashblade.purefb_bucket:
    account: ${2:# Object Store Account for Bucket}
    api_token: ${3:# FlashBlade API token for admin privileged user}
    block_new_public_policies: ${4:# If set to true, adding bucket policies that grant public access to a bucket is not allowed}
    block_public_access: ${5:# If set to true, access to a bucket with a public policy is restricted to only authenticated users within the account that bucket belongs to}
    context: ${6:# Name of fleet member on which to perform the operation}
    default_retention: ${7:# The retention period, in days, used to apply locks on new objects if none is specified by the S3 client}
    disable_warnings: ${8:# Disable insecure certificate warnings}
    eradicate: ${9:# Define whether to eradicate the bucket on delete or leave in trash}
    eradication_delay: ${10:# Minimum eradication delay in days}
    eradication_mode: ${11:# The eradication mode of the bucket}
    fb_url: ${12:# FlashBlade management IP address or Hostname}
    freeze_locked_objects: ${13:# If set to true, a locked object will be read-only and no new versions of the object may be created due to modifications}
    hard_limit: ${14:# Whether the I(quota) value is enforced or not}
    manual_eradication: ${15:# The manual eradication status of the bucket}
    mode: ${16:# The type of bucket to be created}
    name: ${17:# Bucket Name}
    object_lock_enabled: ${18:# If set to true, then S3 APIs relating to object lock may be used}
    quota: ${19:# The effective quota limit applied against the size of the bucket}
    retention_lock: ${20:# Set retention lock level for the bucket}
    retention_mode: ${21:# The retention mode used to apply locks on new objects if none is specified by the S3 client}
    state: ${22:# Create, delete or modifies a bucket}
    versioning: ${23:# State of S3 bucket versioning}
  tags:
    - purestorage
    - flashblade
    - purefb_bucket]]></content>
  <tabTrigger>purestorage.flashblade.purefb_bucket</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Object Store Buckets on a Pure Storage FlashBlade</description>
</snippet>