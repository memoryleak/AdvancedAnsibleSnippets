<snippet>
  <content><![CDATA[- name: ${1:Create and manage reverse DNS entries on the Hetzner Cloud}
  hetzner.hcloud.rdns:
    api_endpoint: ${2:# The endpoint for the Hetzner Cloud API}
    api_endpoint_hetzner: ${3:# The endpoint for the Hetzner API}
    api_token: ${4:# The token for the Hetzner Cloud API}
    dns_ptr: ${5:# The DNS address the I(ip_address) should resolve to}
    floating_ip: ${6:# Name or ID of the Hetzner Cloud Floating IP you want to add the reverse DNS entry to}
    ip_address: ${7:# The IP address that should point to I(dns_ptr)}
    load_balancer: ${8:# Name or ID of the Hetzner Cloud Load Balancer you want to add the reverse DNS entry to}
    primary_ip: ${9:# Name or ID of the Hetzner Cloud Primary IP you want to add the reverse DNS entry to}
    server: ${10:# Name or ID of the Hetzner Cloud server you want to add the reverse DNS entry to}
    state: ${11:# State of the reverse DNS entry}
  tags:
    - hetzner
    - hcloud
    - rdns]]></content>
