<snippet>
  <content><![CDATA[- name: ${1:Revert a virtual machine to a snapshot}
  vmware.vmware.vm_snapshot_revert:
    datacenter: ${2:# Datacenter to search for the virtual machine}
    folder: ${3:# Absolute or relative folder path to search for the virtual machine}
    folder_paths_are_absolute: ${4:# If true, any folder path parameters are treated as absolute paths}
    hostname: ${5:# The hostname or IP address of the vSphere vCenter server}
    moid: ${6:# Managed Object ID of the virtual machine to manage}
    name: ${7:# Name of the virtual machine to work with}
    name_match: ${8:# If multiple VMs with the same name exist, use the first or last found}
    password: ${9:# The password of the vSphere vCenter server}
    port: ${10:# The port number of the vSphere vCenter server}
    proxy_host: ${11:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${12:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    snapshot_id: ${13:# The ID of the snapshot to revert to}
    snapshot_name: ${14:# The name of the snapshot to revert to}
    suppress_power_on: ${15:# If true, the virtual machine will not be powered on after the snapshot is reverted, even if the snapshot was taken while the virtual machine was powered on}
    use_instance_uuid: ${16:# Whether to use the VMware instance UUID rather than the BIOS UUID}
    username: ${17:# The username of the vSphere vCenter server}
    uuid: ${18:# UUID of the instance to manage}
    validate_certs: ${19:# Allows connection when SSL certificates are not valid}
  tags:
    - vmware
    - vmware
    - vm_snapshot_revert]]></content>
  <tabTrigger>vmware.vmware.vm_snapshot_revert</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Revert a virtual machine to a snapshot</description>
</snippet>