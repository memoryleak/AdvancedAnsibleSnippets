<snippet>
  <content><![CDATA[- name: ${1:Manage Compute Attributes}
  theforeman.foreman.compute_attribute:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    compute_profile: ${3:# Name of compute profile}
    compute_resource: ${4:# Name of compute resource}
    password: ${5:# Password of the user accessing the Foreman server}
    server_url: ${6:# URL of the Foreman server}
    state: ${7:# State of the entity}
    use_gssapi: ${8:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${9:# Username accessing the Foreman server}
    validate_certs: ${10:# Whether or not to verify the TLS certificates of the Foreman server}
    vm_attrs: ${11:# Hash containing the data of vm_attrs}
  tags:
    - theforeman
    - foreman
    - compute_attribute]]></content>
  <tabTrigger>theforeman.foreman.compute_attribute</tabTrigger>
