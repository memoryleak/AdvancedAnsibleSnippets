<snippet>
  <content><![CDATA[- name: ${1:Get group objects facts on Check Point over Web Services API}
  check_point.mgmt.cp_mgmt_group_facts:
    async_response: ${2:# Run command in asynchronous mode and return task UID}
    dereference_group_members: ${3:# Indicates whether to dereference 'members' field by details level for every object in reply}
    details_level: ${4:# The level of detail for some of the fields in the response can vary from showing only the UID value of the object to a fully detailed representation of the object}
    domains_to_process: ${5:# Indicates which domains to process the commands on}
    filter: ${6:# Search expression to filter objects by}
    limit: ${7:# No more than that many results will be returned}
    name: ${8:# Object name}
    offset: ${9:# Skip that many results before beginning to return them}
    order: ${10:# Sorts results by the given field}
    show_as_ranges: ${11:# When true, the group's matched content is displayed as ranges of IP addresses rather than network objects}
    show_membership: ${12:# Indicates whether to calculate and show 'groups' field for every object in reply}
    version: ${13:# Version of checkpoint}
  tags:
    - check_point
    - mgmt
    - cp_mgmt_group_facts]]></content>
