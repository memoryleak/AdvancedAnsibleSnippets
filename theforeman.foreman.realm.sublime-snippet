<snippet>
  <content><![CDATA[- name: ${1:Manage Realms}
  theforeman.foreman.realm:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    locations: ${3:# List of locations the entity should be assigned to}
    name: ${4:# Name of the realm}
    organizations: ${5:# List of organizations the entity should be assigned to}
    password: ${6:# Password of the user accessing the Foreman server}
    realm_proxy: ${7:# Proxy to use for this realm}
    realm_type: ${8:# Realm type}
    server_url: ${9:# URL of the Foreman server}
    state: ${10:# State of the entity}
    use_gssapi: ${11:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${12:# Username accessing the Foreman server}
    validate_certs: ${13:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - realm]]></content>
  <tabTrigger>theforeman.foreman.realm</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Realms</description>
</snippet>