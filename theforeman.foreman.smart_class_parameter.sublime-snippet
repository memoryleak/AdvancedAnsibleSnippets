<snippet>
  <content><![CDATA[- name: ${1:Manage Smart Class Parameters}
  theforeman.foreman.smart_class_parameter:
    avoid_duplicates: ${2:# Remove duplicate values (only array type)}
    ca_path: ${3:# PEM formatted file that contains a CA certificate to be used for validation}
    default_value: ${4:# Value to use by default}
    description: ${5:# Description of the Smart Class Parameter}
    hidden_value: ${6:# When enabled the parameter is hidden in the UI}
    merge_default: ${7:# Include default value when merging all matching values}
    merge_overrides: ${8:# Merge all matching values (only array/hash type)}
    omit: ${9:# Don't send this parameter in classification output}
    override: ${10:# Whether the smart class parameter value is managed by Foreman}
    override_value_order: ${11:# The order in which values are resolved}
    override_values: ${12:# Value overrides}
    parameter: ${13:# Name of the parameter}
    parameter_type: ${14:# Types of variable values}
    password: ${15:# Password of the user accessing the Foreman server}
    puppetclass_name: ${16:# Name of the puppetclass that own the parameter}
    required: ${17:# If true, will raise an error if there is no default value and no matcher provide a value}
    server_url: ${18:# URL of the Foreman server}
    state: ${19:# State of the entity}
    use_gssapi: ${20:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${21:# Username accessing the Foreman server}
    validate_certs: ${22:# Whether or not to verify the TLS certificates of the Foreman server}
    validator_rule: ${23:# Used to enforce certain values for the parameter values}
    validator_type: ${24:# Types of validation values}
  tags:
    - theforeman
    - foreman
    - smart_class_parameter]]></content>
  <tabTrigger>theforeman.foreman.smart_class_parameter</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Smart Class Parameters</description>
</snippet>