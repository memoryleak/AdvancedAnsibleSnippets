<snippet>
  <content><![CDATA[- name: ${1:Manage host templates in Icinga2}
  telekom_mms.icinga_director.icinga_host_template:
    accept_config: ${2:# Whether the agent is configured to accept config}
    address: ${3:# Host address}
    address6: ${4:# Host IPv6 address}
    api_timeout: ${5:# Default timeout to wait for transaction to finish in seconds}
    append: ${6:# Do not overwrite the whole object but instead append the defined properties}
    check_command: ${7:# The name of the check command}
    check_interval: ${8:# Your regular check interval}
    check_period: ${9:# The name of a time period which determines when this object should be monitored}
    check_timeout: ${10:# Check command timeout in seconds}
    client_cert: ${11:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${12:# PEM formatted file that contains your private key to be used for SSL client authentication}
    command_endpoint: ${13:# The endpoint where commands are executed on}
    disabled: ${14:# Disabled objects will not be deployed}
    display_name: ${15:# Alternative name for this host}
    enable_active_checks: ${16:# Whether to actively check this object}
    enable_event_handler: ${17:# Whether to enable event handlers this object}
    enable_flapping: ${18:# Whether flap detection is enabled on this object}
    enable_notifications: ${19:# Whether to send notifications for this object}
    enable_passive_checks: ${20:# Whether to accept passive check results for this object}
    enable_perfdata: ${21:# Whether to process performance data provided by this object}
    event_command: ${22:# Event command for host which gets called on every check execution if one of these conditions matches}
    flapping_threshold_high: ${23:# Flapping upper bound in percent for a service to be considered flapping}
    flapping_threshold_low: ${24:# Flapping lower bound in percent for a service to be considered not flapping}
    force: ${25:# If V(yes) do not get a cached copy}
    force_basic_auth: ${26:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    groups: ${27:# Hostgroups that should be directly assigned to this node}
    has_agent: ${28:# Whether this host has the Icinga 2 Agent installed}
    http_agent: ${29:# Header to identify as, generally appears in web server logs}
    icon_image: ${30:# An URL pointing to an icon for this object}
    icon_image_alt: ${31:# Alternative text to be shown in case above icon is missing}
    imports: ${32:# Choose a host-template}
    master_should_connect: ${33:# Whether the parent (master) node should actively try to connect to this agent}
    max_check_attempts: ${34:# Defines after how many check attempts a new hard state is reached}
    notes: ${35:# Additional notes for this object}
    notes_url: ${36:# An URL pointing to additional notes for this object}
    object_name: ${37:# Icinga object name for this host template}
    retry_interval: ${38:# Retry interval, will be applied after a state change unless the next hard state is reached}
    state: ${39:# Apply feature state}
    url: ${40:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${41:# The password for use in HTTP basic authentication}
    url_username: ${42:# The username for use in HTTP basic authentication}
    use_gssapi: ${43:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${44:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${45:# If V(no), SSL certificates will not be validated}
    vars: ${46:# Custom properties of the host}
    volatile: ${47:# Whether this check is volatile}
    zone: ${48:# Set the zone}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_host_template]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_host_template</tabTrigger>
