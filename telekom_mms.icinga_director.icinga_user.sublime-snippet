<snippet>
  <content><![CDATA[- name: ${1:Manage users in Icinga2}
  telekom_mms.icinga_director.icinga_user:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    append: ${3:# Do not overwrite the whole object but instead append the defined properties}
    client_cert: ${4:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${5:# PEM formatted file that contains your private key to be used for SSL client authentication}
    disabled: ${6:# Disabled objects will not be deployed}
    display_name: ${7:# Alternative name for this user}
    email: ${8:# The Email address of the user}
    force: ${9:# If V(yes) do not get a cached copy}
    force_basic_auth: ${10:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    groups: ${11:# User groups that should be directly assigned to this user}
    http_agent: ${12:# Header to identify as, generally appears in web server logs}
    imports: ${13:# Importable templates, add as many as you want}
    object_name: ${14:# Name of the user}
    pager: ${15:# The pager address of the user}
    period: ${16:# The name of a time period which determines when notifications to this User should be triggered}
    state: ${17:# Apply feature state}
    url: ${18:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${19:# The password for use in HTTP basic authentication}
    url_username: ${20:# The username for use in HTTP basic authentication}
    use_gssapi: ${21:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${22:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${23:# If V(no), SSL certificates will not be validated}
    vars: ${24:# Custom properties of the user}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_user]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_user</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage users in Icinga2</description>
</snippet>