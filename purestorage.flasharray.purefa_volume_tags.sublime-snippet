<snippet>
  <content><![CDATA[- name: ${1:Manage volume tags on Pure Storage FlashArrays}
  purestorage.flasharray.purefa_volume_tags:
    api_token: ${2:# FlashArray API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    copyable: ${4:# Define whether the volume tags are inherited on volume copies}
    disable_warnings: ${5:# Disable insecure certificate warnings in debug logs}
    fa_url: ${6:# FlashArray management IPv4 address or Hostname}
    kvp: ${7:# List of key value pairs to assign to the volume}
    name: ${8:# The name of the volume}
    namespace: ${9:# The name of tag namespace}
    state: ${10:# Define whether the volume tag(s) should exist or not}
    tag: ${11:# List of volume tags to be deleted from a volume}
  tags:
    - purestorage
    - flasharray
    - purefa_volume_tags]]></content>
  <tabTrigger>purestorage.flasharray.purefa_volume_tags</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage volume tags on Pure Storage FlashArrays</description>
</snippet>