<snippet>
  <content><![CDATA[- name: ${1:Fetch information about Red Hat Repositories}
  theforeman.foreman.repository_set_info:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    location: ${3:# Label of the Location to scope the search for}
    name: ${4:# Name of the resource to fetch information for}
    organization: ${5:# Name of the Organization to scope the search for}
    password: ${6:# Password of the user accessing the Foreman server}
    product: ${7:# Name of the parent product}
    search: ${8:# Search query to use}
    server_url: ${9:# URL of the Foreman server}
    use_gssapi: ${10:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${11:# Username accessing the Foreman server}
    validate_certs: ${12:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - repository_set_info]]></content>
  <tabTrigger>theforeman.foreman.repository_set_info</tabTrigger>
