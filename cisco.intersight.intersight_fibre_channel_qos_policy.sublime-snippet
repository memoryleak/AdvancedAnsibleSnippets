<snippet>
  <content><![CDATA[- name: ${1:Manage Fibre Channel QoS Policies for Cisco Intersight}
  cisco.intersight.intersight_fibre_channel_qos_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    burst: ${5:# The burst traffic, in bytes, allowed on the vHBA}
    cos: ${6:# Class of Service to be associated to the traffic on the virtual interface}
    description: ${7:# The user-defined description for the Fibre Channel QoS Policy}
    max_data_field_size: ${8:# The maximum size of the Fibre Channel frame payload bytes that the virtual interface supports}
    name: ${9:# The name assigned to the Fibre Channel QoS Policy}
    organization: ${10:# The name of the Organization this resource is assigned to}
    rate_limit: ${11:# The value in Mbps to use for limiting the data rate on the virtual interface}
    state: ${12:# If C(present), will verify the resource is present and will create if needed}
    tags: ${13:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    use_proxy: ${14:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${15:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_fibre_channel_qos_policy]]></content>
  <tabTrigger>cisco.intersight.intersight_fibre_channel_qos_policy</tabTrigger>
