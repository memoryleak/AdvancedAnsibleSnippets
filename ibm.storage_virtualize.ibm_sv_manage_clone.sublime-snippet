<snippet>
  <content><![CDATA[- name: ${1:This module manages clone and thinclone of volume and volumegroup}
  ibm.storage_virtualize.ibm_sv_manage_clone:
    clustername: ${2:# The hostname, management IP or partition IP of the Storage Virtualize system}
    domain: ${3:# Domain for the Storage Virtualize system}
    fromsourcevolumes: ${4:# Specifies colon-separated list of the parent volumes}
    ignoreuserfcmaps: ${5:# Indicates that snapshots can be created with the scheduler or with the addsnapshot command, if any volumes in the volume group are used as a source volume in legacy FlashCopy mapping}
    iogrp: ${6:# Specifies the name of the I/O group for the new clone}
    log_path: ${7:# Path of debug log file}
    name: ${8:# Specifies a name for the new clone}
    ownershipgroup: ${9:# Specifies the name of the ownership group to which the object is being added}
    partition: ${10:# Specifies the name of the storage partition to be assigned to the volume group}
    password: ${11:# REST API password for the Storage Virtualize system}
    pool: ${12:# Specifies the name of the storage pool to use while creating the clone}
    preferrednode: ${13:# Specifies the preferred node that is used to access the volume}
    snapshot: ${14:# Specifies the name of the snapshot that is used to create the clone}
    state: ${15:# Creates (C(present)) or removes (C(absent)) the clone object}
    token: ${16:# The authentication token to verify a user on the Storage Virtualize system}
    type: ${17:# Specifies the type of clone to create}
    username: ${18:# REST API username for the Storage Virtualize system}
    validate_certs: ${19:# Validates certification}
    volumegroup: ${20:# Specifies the name of the volumegroup to which the clone is to be added}
  tags:
    - ibm
    - storage_virtualize
    - ibm_sv_manage_clone]]></content>
  <tabTrigger>ibm.storage_virtualize.ibm_sv_manage_clone</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>This module manages clone and thinclone of volume and volumegroup</description>
</snippet>