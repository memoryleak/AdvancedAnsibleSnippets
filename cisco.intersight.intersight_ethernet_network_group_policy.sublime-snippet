<snippet>
  <content><![CDATA[- name: ${1:Ethernet Network Group Policy configuration for Cisco Intersight}
  cisco.intersight.intersight_ethernet_network_group_policy:
    allowed_vlans: ${2:# Include VLAN IDs using a list of comma separated VLAN IDs and VLAN ID Ranges}
    api_key_id: ${3:# Public API Key ID associated with the private key}
    api_private_key: ${4:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${5:# URI used to access the Intersight API}
    description: ${6:# The user-defined description for the Ethernet Network Group Policy}
    name: ${7:# The name assigned to the Ethernet Network Group Policy}
    native_vlan: ${8:# Set native VLAN for the Ethernet Network Group Policy}
    organization: ${9:# The name of the Organization this resource is assigned to}
    qinq_enabled: ${10:# Enable QinQ (802}
    qinq_vlan: ${11:# Set QinQ VLAN number}
    state: ${12:# If C(present), will verify the resource is present and will create if needed}
    tags: ${13:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    use_proxy: ${14:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${15:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_ethernet_network_group_policy]]></content>
