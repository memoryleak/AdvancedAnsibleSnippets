<snippet>
  <content><![CDATA[- name: ${1:Create and manage Storage Boxes in Hetzner}
  hetzner.hcloud.storage_box:
    access_settings: ${2:# Access settings of the Storage Box}
    api_endpoint: ${3:# The endpoint for the Hetzner Cloud API}
    api_endpoint_hetzner: ${4:# The endpoint for the Hetzner API}
    api_token: ${5:# The token for the Hetzner Cloud API}
    delete_protection: ${6:# Protect the Storage Box from deletion}
    id: ${7:# ID of the Storage Box to manage}
    labels: ${8:# User-defined labels (key-value pairs) for the Storage Box}
    location: ${9:# Name or ID of the Location for the Storage Box}
    name: ${10:# Name of the Storage Box to manage}
    password: ${11:# Password for the Storage Box}
    snapshot: ${12:# Snapshot ID or Name to rollback to}
    snapshot_plan: ${13:# Snapshot plan of the Storage Box}
    ssh_keys: ${14:# SSH public keys in OpenSSH format to inject into the Storage Box}
    state: ${15:# State of the Storage Box}
    storage_box_type: ${16:# Name or ID of the Storage Box Type for the Storage Box}
  tags:
    - hetzner
    - hcloud
    - storage_box]]></content>
  <tabTrigger>hetzner.hcloud.storage_box</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Create and manage Storage Boxes in Hetzner</description>
</snippet>