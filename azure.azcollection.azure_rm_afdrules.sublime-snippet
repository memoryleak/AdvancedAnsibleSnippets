<snippet>
  <content><![CDATA[- name: ${1:Manage an Azure Front Door Rules}
  azure.azcollection.azure_rm_afdrules:
    actions: ${2:# A list of actions that are executed when all the conditions of a rule are satisfied}
    ad_user: ${3:# Active Directory username}
    adfs_authority_url: ${4:# Azure AD authority url}
    api_profile: ${5:# Selects an API profile to use when communicating with Azure services}
    auth_source: ${6:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${7:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${8:# Azure client ID}
    cloud_environment: ${9:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    conditions: ${10:# A list of conditions that must be matched for the actions to be executed}
    disable_instance_discovery: ${11:# Determines whether or not instance discovery is performed when attempting to authenticate}
    log_mode: ${12:# Parent argument}
    log_path: ${13:# Parent argument}
    match_processing_behavior: ${14:# If this rule is a match should the rules engine continue running the remaining rules or stop}
    name: ${15:# Name of the delivery rule which is unique within the endpoint}
    order: ${16:# The order in which the rules are applied for the endpoint}
    password: ${17:# Active Directory user password}
    profile: ${18:# Security profile found in ~/}
    profile_name: ${19:# Name of the Azure Front Door Standard or Azure Front Door Premium profile which is unique within the resource group}
    resource_group: ${20:# Name of the Resource group within the Azure subscription}
    rule_set_name: ${21:# Name of the rule set under the profile}
    secret: ${22:# Azure client secret}
    state: ${23:# Assert the state of the CDN profile}
    subscription_id: ${24:# Your Azure subscription Id}
    tenant: ${25:# Azure tenant ID}
    thumbprint: ${26:# The thumbprint of the private key specified in I(x509_certificate_path)}
    x509_certificate_path: ${27:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_afdrules]]></content>
  <tabTrigger>azure.azcollection.azure_rm_afdrules</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage an Azure Front Door Rules</description>
</snippet>