<snippet>
  <content><![CDATA[- name: ${1:Manage Key Vault instance}
  azure.azcollection.azure_rm_keyvault:
    access_policies: ${2:# An array of 0 to 16 identities that have access to the key vault}
    ad_user: ${3:# Active Directory username}
    adfs_authority_url: ${4:# Azure AD authority url}
    administrators: ${5:# List of administrator OID's for data plane operations for Managed HSM}
    api_profile: ${6:# Selects an API profile to use when communicating with Azure services}
    append_tags: ${7:# Use to control if tags field is canonical or just appends to existing tags}
    auth_source: ${8:# Controls the source of the credentials to use for authentication}
    cert_validation_mode: ${9:# Controls the certificate validation behavior for Azure endpoints}
    client_id: ${10:# Azure client ID}
    cloud_environment: ${11:# For cloud environments other than the US public cloud, the environment name (as defined by Azure Python SDK, eg, C(AzureChinaCloud), C(AzureUSGovernment)), or a metadata discovery endpoint URL (required for Azure Stack)}
    disable_instance_discovery: ${12:# Determines whether or not instance discovery is performed when attempting to authenticate}
    enable_purge_protection: ${13:# Property specifying whether protection against purge is enabled for this vault}
    enable_rbac_authorization: ${14:# Property that controls how data actions are authorized}
    enable_soft_delete: ${15:# Property to specify whether the soft delete functionality is enabled for this key vault}
    enabled_for_deployment: ${16:# Property to specify whether Azure Virtual Machines are permitted to retrieve certificates stored as secrets from the key vault}
    enabled_for_disk_encryption: ${17:# Property to specify whether Azure Disk Encryption is permitted to retrieve secrets from the vault and unwrap keys}
    enabled_for_template_deployment: ${18:# Property to specify whether Azure Resource Manager is permitted to retrieve secrets from the key vault}
    hsm_name: ${19:# Name of the HSM}
    identity: ${20:# Identity for the HSM, not valid for vault_name}
    is_purge_deleted: ${21:# Whether permanently deletes the specified vault}
    location: ${22:# Resource location}
    log_mode: ${23:# Parent argument}
    log_path: ${24:# Parent argument}
    network_acls: ${25:# A collection of rules governing the accessibility of the vault from specific network locations}
    password: ${26:# Active Directory user password}
    profile: ${27:# Security profile found in ~/}
    public_network_access: ${28:# Property to specify whether the vault will accept traffic from public internet}
    recover_mode: ${29:# Create vault in recovery mode}
    resource_group: ${30:# The name of the Resource Group to which the server belongs}
    secret: ${31:# Azure client secret}
    sku: ${32:# SKU details}
    soft_delete_retention_in_days: ${33:# Property specifying the number of days to retain deleted vaults}
    state: ${34:# Assert the state of the KeyVault}
    subscription_id: ${35:# Your Azure subscription Id}
    tags: ${36:# Dictionary of string:string pairs to assign as metadata to the object}
    tenant: ${37:# Azure tenant ID}
    thumbprint: ${38:# The thumbprint of the private key specified in I(x509_certificate_path)}
    vault_name: ${39:# Name of the vault}
    vault_tenant: ${40:# The Azure Active Directory tenant ID that should be used for authenticating requests to the key vault}
    x509_certificate_path: ${41:# Path to the X509 certificate used to create the service principal in PEM format}
  tags:
    - azure
    - azcollection
    - azure_rm_keyvault]]></content>
  <tabTrigger>azure.azcollection.azure_rm_keyvault</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Key Vault instance</description>
</snippet>