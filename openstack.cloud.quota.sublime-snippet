<snippet>
  <content><![CDATA[- name: ${1:Manage OpenStack Quotas}
  openstack.cloud.quota:
    api_timeout: ${2:# How long should the socket layer wait before timing out for API calls}
    auth: ${3:# Dictionary containing auth information as needed by the cloud's auth plugin strategy}
    auth_type: ${4:# Name of the auth plugin to use}
    backup_gigabytes: ${5:# Maximum size of backups in GB's}
    backups: ${6:# Maximum number of backups allowed}
    ca_cert: ${7:# A path to a CA Cert bundle that can be used as part of verifying SSL API requests}
    client_cert: ${8:# A path to a client certificate to use as part of the SSL transaction}
    client_key: ${9:# A path to a client key to use as part of the SSL transaction}
    cloud: ${10:# Named cloud or cloud config to operate against}
    cores: ${11:# Maximum number of CPU's per project}
    fixed_ips: ${12:# Number of fixed IP's to allow}
    floating_ips: ${13:# Number of floating IP's to allow}
    gigabytes: ${14:# Maximum volume storage allowed for project}
    groups: ${15:# Number of groups that are allowed for the project}
    health_monitors: ${16:# Maximum number of health monitors that can be created}
    injected_file_content_bytes: ${17:# Maximum file size in bytes}
    injected_file_path_bytes: ${18:# Maximum path size}
    injected_files: ${19:# Number of injected files to allow}
    instances: ${20:# Maximum number of instances allowed}
    interface: ${21:# Endpoint URL type to fetch from the service catalog}
    key_pairs: ${22:# Number of key pairs to allow}
    l7_policies: ${23:# The maximum amount of L7 policies you can create}
    listeners: ${24:# The maximum number of listeners you can create}
    load_balancers: ${25:# The maximum amount of load balancers you can create}
    members: ${26:# Number of members allowed for loadbalancer}
    metadata_items: ${27:# Number of metadata items allowed per instance}
    name: ${28:# Name of the OpenStack Project to manage}
    networks: ${29:# Number of networks to allow}
    per_volume_gigabytes: ${30:# Maximum size in GB's of individual volumes}
    pools: ${31:# The maximum number of pools you can create}
    ports: ${32:# Number of Network ports to allow, this needs to be greater than the instances limit}
    ram: ${33:# Maximum amount of ram in MB to allow}
    rbac_policies: ${34:# Number of policies to allow}
    region_name: ${35:# Name of the region}
    routers: ${36:# Number of routers to allow}
    sdk_log_level: ${37:# Log level of the OpenStackSDK}
    sdk_log_path: ${38:# Path to the logfile of the OpenStackSDK}
    security_group_rules: ${39:# Number of rules per security group to allow}
    security_groups: ${40:# Number of security groups to allow}
    server_group_members: ${41:# Number of server group members to allow}
    server_groups: ${42:# Number of server groups to allow}
    snapshots: ${43:# Number of snapshots to allow}
    state: ${44:# A value of C(present) sets the quota and a value of C(absent) resets the quota to defaults}
    subnet_pools: ${45:# Number of subnet pools to allow}
    subnets: ${46:# Number of subnets to allow}
    timeout: ${47:# How long should ansible wait for the requested resource}
    validate_certs: ${48:# Whether or not SSL API requests should be verified}
    volumes: ${49:# Number of volumes to allow}
    wait: ${50:# Should ansible wait until the requested resource is complete}
  tags:
    - openstack
    - cloud
    - quota]]></content>
  <tabTrigger>openstack.cloud.quota</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage OpenStack Quotas</description>
</snippet>