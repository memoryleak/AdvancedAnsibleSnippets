<snippet>
  <content><![CDATA[- name: ${1:NetApp ONTAP manage LUNs}
  netapp.ontap.na_ontap_lun:
    cert_filepath: ${2:# path to SSL client cert file (}
    comment: ${3:# Optional descriptive comment for the LUN}
    feature_flags: ${4:# Enable or disable a new feature}
    flexvol_name: ${5:# The name of the FlexVol the LUN should exist on}
    force_ontap_version: ${6:# Override the cluster ONTAP version when using REST}
    force_remove: ${7:# If 'true', override checks that prevent a LUN from being destroyed if it is online and mapped}
    force_remove_fenced: ${8:# If 'true', override checks that prevent a LUN from being destroyed while it is fenced}
    force_resize: ${9:# Forcibly reduce the size}
    from_name: ${10:# The name of the LUN to be renamed}
    hostname: ${11:# The hostname or IP address of the ONTAP instance}
    http_port: ${12:# Override the default port (80 or 443) with this port}
    https: ${13:# Enable and disable https}
    key_filepath: ${14:# path to SSL client key file}
    lambda_config: ${15:# Configuration parameters for AWS Lambda proxy functionality}
    name: ${16:# The name of the LUN to manage}
    ontapi: ${17:# The ontap api version to use}
    os_type: ${18:# The os type for the LUN}
    password: ${19:# Password for the specified user}
    provisioning_options: ${20:# Options that are applied to create operation}
    qos_adaptive_policy_group: ${21:# The adaptive QoS policy group to be set on the LUN}
    qos_policy_group: ${22:# The QoS policy group to be set on the LUN}
    qtree_name: ${23:# Specifies the name of the Qtree that contains the new LUN}
    san_application_template: ${24:# additional options when using the application/applications REST API to create LUNs}
    size: ${25:# The size of the LUN in C(size_unit)}
    size_unit: ${26:# The unit used to interpret the size parameter}
    space_allocation: ${27:# This enables support for the SCSI Thin Provisioning features}
    space_reserve: ${28:# This can be set to 'false' which will create a LUN without any space being reserved}
    state: ${29:# Whether the specified LUN should exist or not}
    use_exact_size: ${30:# This can be set to 'false' which will round the LUN >= 450g}
    use_lambda: ${31:# Specifies if AWS Lambda proxy functionality should be used to connect to the ONTAP system}
    use_rest: ${32:# Whether to use REST or ZAPI}
    username: ${33:# This can be a Cluster-scoped or SVM-scoped account, depending on whether a Cluster-level or SVM-level API is required}
    validate_certs: ${34:# If set to C(no), the SSL certificates will not be validated}
    vserver: ${35:# The name of the vserver to use}
  tags:
    - netapp
    - ontap
    - na_ontap_lun]]></content>
  <tabTrigger>netapp.ontap.na_ontap_lun</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>NetApp ONTAP manage LUNs</description>
</snippet>