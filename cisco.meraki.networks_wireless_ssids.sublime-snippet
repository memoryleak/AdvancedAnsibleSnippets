    radiusFailoverPolicy: ${65:# This policy determines how authentication requests should be handled in the event that all of the configured RADIUS servers are unreachable ('Deny access' or 'Allow access')}
    radiusFallbackEnabled: ${66:# Whether or not higher priority RADIUS servers should be retried after 60 seconds}
    radiusGuestVlanEnabled: ${67:# Whether or not RADIUS Guest VLAN is enabled}
    radiusGuestVlanId: ${68:# VLAN ID of the RADIUS Guest VLAN}
    radiusLoadBalancingPolicy: ${69:# This policy determines which RADIUS server will be contacted first in an authentication attempt and the ordering of any necessary retry attempts ('Strict priority order' or 'Round robin')}
    radiusOverride: ${70:# If true, the RADIUS response can override VLAN tag}
    radiusProxyEnabled: ${71:# If true, Meraki devices will proxy RADIUS messages through the Meraki cloud to the configured RADIUS auth and accounting servers}
    radiusRadsec: ${72:# The current settings for RADIUS RADSec}
    radiusServerAttemptsLimit: ${73:# The maximum number of transmit attempts after which a RADIUS server is failed over (must be between 1-5)}
    radiusServerTimeout: ${74:# The amount of time for which a RADIUS client waits for a reply from the RADIUS server (must be between 1-10 seconds)}
    radiusServers: ${75:# The RADIUS 802}
    radiusTestingEnabled: ${76:# If true, Meraki devices will periodically send Access-Request messages to configured RADIUS servers using identity 'meraki_8021x_test' to ensure that the RADIUS servers are reachable}
    secondaryConcentratorNetworkId: ${77:# The secondary concentrator to use when the ipAssignmentMode is 'VPN'}
    speedBurst: ${78:# The SpeedBurst setting for this SSID'}
    splashGuestSponsorDomains: ${79:# Array of valid sponsor email domains for sponsored guest splash type}
    splashPage: ${80:# The type of splash page for the SSID ('None', 'Click-through splash page', 'Billing', 'Password-protected with Meraki RADIUS', 'Password-protected with custom RADIUS', 'Password-protected with Active Directory', 'Password-protected with LDAP', 'SMS authentication', 'Systems Manager Sentry', 'Facebook Wi-Fi', 'Google OAuth', 'Microsoft Entra ID', 'Sponsored guest', 'Cisco ISE' or 'Google Apps domain')}
    useVlanTagging: ${81:# Whether or not traffic should be directed to use specific VLANs}
    visible: ${82:# Boolean indicating whether APs should advertise or hide this SSID}
    vlanId: ${83:# The VLAN ID used for VLAN tagging}
    walledGardenEnabled: ${84:# Allow access to a configurable list of IP ranges, which users may access prior to sign-on}
    walledGardenRanges: ${85:# Specify your walled garden by entering an array of addresses, ranges using CIDR notation, domain names, and domain wildcards (e}
    wpaEncryptionMode: ${86:# The types of WPA encryption}
