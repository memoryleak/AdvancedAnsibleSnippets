    dot11r: ${14:# The current setting for 802}
    dot11w: ${15:# The current setting for Protected Management Frames (802}
    enabled: ${16:# Whether or not the SSID is enabled}
    encryptionMode: ${17:# The psk encryption mode for the SSID ('wep' or 'wpa')}
    enterpriseAdminAccess: ${18:# Whether or not an SSID is accessible by 'enterprise' administrators ('access disabled' or 'access enabled')}
    gre: ${19:# Ethernet over GRE settings}
    ipAssignmentMode: ${20:# The client IP assignment mode ('NAT mode', 'Bridge mode', 'Layer 3 roaming', 'Ethernet over GRE', 'Layer 3 roaming with a concentrator', 'VPN' or 'Campus Gateway')}
    lanIsolationEnabled: ${21:# Boolean indicating whether Layer 2 LAN isolation should be enabled or disabled}
    ldap: ${22:# The current setting for LDAP}
    localAuthFallback: ${23:# The current configuration for Local Authentication Fallback}
    localRadius: ${24:# The current setting for Local Authentication, a built-in RADIUS server on the access point}
    mandatoryDhcpEnabled: ${25:# If true, Mandatory DHCP will enforce that clients connecting to this SSID must use the IP address assigned by the DHCP server}
    meraki_action_batch_retry_wait_time: ${26:# meraki_action_batch_retry_wait_time (integer), action batch concurrency error retry wait time}
    meraki_api_key: ${27:# meraki_api_key (string), API key generated in dashboard; can also be set as an environment variable MERAKI_DASHBOARD_API_KEY}
    meraki_base_url: ${28:# meraki_base_url (string), preceding all endpoint resources}
    meraki_be_geo_id: ${29:# meraki_be_geo_id (string), optional partner identifier for API usage tracking; can also be set as an environment variable BE_GEO_ID}
    meraki_certificate_path: ${30:# meraki_certificate_path (string), path for TLS/SSL certificate verification if behind local proxy}
    meraki_inherit_logging_config: ${31:# meraki_inherit_logging_config (boolean), Inherits your own logger instance}
    meraki_log_file_prefix: ${32:# meraki_log_file_prefix (string), log file name appended with date and timestamp}
    meraki_log_path: ${33:# log_path (string), path to output log; by default, working directory of script if not specified}
    meraki_maximum_retries: ${34:# meraki_maximum_retries (integer), retry up to this many times when encountering 429s or other server-side errors}
    meraki_nginx_429_retry_wait_time: ${35:# meraki_nginx_429_retry_wait_time (integer), Nginx 429 retry wait time}
    meraki_output_log: ${36:# meraki_output_log (boolean), create an output log file?}
    meraki_print_console: ${37:# meraki_print_console (boolean), print logging output to console?}
    meraki_requests_proxy: ${38:# meraki_requests_proxy (string), proxy server and port, if needed, for HTTPS}
    meraki_retry_4xx_error: ${39:# meraki_retry_4xx_error (boolean), retry if encountering other 4XX error (besides 429)?}
    meraki_retry_4xx_error_wait_time: ${40:# meraki_retry_4xx_error_wait_time (integer), other 4XX error retry wait time}
    meraki_simulate: ${41:# meraki_simulate (boolean), simulate POST/PUT/DELETE calls to prevent changes?}
    meraki_single_request_timeout: ${42:# meraki_single_request_timeout (integer), maximum number of seconds for each API call}
    meraki_suppress_logging: ${43:# meraki_suppress_logging (boolean), disable all logging? you're on your own then!}
    meraki_use_iterator_for_get_pages: ${44:# meraki_use_iterator_for_get_pages (boolean), list* methods will return an iterator with each object instead of a complete list with all items}
    meraki_wait_on_rate_limit: ${45:# meraki_wait_on_rate_limit (boolean), retry if 429 rate limit error encountered?}
    minBitrate: ${46:# The minimum bitrate in Mbps of this SSID in the default indoor RF profile}
    name: ${47:# The name of the SSID}
    namedVlans: ${48:# Named VLAN settings}
    networkId: ${49:# NetworkId path parameter}
    number: ${50:# Number path parameter}
    oauth: ${51:# The OAuth settings of this SSID}
    perClientBandwidthLimitDown: ${52:# The download bandwidth limit in Kbps}
    perClientBandwidthLimitUp: ${53:# The upload bandwidth limit in Kbps}
    perSsidBandwidthLimitDown: ${54:# The total download bandwidth limit in Kbps}
    perSsidBandwidthLimitUp: ${55:# The total upload bandwidth limit in Kbps}
    psk: ${56:# The passkey for the SSID}
    radiusAccountingEnabled: ${57:# Whether or not RADIUS accounting is enabled}
    radiusAccountingInterimInterval: ${58:# The interval (in seconds) in which accounting information is updated and sent to the RADIUS accounting server}
    radiusAccountingServers: ${59:# The RADIUS accounting 802}
    radiusAccountingStartDelay: ${60:# The delay (in seconds) before sending the first RADIUS accounting start message}
    radiusAttributeForGroupPolicies: ${61:# Specify the RADIUS attribute used to look up group policies ('Filter-Id', 'Reply-Message', 'Airespace-ACL-Name' or 'Aruba-User-Role')}
    radiusAuthenticationNasId: ${62:# The template of the NAS identifier to be used for RADIUS authentication (ex}
    radiusCalledStationId: ${63:# The template of the called station identifier to be used for RADIUS (ex}
