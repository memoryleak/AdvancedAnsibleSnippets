    availableOnAllAps: ${8:# Boolean indicating whether all APs should broadcast the SSID or if it should be restricted to APs matching any availability tags}
    bandSelection: ${9:# The client-serving radio frequencies of this SSID in the default indoor RF profile}
    concentratorNetworkId: ${10:# The concentrator to use when the ipAssignmentMode is 'Layer 3 roaming with a concentrator' or 'VPN'}
    defaultVlanId: ${11:# The default VLAN ID used for 'all other APs'}
    disassociateClientsOnVpnFailover: ${12:# Disassociate clients when 'VPN' concentrator failover occurs in order to trigger clients to re-associate and generate new DHCP requests}
