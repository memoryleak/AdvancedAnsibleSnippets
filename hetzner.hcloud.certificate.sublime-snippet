<snippet>
  <content><![CDATA[- name: ${1:Create and manage certificates on the Hetzner Cloud}
  hetzner.hcloud.certificate:
    api_endpoint: ${2:# The endpoint for the Hetzner Cloud API}
    api_endpoint_hetzner: ${3:# The endpoint for the Hetzner API}
    api_token: ${4:# The token for the Hetzner Cloud API}
    certificate: ${5:# Certificate and chain in PEM format, in order so that each record directly certifies the one preceding}
    domain_names: ${6:# Domains and subdomains that should be contained in the Certificate issued by Let's Encrypt}
    id: ${7:# The ID of the Hetzner Cloud certificate to manage}
    labels: ${8:# User-defined labels (key-value pairs)}
    name: ${9:# The Name of the Hetzner Cloud certificate to manage}
    private_key: ${10:# Certificate key in PEM format}
    state: ${11:# State of the certificate}
    type: ${12:# Choose between uploading a Certificate in PEM format or requesting a managed Let's Encrypt Certificate}
  tags:
    - hetzner
    - hcloud
    - certificate]]></content>
  <tabTrigger>hetzner.hcloud.certificate</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Create and manage certificates on the Hetzner Cloud</description>
</snippet>