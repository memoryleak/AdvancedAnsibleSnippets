<snippet>
  <content><![CDATA[- name: ${1:Manage repository content exports}
  theforeman.foreman.content_export_repository:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    chunk_size_gb: ${3:# Split the exported content into archives no greater than the specified size in gigabytes}
    format: ${4:# Export format}
    from_history_id: ${5:# Export history identifier used for incremental export}
    incremental: ${6:# Export only the content that has changed since the last export}
    organization: ${7:# Organization that the entity is in}
    password: ${8:# Password of the user accessing the Foreman server}
    product: ${9:# Name of the product that the repository belongs to}
    repository: ${10:# Name of the repository to export}
    server_url: ${11:# URL of the Foreman server}
    use_gssapi: ${12:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${13:# Username accessing the Foreman server}
    validate_certs: ${14:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - content_export_repository]]></content>
  <tabTrigger>theforeman.foreman.content_export_repository</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage repository content exports</description>
</snippet>