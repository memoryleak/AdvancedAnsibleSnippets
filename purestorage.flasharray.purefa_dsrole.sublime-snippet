<snippet>
  <content><![CDATA[- name: ${1:Configure FlashArray Directory Service Roles}
  purestorage.flasharray.purefa_dsrole:
    api_token: ${2:# FlashArray API token for admin privileged user}
    context: ${3:# Name of fleet member on which to perform the operation}
    disable_warnings: ${4:# Disable insecure certificate warnings in debug logs}
    fa_url: ${5:# FlashArray management IPv4 address or Hostname}
    group: ${6:# Sets the common Name (CN) of the configured directory service group containing users for the FlashBlade}
    group_base: ${7:# Specifies where the configured group is located in the directory tree}
    name: ${8:# Name of role}
    role: ${9:# The directory service role to work on}
    state: ${10:# Create or delete directory service role}
  tags:
    - purestorage
    - flasharray
    - purefa_dsrole]]></content>
