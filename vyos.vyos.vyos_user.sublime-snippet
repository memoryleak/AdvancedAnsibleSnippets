<snippet>
  <content><![CDATA[- name: ${1:Manage the collection of local users on VyOS device}
  vyos.vyos.vyos_user:
    aggregate: ${2:# The set of username objects to be configured on the remote VyOS device}
    configured_password: ${3:# The password to be configured on the VyOS device}
    encrypted_password: ${4:# The encrypted password of the user account on the remote device}
    full_name: ${5:# The C(full_name) argument provides the full name of the user account to be created on the remote device}
    name: ${6:# The username to be configured on the VyOS device}
    public_keys: ${7:# Public keys for authentiction over SSH}
    purge: ${8:# Instructs the module to consider the resource definition absolute}
    state: ${9:# Configures the state of the username definition as it relates to the device operational configuration}
    update_password: ${10:# Since passwords are encrypted in the device running config, this argument will instruct the module when to change the password}
  tags:
    - vyos
    - vyos
    - vyos_user]]></content>
