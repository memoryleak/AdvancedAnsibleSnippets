<snippet>
  <content><![CDATA[- name: ${1:Return a list of files based on specific criteria}
  ansible.windows.win_find:
    age: ${2:# Select files or folders whose age is equal to or greater than the specified time}
    age_stamp: ${3:# Choose the file property against which we compare C(age)}
    case_sensitive: ${4:# Make case-sensitive string comparisons for the filename match}
    checksum_algorithm: ${5:# Algorithm to determine the checksum of a file}
    depth: ${6:# Set the maximum number of levels to descend into}
    file_type: ${7:# Type of file to search for}
    follow: ${8:# Set this to C(true) to follow symlinks in the path}
    get_checksum: ${9:# Whether to return a checksum of the file in the return info (default sha1), use C(checksum_algorithm) to change from the default}
    hidden: ${10:# Set this to include hidden files or folders}
    paths: ${11:# List of paths of directories to search for files or folders in}
    patterns: ${12:# One or more (powershell or regex) patterns to compare filenames with}
    recurse: ${13:# Will recursively descend into the directory looking for files or folders}
    size: ${14:# Select files or folders whose size is equal to or greater than the specified size}
    use_regex: ${15:# Will set patterns to run as a regex check if set to C(true)}
  tags:
    - win_find]]></content>
  <tabTrigger>ansible.windows.win_find</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Return a list of files based on specific criteria</description>
</snippet>