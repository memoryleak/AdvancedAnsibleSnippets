<snippet>
  <content><![CDATA[- name: ${1:Manage PTP Policy Profiles on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_ptp_policy_profiles:
    announce_interval: ${2:# Announce interval of the PTP Policy profile}
    announce_timeout: ${3:# Announce timeout of the PTP Policy profile}
    delay_interval: ${4:# Delay interval of the PTP Policy profile}
    host: ${5:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    login_domain: ${6:# The login domain name to use for authentication}
    output_level: ${7:# Influence the output of this MSO module}
    override_node_profile: ${8:# Node profile override of the PTP Policy profile}
    password: ${9:# The password to use for authentication}
    port: ${10:# Port number to be used for the REST connection}
    profile_template: ${11:# Profile template of the PTP Policy profile}
    ptp_policy_profile_name: ${12:# The name of the PTP Policy profile}
    ptp_policy_profile_uuid: ${13:# The UUID of the PTP Policy profile}
    state: ${14:# Use C(absent) for removing}
    sync_interval: ${15:# Sync interval of the PTP Policy profile}
    template: ${16:# The name of the template}
    timeout: ${17:# The socket level timeout in seconds}
    use_proxy: ${18:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${19:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${20:# The username to use for authentication}
    validate_certs: ${21:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_ptp_policy_profiles]]></content>
