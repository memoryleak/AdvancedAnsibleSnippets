<snippet>
  <content><![CDATA[- name: ${1:Encrypt data with SOPS}
  community.sops.sops_encrypt:
    age: ${2:# Age fingerprints to use}
    age_key: ${3:# One or more age private keys that can be used to decrypt encrypted files}
    age_keyfile: ${4:# The file containing the age private keys that SOPS can use to decrypt encrypted files}
    age_ssh_private_keyfile: ${5:# The file containing the SSH private key that SOPS can use to decrypt encrypted files}
    attributes: ${6:# The attributes the resulting filesystem object should have}
    aws_access_key_id: ${7:# The AWS access key ID to use for requests to AWS}
    aws_profile: ${8:# The AWS profile to use for requests to AWS}
    aws_secret_access_key: ${9:# The AWS secret access key to use for requests to AWS}
    aws_session_token: ${10:# The AWS session token to use for requests to AWS}
    azure_kv: ${11:# Azure Key Vault URLs to use}
    config_path: ${12:# Path to the SOPS configuration file}
    content_binary: ${13:# The data to encrypt}
    content_json: ${14:# The data to encrypt}
    content_text: ${15:# The data to encrypt}
    content_yaml: ${16:# The data to encrypt}
    enable_local_keyservice: ${17:# Tell SOPS to use local key service}
    encrypted_regex: ${18:# Set the encrypted key suffix}
    encrypted_suffix: ${19:# Override the encrypted key suffix}
    encryption_context: ${20:# List of KMS encryption context pairs of format C(key:value)}
    force: ${21:# Force rewriting the encrypted file}
    gcp_kms: ${22:# GCP KMS resource IDs to use}
    group: ${23:# Name of the group that should own the filesystem object, as would be fed to C(chown)}
    hc_vault_transit: ${24:# HashiCorp Vault key URIs to use}
    keyservice: ${25:# Specify key services to use next to the local one}
    kms: ${26:# List of KMS ARNs to use}
    mode: ${27:# The permissions the resulting filesystem object should have}
    owner: ${28:# Name of the user that should own the filesystem object, as would be fed to C(chown)}
    path: ${29:# The SOPS encrypt file}
    pgp: ${30:# PGP fingerprints to use}
    selevel: ${31:# The level part of the SELinux filesystem object context}
    serole: ${32:# The role part of the SELinux filesystem object context}
    setype: ${33:# The type part of the SELinux filesystem object context}
    seuser: ${34:# The user part of the SELinux filesystem object context}
    shamir_secret_sharing_threshold: ${35:# The number of distinct keys required to retrieve the data key with L(Shamir's Secret Sharing, https://en}
    sops_binary: ${36:# Path to the SOPS binary}
    unencrypted_regex: ${37:# Set the unencrypted key suffix}
    unencrypted_suffix: ${38:# Override the unencrypted key suffix}
    unsafe_writes: ${39:# Influence when to use atomic operation to prevent data corruption or inconsistent reads from the target filesystem object}
  tags:
    - community
    - sops
    - sops_encrypt]]></content>
  <tabTrigger>community.sops.sops_encrypt</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Encrypt data with SOPS</description>
</snippet>