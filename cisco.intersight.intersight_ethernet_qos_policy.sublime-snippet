<snippet>
  <content><![CDATA[- name: ${1:Ethernet QoS Policy configuration for Cisco Intersight}
  cisco.intersight.intersight_ethernet_qos_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    burst: ${5:# The burst traffic, in bytes, allowed on the vNIC}
    cos: ${6:# Class of Service to be associated to the traffic on the virtual interface}
    description: ${7:# The user-defined description for the Ethernet QoS Policy}
    mtu: ${8:# The Maximum Transmission Unit (MTU) or packet size that the virtual interface accepts}
    name: ${9:# The name assigned to the Ethernet QoS Policy}
    organization: ${10:# The name of the Organization this resource is assigned to}
    priority: ${11:# The priority matching the System QoS specified in the fabric profile}
    rate_limit: ${12:# The value in Mbps (0-10G/40G/100G depending on Adapter Model) to use for limiting the data rate on the virtual interface}
    state: ${13:# If C(present), will verify the resource is present and will create if needed}
    tags: ${14:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    trust_host_cos: ${15:# Enables usage of the Class of Service provided by the operating system}
    use_proxy: ${16:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${17:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_ethernet_qos_policy]]></content>
  <tabTrigger>cisco.intersight.intersight_ethernet_qos_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Ethernet QoS Policy configuration for Cisco Intersight</description>
</snippet>