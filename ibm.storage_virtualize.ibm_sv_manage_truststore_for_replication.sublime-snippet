<snippet>
  <content><![CDATA[- name: ${1:This module manages certificate trust stores for replication on IBM Storage Virtualize family systems}
  ibm.storage_virtualize.ibm_sv_manage_truststore_for_replication:
    clustername: ${2:# The hostname or management IP of the Storage Virtualize system}
    domain: ${3:# Domain for the Storage Virtualize storage system}
    email: ${4:# Specifies the certificates in the store are used to validate the email server}
    grid: ${5:# Specifies the certificates in the store are used for the flashsystem grid}
    ipsec: ${6:# Specifies the certificates in the store are used for the IPsec service}
    key_filename: ${7:# SSH client private key filename}
    log_path: ${8:# Path of debug log file}
    name: ${9:# Specifies the name of the trust store}
    password: ${10:# Password for the Storage Virtualize system}
    remote_clustername: ${11:# Specifies the name of the partner remote cluster with which mTLS partnership needs to be setup}
    remote_domain: ${12:# Domain for the Storage Virtualize storage system}
    remote_password: ${13:# Password for remote cluster}
    remote_username: ${14:# Username for remote cluster}
    restapi: ${15:# Specifies the certificates in the store are used for the REST API}
    snmp: ${16:# Specifies the certificates in the store are used to validate the SNMP servers}
    state: ${17:# Creates (C(present)) or deletes (C(absent)) a trust store}
    syslog: ${18:# Specifies the certificates to be bundled and provided to rsyslog client for making TLS connections}
    username: ${19:# Username for the Storage Virtualize system}
    usesshkey: ${20:# For key-pair based SSH connection, set this field as 'yes'}
    vasa: ${21:# Specifies the certificates in the store are used for the VASA Provider}
  tags:
    - ibm
    - storage_virtualize
    - ibm_sv_manage_truststore_for_replication]]></content>
