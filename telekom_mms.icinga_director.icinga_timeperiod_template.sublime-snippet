<snippet>
  <content><![CDATA[- name: ${1:Manage timeperiod templates in Icinga2}
  telekom_mms.icinga_director.icinga_timeperiod_template:
    api_timeout: ${2:# Default timeout to wait for transaction to finish in seconds}
    append: ${3:# Do not overwrite the whole object but instead append the defined properties}
    client_cert: ${4:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${5:# PEM formatted file that contains your private key to be used for SSL client authentication}
    disabled: ${6:# Disabled objects will not be deployed}
    display_name: ${7:# Alternative name for this timeperiod template}
    excludes: ${8:# Exclude other time periods from this}
    force: ${9:# If V(yes) do not get a cached copy}
    force_basic_auth: ${10:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    http_agent: ${11:# Header to identify as, generally appears in web server logs}
    imports: ${12:# Importable templates, add as many as you want}
    includes: ${13:# Include other time periods into this}
    object_name: ${14:# Name of the time period}
    prefer_includes: ${15:# Whether to prefer timeperiods includes or excludes}
    ranges: ${16:# A dict of days and timeperiods}
    state: ${17:# Apply feature state}
    update_method: ${18:# Define the update method}
    url: ${19:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${20:# The password for use in HTTP basic authentication}
    url_username: ${21:# The username for use in HTTP basic authentication}
    use_gssapi: ${22:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${23:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${24:# If V(no), SSL certificates will not be validated}
    zone: ${25:# Set the zone}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_timeperiod_template]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_timeperiod_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage timeperiod templates in Icinga2</description>
</snippet>