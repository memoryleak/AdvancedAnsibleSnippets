  <content><![CDATA[- name: ${1:Resource module for Connection Mode Setting}
  cisco.dnac.connection_mode_setting:
    connectionMode: ${2:# The CSSM connection modes of Catalyst Center are DIRECT, ON_PREMISE and SMART_PROXY}
    dnac_debug: ${3:# Flag for Cisco DNA Center SDK to enable debugging}
    dnac_host: ${4:# The Cisco DNA Center hostname}
    dnac_password: ${5:# The Cisco DNA Center password to authenticate}
    dnac_port: ${6:# The Cisco DNA Center port}
    dnac_username: ${7:# The Cisco DNA Center username to authenticate}
    dnac_verify: ${8:# Flag to enable or disable SSL certificate verification}
    dnac_version: ${9:# Informs the SDK which version of Cisco DNA Center to use}
    parameters: ${10:# Connection Mode Setting's parameters}
    validate_response_schema: ${11:# Flag for Cisco DNA Center SDK to enable the validation of request bodies against a JSON schema}
  tags:
    - cisco
    - dnac
    - connection_mode_setting]]></content>
