<snippet>
  <content><![CDATA[- name: ${1:Create, modify or delete FlashBlade user accounts}
  purestorage.flashblade.purefb_user:
    ad_user: ${2:# Whether the user is in the AD system}
    api: ${3:# Define whether to create an API token for this user}
    api_token: ${4:# FlashBlade API token for admin privileged user}
    clear_lock: ${5:# Clear user lockout flag}
    disable_warnings: ${6:# Disable insecure certificate warnings}
    fb_url: ${7:# FlashBlade management IP address or Hostname}
    name: ${8:# The name of the user account}
    old_password: ${9:# If changing an existing password, you must provide the old password for security}
    password: ${10:# Password for the local user}
    public_key: ${11:# The API clients PEM formatted (Base64 encoded) RSA public key}
    role: ${12:# Sets the local user's access level to the system}
    state: ${13:# Create, delete or update local user account}
    timeout: ${14:# The duration of API token validity}
  tags:
    - purestorage
    - flashblade
    - purefb_user]]></content>
  <tabTrigger>purestorage.flashblade.purefb_user</tabTrigger>
