<snippet>
  <content><![CDATA[- name: ${1:Deploy a virtual machine from a template in a content library}
  vmware.vmware.deploy_content_library_template:
    cluster: ${2:# The name or MOID of the cluster where the VM should be deployed}
    datacenter: ${3:# The name or MOID of the datacenter to use when searching for and deploying resources}
    datastore: ${4:# Name or MOID of the datastore to store deployed VM and disk}
    datastore_cluster: ${5:# Name or MOID of the datastore cluster to store deployed VM and disk}
    esxi_host: ${6:# The name of the ESXi host onto which the virtual machine should be deployed}
    folder_paths_are_absolute: ${7:# If true, any folder path parameters are treated as absolute paths}
    hostname: ${8:# The hostname or IP address of the vSphere vCenter server}
    library_id: ${9:# The ID of the content library where the template exists}
    library_item_id: ${10:# The ID of content library template to use when deploying the VM}
    library_item_name: ${11:# The name of content library template to use when deploying the VM}
    library_name: ${12:# The name of the content library where the template exists}
    password: ${13:# The password of the vSphere vCenter server}
    port: ${14:# The port number of the vSphere vCenter server}
    power_on_after_deploy: ${15:# Whether or not the VM should be powered on once it has been deployed}
    proxy_host: ${16:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${17:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    proxy_protocol: ${18:# The proxy connection protocol to use}
    resource_pool: ${19:# The name or MOID of a resource pool into which the virtual machine should be deployed}
    username: ${20:# The username of the vSphere vCenter server}
    validate_certs: ${21:# Allows connection when SSL certificates are not valid}
    vm_folder: ${22:# Virtual machine folder into which the virtual machine should be deployed}
    vm_name: ${23:# The name of the VM to deploy}
  tags:
    - vmware
    - vmware
    - deploy_content_library_template]]></content>
  <tabTrigger>vmware.vmware.deploy_content_library_template</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Deploy a virtual machine from a template in a content library</description>
</snippet>