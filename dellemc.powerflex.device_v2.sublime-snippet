<snippet>
  <content><![CDATA[- name: ${1:Manage Device on Dell PowerFlex}
  dellemc.powerflex.device_v2:
    capacity_limit_gb: ${2:# Device capacity limit in GB}
    clear_error: ${3:# Using the flag to clear error on a device}
    current_pathname: ${4:# Full path of the device to be added}
    device_group_id: ${5:# The ID of the device group}
    device_group_name: ${6:# The name of the device group}
    device_id: ${7:# Device ID}
    device_name: ${8:# Device name}
    force: ${9:# Using the Force flag to add a device}
    hostname: ${10:# IP or FQDN of the PowerFlex host}
    media_type: ${11:# Device media types}
    new_device_name: ${12:# New name of the device}
    password: ${13:# The password of the PowerFlex host}
    port: ${14:# Port number through which communication happens with PowerFlex host}
    state: ${15:# State of the device}
    storage_node_id: ${16:# The ID of the storage node}
    storage_node_name: ${17:# The name of the storage node}
    timeout: ${18:# Time after which connection will get terminated}
    username: ${19:# The username of the PowerFlex host}
    validate_certs: ${20:# Boolean variable to specify whether or not to validate SSL certificate}
  tags:
    - dellemc
    - powerflex
    - device_v2]]></content>
  <tabTrigger>dellemc.powerflex.device_v2</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Device on Dell PowerFlex</description>
</snippet>