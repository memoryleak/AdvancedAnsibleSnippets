<snippet>
  <content><![CDATA[- name: ${1:Manage Bridge Domains (BDs) in schema templates}
  cisco.mso.mso_schema_template_bd:
    arp_flooding: ${2:# ARP Flooding}
    bd: ${3:# The name of the BD to manage}
    description: ${4:# The description of BD is supported on versions of MSO that are 3}
    dhcp_policies: ${5:# A list DHCP Policies to be assciated with the BD}
    dhcp_policy: ${6:# The DHCP Policy}
    display_name: ${7:# The name as displayed on the MSO web interface}
    ep_move_detection_mode: ${8:# Enables detection of endpoint moves using Gratuitous ARP (GARP) packets}
    host: ${9:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    intersite_bum_traffic: ${10:# Whether to allow intersite BUM traffic}
    ipv6_unknown_multicast_flooding: ${11:# IPv6 Unknown Multicast Flooding can either be Flood or Optimized Flooding}
    layer2_stretch: ${12:# Whether to enable L2 stretch}
    layer2_unknown_unicast: ${13:# Layer2 unknown unicast}
    layer3_multicast: ${14:# Whether to enable L3 multicast}
    login_domain: ${15:# The login domain name to use for authentication}
    multi_destination_flooding: ${16:# Multi-Destination Flooding can either be Flood in BD, Drop or Flood in Encapsulation}
    multicast_route_map_destination_filter: ${17:# The name of the Route Map Destination Filter}
    multicast_route_map_source_filter: ${18:# The name of the Route Map Source Filter}
    optimize_wan_bandwidth: ${19:# Whether to optimize WAN bandwidth}
    output_level: ${20:# Influence the output of this MSO module}
    password: ${21:# The password to use for authentication}
    port: ${22:# Port number to be used for the REST connection}
    schema: ${23:# The name of the schema}
    state: ${24:# Use C(present) or C(absent) for adding or removing}
    subnets: ${25:# The subnets associated to this BD}
    template: ${26:# The name of the template}
    timeout: ${27:# The socket level timeout in seconds}
    unicast_routing: ${28:# Unicast Routing}
    unknown_multicast_flooding: ${29:# Unknown Multicast Flooding can either be Flood or Optimized Flooding}
    use_proxy: ${30:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${31:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${32:# The username to use for authentication}
    validate_certs: ${33:# If C(false), SSL certificates will not be validated}
    virtual_mac_address: ${34:# Virtual MAC Address}
    vrf: ${35:# The VRF associated to this BD}
  tags:
    - cisco
    - mso
    - mso_schema_template_bd]]></content>
  <tabTrigger>cisco.mso.mso_schema_template_bd</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Bridge Domains (BDs) in schema templates</description>
</snippet>