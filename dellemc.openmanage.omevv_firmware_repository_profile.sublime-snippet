<snippet>
  <content><![CDATA[- name: ${1:Create, modify, or delete OMEVV firmware repository profile}
  dellemc.openmanage.omevv_firmware_repository_profile:
    ca_path: ${2:# The Privacy Enhanced Mail (PEM) file that contains a CA certificate to be used for the validation}
    catalog_path: ${3:# Absolute path of the catalog}
    description: ${4:# Description of OMEVV firmware repository profile}
    hostname: ${5:# IP address or hostname of the OpenManage Enterprise Modular}
    name: ${6:# Name of the OMEVV firmware repository profile}
    new_name: ${7:# Name of the new OMEVV profile name when modify operation is performed}
    password: ${8:# OpenManage Enterprise or OpenManage Enterprise Modular password}
    port: ${9:# OpenManage Enterprise HTTPS port}
    protocol_type: ${10:# C(NFS) represents the NFS share path}
    resync: ${11:# Sync the repository profile from the UMP plugin}
    share_domain: ${12:# Domain of the share}
    share_password: ${13:# Password of the share}
    share_username: ${14:# Username of the share}
    state: ${15:# C(present) creates an OMEVV firmware repository profile or modifies an existing profile if the profile with the same name exists}
    timeout: ${16:# The socket level timeout in seconds}
    username: ${17:# OpenManage Enterprise or OpenManage Enterprise Modular username}
    validate_certs: ${18:# Whether to check SSL certificate}
    vcenter_password: ${19:# Password for OpenManage Enterprise Integration for VMware vCenter (OMEVV)}
    vcenter_username: ${20:# Username for OpenManage Enterprise Integration for VMware vCenter (OMEVV)}
    vcenter_uuid: ${21:# Universally Unique Identifier (UUID) of vCenter}
  tags:
    - dellemc
    - openmanage
    - omevv_firmware_repository_profile]]></content>
  <tabTrigger>dellemc.openmanage.omevv_firmware_repository_profile</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
