<snippet>
  <content><![CDATA[- name: ${1:Manage Fabric SPAN Sessions on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_fabric_span_session:
    admin_state: ${2:# The administrative state of the SPAN Session}
    description: ${3:# The description of the SPAN Session}
    destination_epg: ${4:# The destination EPG configuration group}
    destination_port: ${5:# The destination port configuration group}
    destination_port_channel: ${6:# The destination port channel configuration group}
    host: ${7:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    login_domain: ${8:# The login domain name to use for authentication}
    mtu: ${9:# The MTU truncation size for the SPAN packets}
    name: ${10:# The name of the SPAN Session}
    output_level: ${11:# Influence the output of this MSO module}
    password: ${12:# The password to use for authentication}
    port: ${13:# Port number to be used for the REST connection}
    state: ${14:# Use C(absent) for removing}
