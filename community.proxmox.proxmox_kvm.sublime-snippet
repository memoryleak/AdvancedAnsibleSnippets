<snippet>
  <content><![CDATA[- name: ${1:Management of Qemu(KVM) Virtual Machines in Proxmox VE cluster}
  community.proxmox.proxmox_kvm:
    acpi: ${2:# Specify if ACPI should be enabled/disabled}
    agent: ${3:# Specify if the QEMU Guest Agent should be enabled/disabled}
    api_host: ${4:# Specify the target host of the Proxmox VE cluster}
    api_password: ${5:# Specify the password to authenticate with}
    api_port: ${6:# Specify the target port of the Proxmox VE cluster}
    api_token_id: ${7:# Specify the token ID}
    api_token_secret: ${8:# Specify the token secret}
    api_user: ${9:# Specify the user to authenticate with}
    archive: ${10:# Specify a path to an archive to restore (instead of creating or cloning a VM)}
    args: ${11:# Pass arbitrary arguments to kvm}
    audio: ${12:# A hash/dictionary of audio devices for the VM}
    autostart: ${13:# Specify if the VM should be automatically restarted after crash (currently ignored in PVE API)}
    balloon: ${14:# Specify the amount of RAM for the VM in MB}
    bios: ${15:# Specify the BIOS implementation}
    boot: ${16:# Specify the boot order -> boot on floppy V(a), hard disk V(c), CD-ROM V(d), or network V(n)}
    bootdisk: ${17:# Enable booting from specified disk}
    cicustom: ${18:# Cloud-init: Specify custom files to replace the automatically generated ones at start}
    cipassword: ${19:# Cloud-init: password of default user to create}
    citype: ${20:# Cloud-init: Specifies the cloud-init configuration format}
    ciupgrade: ${21:# Cloud-init: do an automatic package upgrade after the first boot}
    ciuser: ${22:# Cloud-init: username of default user to create}
    clone: ${23:# Name of VM to be cloned}
    cores: ${24:# Specify number of cores per socket}
    cpu: ${25:# Specify emulated CPU type}
    cpulimit: ${26:# Specify if CPU usage will be limited}
    cpuunits: ${27:# Specify CPU weight for a VM}
    delete: ${28:# Specify a list of settings you want to delete}
    description: ${29:# Specify the description for the VM}
    digest: ${30:# Specify if to prevent changes if current configuration file has different SHA1 digest}
    efidisk0: ${31:# Specify a hash/dictionary of EFI disk options}
    force: ${32:# Allow to force stop VM}
    format: ${33:# Target drive's backing file's data format}
    freeze: ${34:# Specify if PVE should freeze CPU at startup (use 'c' monitor command to start execution)}
    full: ${35:# Create a full copy of all disk}
    hookscript: ${36:# Script that will be executed during various steps in the containers lifetime}
    hostpci: ${37:# Specify a hash/dictionary of map host pci devices into guest}
    hotplug: ${38:# Selectively enable hotplug features}
    hugepages: ${39:# Enable/disable hugepages memory}
    ide: ${40:# A hash/dictionary of volume used as IDE hard disk or CD-ROM}
    ipconfig: ${41:# Cloud-init: Set the IP configuration}
    keyboard: ${42:# Sets the keyboard layout for VNC server}
    kvm: ${43:# Enable/disable KVM hardware virtualization}
    localtime: ${44:# Sets the real time clock to local time}
    lock: ${45:# Lock/unlock the VM}
    machine: ${46:# Specifies the Qemu machine type}
    memory: ${47:# Memory size in MB for instance}
    migrate: ${48:# Migrate the VM to O(node) if it is on another node}
    migrate_downtime: ${49:# Sets maximum tolerated downtime (in seconds) for migrations}
    migrate_speed: ${50:# Sets maximum speed (in MB/s) for migrations}
    name: ${51:# Specifies the VM name}
    nameservers: ${52:# Cloud-init: DNS server IP address(es)}
    net: ${53:# A hash/dictionary of network interfaces for the VM}
    newid: ${54:# VMID for the clone}
    node: ${55:# Proxmox VE node on which to operate}
    numa: ${56:# A hash/dictionaries of NUMA topology}
    numa_enabled: ${57:# Enables NUMA}
    onboot: ${58:# Specifies whether a VM will be started during system bootup}
    ostype: ${59:# Specifies guest operating system}
    parallel: ${60:# A hash/dictionary of map host parallel devices}
    pool: ${61:# Add the new VM to the specified pool}
    protection: ${62:# Enable/disable the protection flag of the VM}
    purge: ${63:# Remove VMID from configurations, like backup & replication jobs and HA}
    reboot: ${64:# Allow reboot}
    revert: ${65:# Revert a pending change}
    rng0: ${66:# Randomness source for RNG device, for example V(/dev/urandom)}
    sata: ${67:# A hash/dictionary of volume used as sata hard disk or CD-ROM}
    scsi: ${68:# A hash/dictionary of volume used as SCSI hard disk or CD-ROM}
    scsihw: ${69:# Specifies the SCSI controller model}
    searchdomains: ${70:# Cloud-init: Sets DNS search domain(s)}
    serial: ${71:# A hash/dictionary of serial device to create inside the VM}
    shares: ${72:# Rets amount of memory shares for auto-ballooning}
    skiplock: ${73:# Ignore locks}
    smbios: ${74:# Specifies SMBIOS type 1 fields}
    snapname: ${75:# The name of the snapshot}
    sockets: ${76:# Sets the number of CPU sockets}
    sshkeys: ${77:# Cloud-init: SSH key to assign to the default user}
    startdate: ${78:# Sets the initial date of the real time clock}
    startup: ${79:# Startup and shutdown behavior}
    state: ${80:# Indicates desired state of the instance}
    storage: ${81:# Target storage for full clone}
    tablet: ${82:# Enables/disables the USB tablet device}
    tags: ${83:# List of tags to apply to the VM instance}
    target: ${84:# Target node}
    tdf: ${85:# Enables/disables time drift fix}
    template: ${86:# Enables/disables the template}
    timeout: ${87:# Timeout for operations}
    tpmstate0: ${88:# A hash/dictionary of options for the Trusted Platform Module disk}
    update: ${89:# If V(true), the VM will be updated with new value}
    update_unsafe: ${90:# If V(true), do not enforce limitations on parameters O(net), O(virtio), O(ide), O(sata), O(scsi), O(efidisk0), and O(tpmstate0)}
    usb: ${91:# A hash/dictionary of USB devices for the VM}
    validate_certs: ${92:# If V(false), SSL certificates will not be validated}
    vcpus: ${93:# Sets number of hotplugged vcpus}
    vga: ${94:# Select VGA type}
    virtio: ${95:# A hash/dictionary of volume used as VIRTIO hard disk}
    vmid: ${96:# Specifies the instance ID}
    watchdog: ${97:# Creates a virtual hardware watchdog device}
    with_local_disks: ${98:# Enables migration of local disks to the next node}
  tags:
    - community
    - proxmox
    - proxmox_kvm]]></content>
  <tabTrigger>community.proxmox.proxmox_kvm</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Management of Qemu(KVM) Virtual Machines in Proxmox VE cluster</description>
