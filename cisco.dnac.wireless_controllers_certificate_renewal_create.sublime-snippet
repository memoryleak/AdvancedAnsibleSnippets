<snippet>
  <content><![CDATA[- name: ${1:Resource module for Wireless Controllers Certificate Renewal Create}
  cisco.dnac.wireless_controllers_certificate_renewal_create:
    accessPointMacs: ${2:# MAC address of access points on which certificate renewal has to be performed}
    deviceId: ${3:# DeviceId path parameter}
    dnac_debug: ${4:# Flag for Cisco DNA Center SDK to enable debugging}
    dnac_host: ${5:# The Cisco DNA Center hostname}
    dnac_password: ${6:# The Cisco DNA Center password to authenticate}
    dnac_port: ${7:# The Cisco DNA Center port}
    dnac_username: ${8:# The Cisco DNA Center username to authenticate}
    dnac_verify: ${9:# Flag to enable or disable SSL certificate verification}
    dnac_version: ${10:# Informs the SDK which version of Cisco DNA Center to use}
    expiryTime: ${11:# Expiry time with in which access points certificates are set to expire}
    siteTagIds: ${12:# Site tag IDs on which LSC instantaneous certificate renewal has to be performed}
    validate_response_schema: ${13:# Flag for Cisco DNA Center SDK to enable the validation of request bodies against a JSON schema}
  tags:
    - cisco
    - dnac
    - wireless_controllers_certificate_renewal_create]]></content>
