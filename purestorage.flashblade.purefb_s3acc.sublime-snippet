<snippet>
  <content><![CDATA[- name: ${1:Create or delete FlashBlade Object Store accounts}
  purestorage.flashblade.purefb_s3acc:
    api_token: ${2:# FlashBlade API token for admin privileged user}
    block_new_public_policies: ${3:# If set to true, adding bucket policies that grant public access to a bucket is not allowed}
    block_public_access: ${4:# If set to true, access to a bucket with a public policy is restricted to only authenticated users within the account that bucket belongs to}
    context: ${5:# Name of fleet member on which to perform the operation}
    default_hard_limit: ${6:# The value of this field will be used to configure the I(hard_limit) field of newly created buckets associated with this object store account, if the bucket creation does not specify its own value}
    default_quota: ${7:# The value of this field will be used to configure the I(quota_limit) field of newly created buckets associated with this object store account, if the bucket creation does not specify its own value}
    disable_warnings: ${8:# Disable insecure certificate warnings}
    fb_url: ${9:# FlashBlade management IP address or Hostname}
    hard_limit: ${10:# If set to true, the account size, as defined by I(quota_limit), is used as a hard limit quota}
    name: ${11:# The name of object store account}
    quota: ${12:# The effective quota limit to be applied against the size of the account in bytes}
    state: ${13:# Create or delete object store account}
  tags:
    - purestorage
    - flashblade
    - purefb_s3acc]]></content>
  <tabTrigger>purestorage.flashblade.purefb_s3acc</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Create or delete FlashBlade Object Store accounts</description>
</snippet>