<snippet>
  <content><![CDATA[- name: ${1:This module manages FlashCopy mappings on IBM Storage Virtualize family systems}
  ibm.storage_virtualize.ibm_svc_manage_flashcopy:
    cleanrate: ${2:# Specifies the clean rate}
    clustername: ${3:# The hostname or management IP of the Storage Virtualize system}
    consistgrp: ${4:# Specifies the name of the consistency group to which the FlashCopy mapping is to be added}
    copyrate: ${5:# Specifies the copy rate}
    copytype: ${6:# Specifies the copy type when creating the FlashCopy mapping}
    domain: ${7:# Domain for the Storage Virtualize system}
    force: ${8:# Brings the target volume online}
    grainsize: ${9:# Specifies the grain size for the FlashCopy mapping}
    log_path: ${10:# Path of debug log file}
    mdiskgrp: ${11:# Specifies the name of the storage pool to use when creating the target volume}
    name: ${12:# Specifies the name of the FlashCopy mapping}
    noconsistgrp: ${13:# If specified True, FlashCopy mapping is removed from the consistency group}
    old_name: ${14:# Specifies the old name of an mdiskgrp}
    password: ${15:# REST API password for the Storage Virtualize system}
    source: ${16:# Specifies the name of the source volume}
    state: ${17:# Creates or updates (C(present)) or removes (C(absent)) a FlashCopy mapping}
    target: ${18:# Specifies the name of the target volume}
    token: ${19:# The authentication token to verify a user on the Storage Virtualize system}
    username: ${20:# REST API username for the Storage Virtualize system}
    validate_certs: ${21:# Validates certification}
  tags:
    - ibm
    - storage_virtualize
    - ibm_svc_manage_flashcopy]]></content>
