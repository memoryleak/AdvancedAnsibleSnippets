<snippet>
  <content><![CDATA[- name: ${1:NetApp ONTAP ASA r2 storage unit}
  netapp.ontap.na_ontap_storage_unit:
    cert_filepath: ${2:# path to SSL client cert file (}
    clone: ${3:# Identifiers of the parent storage unit or storage unit snapshot from which to clone a new storage unit}
    feature_flags: ${4:# Enable or disable a new feature}
    force_ontap_version: ${5:# Override the cluster ONTAP version when using REST}
    hostname: ${6:# The hostname or IP address of the ONTAP instance}
    http_port: ${7:# Override the default port (80 or 443) with this port}
    https: ${8:# Enable and disable https}
    key_filepath: ${9:# path to SSL client key file}
    name: ${10:# Specifies the name of the storage unit (LUN or NVMe namespace)}
    password: ${11:# Password for the specified user}
    restore_to: ${12:# Specifies the name of the snapshot to restore the storage unit to the point in time the snapshot was taken}
    restore_to_snapshot: ${13:# Specifies the name of the snapshot to restore the storage unit to the point in time the snapshot was taken}
    split_initiated: ${14:# Setting this field initiates a split of a FlexClone storage unit from a FlexVol storage unit}
    state: ${15:# Manage storage unit operations, only present is supported}
    target_location: ${16:# Specifies the name of the destination storage availability zone for moving the storage unit}
    time_out: ${17:# With C(wait_for_completion) set, specifies time to wait for any storage unit clone, split, restore or move operations in seconds}
    use_rest: ${18:# This module only supports REST}
    username: ${19:# This can be a Cluster-scoped or SVM-scoped account, depending on whether a Cluster-level or SVM-level API is required}
    validate_certs: ${20:# If set to C(no), the SSL certificates will not be validated}
    vserver: ${21:# Specifies the SVM in which the storage unit is located}
    wait_for_completion: ${22:# Set this parameter to 'true' for synchronous execution}
  tags:
    - netapp
    - ontap
    - na_ontap_storage_unit]]></content>
