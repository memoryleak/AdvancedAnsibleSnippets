<snippet>
  <content><![CDATA[- name: ${1:Send key presses to a Proxmox VM console}
  community.proxmox.proxmox_sendkey:
    api_host: ${2:# Specify the target host of the Proxmox VE cluster}
    api_password: ${3:# Specify the password to authenticate with}
    api_port: ${4:# Specify the target port of the Proxmox VE cluster}
    api_token_id: ${5:# Specify the token ID}
    api_token_secret: ${6:# Specify the token secret}
    api_user: ${7:# Specify the user to authenticate with}
    delay: ${8:# Delay in seconds between each key press}
    keys_send: ${9:# List of keys or key sequence to send in order}
    name: ${10:# The unique name of the VM}
    string_send: ${11:# Raw string that will be transformed to the corresponding key presses}
    validate_certs: ${12:# If V(false), SSL certificates will not be validated}
    vmid: ${13:# The unique ID of the VM}
  tags:
    - community
    - proxmox
    - proxmox_sendkey]]></content>
  <tabTrigger>community.proxmox.proxmox_sendkey</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Send key presses to a Proxmox VM console</description>
</snippet>