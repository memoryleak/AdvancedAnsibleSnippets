<snippet>
  <content><![CDATA[- name: ${1:Manages hostgroup attributes using the ProxySQL admin interface}
  community.proxysql.proxysql_mysql_hostgroup_attributes:
    autocommit: ${2:# Not yet implemented (as per ProxySQL documentation)}
    comment: ${3:# Text field that can be used for any purposes defined by the user}
    config_file: ${4:# Specify a config file from which I(login_user) and I(login_password) are to be read}
    connection_warming: ${5:# Whether ProxySQL will opening new connections until the expected number of warm connections is reached}
    free_connections_pct: ${6:# The percentage of open idle connections for each server in a hostgroup}
    hostgroup_id: ${7:# ID of the hostgroup}
    hostgroup_settings: ${8:# Override certain global configurations}
    ignore_session_variables: ${9:# Not yet implemented (as per ProxySQL documentation)}
    init_connect: ${10:# Semicolon-delimited string of SQL statements to be executed for each back-end connection when initialized}
    load_to_runtime: ${11:# Dynamically load config to runtime memory}
    login_host: ${12:# The host used to connect to ProxySQL admin interface}
    login_password: ${13:# The password used to authenticate to ProxySQL admin interface}
    login_port: ${14:# The port used to connect to ProxySQL admin interface}
    login_unix_socket: ${15:# The socket used to connect to ProxySQL admin interface}
    login_user: ${16:# The username used to authenticate to ProxySQL admin interface}
    max_num_online_servers: ${17:# Prevents new connections when the number of ONLINE servers in the hostgroup exceeds this number}
    multiplex: ${18:# Enables or disables multiplexing for the specific hostgroup}
    save_to_disk: ${19:# Save config to sqlite db on disk to persist the configuration}
    servers_defaults: ${20:# Provide default values for discovered servers}
    state: ${21:# When C(present) - adds the hostgroup attributes, when C(absent) - removes the hostgroup attributes}
    throttle_connections_per_sec: ${22:# Maximum number of new connections that can be opened per second}
  tags:
    - community
    - proxysql
    - proxysql_mysql_hostgroup_attributes]]></content>
