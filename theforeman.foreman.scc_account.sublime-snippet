<snippet>
  <content><![CDATA[- name: ${1:Manage SUSE Customer Center Accounts}
  theforeman.foreman.scc_account:
    base_url: ${2:# URL of SUSE for suse customer center account}
    ca_path: ${3:# PEM formatted file that contains a CA certificate to be used for validation}
    interval: ${4:# Interval for syncing suse customer center account}
    login: ${5:# Login id of suse customer center account}
    name: ${6:# Name of the suse customer center account}
    organization: ${7:# Name of related organization}
    password: ${8:# Password of the user accessing the Foreman server}
    scc_account_password: ${9:# Password of suse customer center account}
    server_url: ${10:# URL of the Foreman server}
    state: ${11:# State of the suse customer center account}
    sync_date: ${12:# Last Sync time of suse customer center account}
    test_connection: ${13:# Test suse customer center account credentials that connects to the server}
    updated_name: ${14:# Name to be updated of suse customer center account}
    use_gssapi: ${15:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${16:# Username accessing the Foreman server}
    validate_certs: ${17:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - scc_account]]></content>
  <tabTrigger>theforeman.foreman.scc_account</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage SUSE Customer Center Accounts</description>
</snippet>