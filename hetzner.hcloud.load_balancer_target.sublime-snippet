<snippet>
  <content><![CDATA[- name: ${1:Manage Hetzner Cloud Load Balancer targets}
  hetzner.hcloud.load_balancer_target:
    api_endpoint: ${2:# The endpoint for the Hetzner Cloud API}
    api_endpoint_hetzner: ${3:# The endpoint for the Hetzner API}
    api_token: ${4:# The token for the Hetzner Cloud API}
    ip: ${5:# An IP from a Hetzner Dedicated Server, needs to belongs to the same user as the project}
    label_selector: ${6:# A Label Selector that will be used to determine the targets dynamically}
    load_balancer: ${7:# Name or ID of the Hetzner Cloud Load Balancer}
    server: ${8:# Name or ID of the Hetzner Cloud Server}
    state: ${9:# State of the load_balancer_network}
    type: ${10:# The type of the target}
    use_private_ip: ${11:# Route the traffic over the private IP of the Load Balancer through a Hetzner Cloud Network}
  tags:
    - hetzner
    - hcloud
    - load_balancer_target]]></content>
