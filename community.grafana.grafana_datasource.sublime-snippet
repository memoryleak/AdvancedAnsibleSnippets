<snippet>
  <content><![CDATA[- name: ${1:Manage Grafana datasources}
  community.grafana.grafana_datasource:
    access: ${2:# The access mode for this datasource}
    additional_json_data: ${3:# Defined data is used for datasource jsonData}
    additional_secure_json_data: ${4:# Defined data is used for datasource secureJsonData}
    alertmanager_handle_grafana_alerts: ${5:# Whether Grafana should send alerts to this alertmanager}
    alertmanager_implementation: ${6:# The implementation to set for the alertmanager datasource type}
    aws_access_key: ${7:# AWS access key for CloudWatch datasource type when C(aws_auth_type) is C(keys)}
    aws_assume_role_arn: ${8:# AWS IAM role arn to assume for CloudWatch datasource type when C(aws_auth_type) is C(arn)}
    aws_auth_type: ${9:# Type for AWS authentication for CloudWatch datasource type (authType of grafana api)}
    aws_credentials_profile: ${10:# Profile for AWS credentials for CloudWatch datasource type when C(aws_auth_type) is C(credentials)}
    aws_custom_metrics_namespaces: ${11:# Namespaces of Custom Metrics for CloudWatch datasource type}
    aws_default_region: ${12:# AWS default region for CloudWatch datasource type}
    aws_secret_key: ${13:# AWS secret key for CloudWatch datasource type when C(aws_auth_type) is C(keys)}
    azure_client: ${14:# The application/client ID for the Azure AD app registration to use for authentication}
    azure_cloud: ${15:# The national cloud for your Azure account}
    azure_secret: ${16:# The application client secret for the Azure AD app registration to use for auth}
    azure_tenant: ${17:# The directory/tenant ID for the Azure AD app registration to use for authentication}
    basic_auth_password: ${18:# The datasource basic auth password, when C(basic auth) is C(true)}
    basic_auth_user: ${19:# The datasource basic auth user}
    client_cert: ${20:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${21:# PEM formatted file that contains your private key to be used for SSL client authentication}
    database: ${22:# Name of the database for the datasource}
    ds_type: ${23:# The type of the datasource}
    ds_url: ${24:# The URL of the datasource}
    enforce_secure_data: ${25:# Secure data is not updated per default (see notes!)}
    es_version: ${26:# Elasticsearch version (for C(ds_type = elasticsearch) only)}
    grafana_api_key: ${27:# The Grafana API key}
    interval: ${28:# For elasticsearch C(ds_type), this is the index pattern used}
    is_default: ${29:# Make this datasource the default one}
    max_concurrent_shard_requests: ${30:# Starting with elasticsearch 5}
    name: ${31:# The name of the datasource}
    org_id: ${32:# Grafana organization ID in which the datasource should be created}
    org_name: ${33:# Grafana organization name in which the datasource should be created}
    password: ${34:# The datasource password}
    sslmode: ${35:# SSL mode for C(postgres) datasource type}
    state: ${36:# Status of the datasource}
    time_field: ${37:# Name of the time field in elasticsearch ds}
    time_interval: ${38:# Minimum group by interval for C(influxdb), C(elasticsearch) or C(prometheus) datasources}
    tls_ca_cert: ${39:# The TLS CA certificate for self signed certificates}
    tls_client_cert: ${40:# The client TLS certificate}
    tls_client_key: ${41:# The client TLS private key}
    tls_servername: ${42:# A Servername is used to verify the hostname on the returned certificate}
    tls_skip_verify: ${43:# Skip the TLS datasource certificate verification}
    trends: ${44:# Use trends or not for zabbix datasource type}
    tsdb_resolution: ${45:# The opentsdb time resolution}
    tsdb_version: ${46:# The opentsdb version}
    uid: ${47:# The uid of the datasource}
    url: ${48:# The Grafana URL}
    url_password: ${49:# The Grafana password for API authentication}
    url_username: ${50:# The Grafana user for API authentication}
    use_proxy: ${51:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    user: ${52:# The datasource login user for influxdb datasources}
    validate_certs: ${53:# If C(false), SSL certificates will not be validated}
    with_credentials: ${54:# Whether credentials such as cookies or auth headers should be sent with cross-site requests}
    zabbix_password: ${55:# Password for Zabbix API}
    zabbix_user: ${56:# User for Zabbix API}
  tags:
    - community
    - grafana
    - grafana_datasource]]></content>
  <tabTrigger>community.grafana.grafana_datasource</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Grafana datasources</description>
</snippet>