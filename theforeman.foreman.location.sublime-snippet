<snippet>
  <content><![CDATA[- name: ${1:Manage Locations}
  theforeman.foreman.location:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    description: ${3:# Description of the Location}
    ignore_types: ${4:# List of resources types that will be automatically associated}
    name: ${5:# Name of the Location}
    organizations: ${6:# List of organizations the location should be assigned to}
    parameters: ${7:# Entity domain specific host parameters}
    parent: ${8:# Title of a parent Location for nesting}
    password: ${9:# Password of the user accessing the Foreman server}
    server_url: ${10:# URL of the Foreman server}
    state: ${11:# State of the entity}
    use_gssapi: ${12:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${13:# Username accessing the Foreman server}
    validate_certs: ${14:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - location]]></content>
