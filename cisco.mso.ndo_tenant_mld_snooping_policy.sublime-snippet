  <content><![CDATA[- name: ${1:Manage Multicast Listener Discovery (MLD) Snooping Policies in Tenant Policy Templates on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_tenant_mld_snooping_policy:
    admin_state: ${2:# The administrative state of the MLD Snooping Policy}
    description: ${3:# The description of the MLD Snooping Policy}
    fast_leave_control: ${4:# The fast leave control of the MLD Snooping Policy}
    host: ${5:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    last_member_query_interval: ${6:# The last member query interval of the MLD Snooping Policy in seconds}
    login_domain: ${7:# The login domain name to use for authentication}
    name: ${8:# The name of the MLD Snooping Policy}
    output_level: ${9:# Influence the output of this MSO module}
    password: ${10:# The password to use for authentication}
    port: ${11:# Port number to be used for the REST connection}
    querier_control: ${12:# The querier control of the MLD Snooping Policy}
    querier_version: ${13:# The querier version of the MLD Snooping Policy}
    query_interval: ${14:# The query interval of the MLD Snooping Policy in seconds}
    query_response_interval: ${15:# The query response interval of the MLD Snooping Policy in seconds}
    start_query_count: ${16:# The start query count of the MLD Snooping Policy}
    start_query_interval: ${17:# The start query interval of the MLD Snooping Policy in seconds}
    state: ${18:# Use C(absent) for removing}
    template: ${19:# The name of the tenant template}
    timeout: ${20:# The socket level timeout in seconds}
    use_proxy: ${21:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${22:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${23:# The username to use for authentication}
    uuid: ${24:# The UUID of the MLD Snooping Policy}
    validate_certs: ${25:# If C(false), SSL certificates will not be validated}
