<snippet>
  <content><![CDATA[- name: ${1:Manage VMware protocol-endpoints on Pure Storage FlashArrays}
  purestorage.flasharray.purefa_endpoint:
    api_token: ${2:# FlashArray API token for admin privileged user}
    container_version: ${3:# Defines vCenter and EXSi host compatibility of the protocol endpoint and its associated container}
    context: ${4:# Name of fleet member on which to perform the volume operation}
    disable_warnings: ${5:# Disable insecure certificate warnings in debug logs}
    eradicate: ${6:# Define whether to eradicate the endpoint on delete or leave in trash}
    fa_url: ${7:# FlashArray management IPv4 address or Hostname}
    hgroup: ${8:# name of hostgroup to attach endpoint to}
    host: ${9:# name of host to attach endpoint to}
    name: ${10:# The name of the endpoint}
    rename: ${11:# Value to rename the specified endpoint to}
    state: ${12:# Define whether the endpoint should exist or not}
  tags:
    - purestorage
    - flasharray
    - purefa_endpoint]]></content>
