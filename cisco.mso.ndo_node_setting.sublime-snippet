<snippet>
  <content><![CDATA[- name: ${1:Manage Fabric Policy Node Settings on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_node_setting:
    description: ${2:# The description of the Fabric Policy Node Settings}
    host: ${3:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    login_domain: ${4:# The login domain name to use for authentication}
    name: ${5:# The name of the Fabric Policy Node Settings}
    output_level: ${6:# Influence the output of this MSO module}
    password: ${7:# The password to use for authentication}
    port: ${8:# Port number to be used for the REST connection}
    ptp: ${9:# The Precision Time Protocol (PTP) of the Fabric Policy Node Settings}
    state: ${10:# Use C(absent) for removing}
    synce: ${11:# The Synchronous Ethernet (SyncE) Interface Policy of the Fabric Policy Node Settings}
    template: ${12:# The name of the template}
    timeout: ${13:# The socket level timeout in seconds}
    use_proxy: ${14:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${15:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${16:# The username to use for authentication}
    uuid: ${17:# The UUID of the Fabric Policy Node Settings}
    validate_certs: ${18:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_node_setting]]></content>
