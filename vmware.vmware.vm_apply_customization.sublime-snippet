<snippet>
  <content><![CDATA[- name: ${1:Applies a customization specification to a virtual machine}
  vmware.vmware.vm_apply_customization:
    cloud_init: ${2:# The cloud-init configuration to apply to the VM}
    datacenter: ${3:# The datacenter in which to search for the VM}
    existing_spec_name: ${4:# The name of the existing customization specification in vSphere to apply to the VM}
    folder: ${5:# Destination folder, absolute or relative path to find an existing guest}
    folder_paths_are_absolute: ${6:# If true, any folder path parameters are treated as absolute paths}
    global_dns: ${7:# The global DNS configuration to apply to the VM}
    hostname: ${8:# The hostname or IP address of the vSphere vCenter server}
    moid: ${9:# Managed Object ID of the instance to manage if known, this is a unique identifier only within a single vCenter instance}
    name: ${10:# Name of the virtual machine to manage}
    name_match: ${11:# If multiple virtual machines matching the name, use the first or last found}
    nic_specific_settings: ${12:# Specify settings for specific network adapters}
    password: ${13:# The password of the vSphere vCenter server}
    port: ${14:# The port number of the vSphere vCenter server}
    proxy_host: ${15:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${16:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    unix_prep: ${17:# The Unix Prep configuration to apply to the VM}
    use_dhcpv4_for_all_nics: ${18:# If true, DHCPv4 will be used for all network adapters on the VM}
    use_instance_uuid: ${19:# Whether to use the VMware instance UUID rather than the BIOS UUID}
    username: ${20:# The username of the vSphere vCenter server}
    uuid: ${21:# UUID of the instance to manage if known, this is VMware's unique identifier}
    validate_certs: ${22:# Allows connection when SSL certificates are not valid}
    windows_sysprep: ${23:# The Windows Sysprep configuration to apply to the VM}
  tags:
    - vmware
    - vmware
    - vm_apply_customization]]></content>
  <tabTrigger>vmware.vmware.vm_apply_customization</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Applies a customization specification to a virtual machine</description>
</snippet>