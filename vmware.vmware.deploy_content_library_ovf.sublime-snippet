<snippet>
  <content><![CDATA[- name: ${1:Deploy a virtual machine from an OVF in a content library}
  vmware.vmware.deploy_content_library_ovf:
    cluster: ${2:# The name of the cluster where the VM should be deployed}
    datacenter: ${3:# The name or MOID of the datacenter to use when searching for and deploying resources}
    datastore: ${4:# Name or MOID of the datastore to store deployed VM and disk}
    datastore_cluster: ${5:# Name or MOID of the datastore cluster to store deployed VM and disk}
    folder_paths_are_absolute: ${6:# If true, any folder path parameters are treated as absolute paths}
    hostname: ${7:# The hostname or IP address of the vSphere vCenter server}
    library_id: ${8:# The ID of the content library where the template exists}
    library_item_id: ${9:# The ID of content library template to use when deploying the VM}
    library_item_name: ${10:# The name of content library template to use when deploying the VM}
    library_name: ${11:# The name of the content library where the template exists}
    password: ${12:# The password of the vSphere vCenter server}
    port: ${13:# The port number of the vSphere vCenter server}
    proxy_host: ${14:# The address of a proxy that will receive all HTTPS requests and relay them}
    proxy_port: ${15:# The port of the HTTP proxy that will receive all HTTPS requests and relay them}
    proxy_protocol: ${16:# The proxy connection protocol to use}
    resource_pool: ${17:# The name of a resource pool into which the virtual machine should be deployed}
    storage_provisioning: ${18:# Default storage provisioning type to use for all sections of type vmw:StorageSection in the OVF descriptor}
    username: ${19:# The username of the vSphere vCenter server}
    validate_certs: ${20:# Allows connection when SSL certificates are not valid}
    vm_folder: ${21:# Virtual machine folder into which the virtual machine should be deployed}
    vm_name: ${22:# The name of the VM to deploy}
  tags:
    - vmware
    - vmware
    - deploy_content_library_ovf]]></content>
  <tabTrigger>vmware.vmware.deploy_content_library_ovf</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Deploy a virtual machine from an OVF in a content library</description>
</snippet>