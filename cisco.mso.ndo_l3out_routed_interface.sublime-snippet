<snippet>
  <content><![CDATA[- name: ${1:Manage L3Out Routed Interfaces on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_l3out_routed_interface:
    host: ${2:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    interface_group_policy: ${3:# The name of the interface group policy}
    ipv4_address: ${4:# The IPv4 address of the interface}
    ipv6_address: ${5:# The IPv6 address of the interface}
    ipv6_dad: ${6:# Whether to enable IPv6 Duplicate Address Detection (DAD)}
    ipv6_link_local_address: ${7:# The IPv6 link-local address of the interface}
    l3out: ${8:# The name of the L3Out}
    l3out_uuid: ${9:# The UUID of the L3Out}
    login_domain: ${10:# The login domain name to use for authentication}
    mac: ${11:# The MAC address of the interface}
    mtu: ${12:# The Maximum Transmission Unit (MTU) of the interface}
    node_group_policy: ${13:# The name of the node group policy}
    node_id: ${14:# The ID of the node (border leaf switch) where to deploy the L3Out routing protocol and node-level protocol configurations}
    node_loopback_ip: ${15:# The loopback IP address of the node}
    node_router_id: ${16:# The router ID of the node}
    output_level: ${17:# Influence the output of this MSO module}
    password: ${18:# The password to use for authentication}
    path: ${19:# The path of the interface}
    port: ${20:# Port number to be used for the REST connection}
    port_channel: ${21:# The port channel details}
    ptp: ${22:# The Precision Time Protocol (PTP) configuration for the interface}
    state: ${23:# Determines the desired state of the resource}
    target_dscp: ${24:# The target Differentiated Services Code Point (DSCP) of the interface}
    template: ${25:# The name of the template}
    template_id: ${26:# The ID of the L3Out template}
    timeout: ${27:# The socket level timeout in seconds}
    use_proxy: ${28:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_router_id_as_loopback: ${29:# Whether to use the router ID as the loopback address of the node}
    use_ssl: ${30:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${31:# The username to use for authentication}
    validate_certs: ${32:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_l3out_routed_interface]]></content>
