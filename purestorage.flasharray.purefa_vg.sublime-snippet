<snippet>
  <content><![CDATA[- name: ${1:Manage volume groups on Pure Storage FlashArrays}
  purestorage.flasharray.purefa_vg:
    api_token: ${2:# FlashArray API token for admin privileged user}
    bw_qos: ${3:# Bandwidth limit for vgroup in M or G units}
    context: ${4:# Name of fleet member on which to perform the operation}
    count: ${5:# Number of volume groups to be created in a multiple volume group creation}
    digits: ${6:# Number of digits to use for multiple volume group count}
    disable_warnings: ${7:# Disable insecure certificate warnings in debug logs}
    eradicate: ${8:# Define whether to eradicate the volume group on delete and leave in trash}
    fa_url: ${9:# FlashArray management IPv4 address or Hostname}
    iops_qos: ${10:# IOPs limit for vgroup - use value or K or M K will mean 1000 M will mean 1000000 To clear an existing IOPs setting use 0 (zero)}
    name: ${11:# The name of the volume group}
    priority_operator: ${12:# DMM Priority Adjustment operator}
    priority_value: ${13:# DMM Priority Adjustment value}
    rename: ${14:# Value to rename the specified volume group to}
    start: ${15:# Number at which to start the multiple volume group creation index}
    state: ${16:# Define whether the volume group should exist or not}
    suffix: ${17:# Suffix string, if required, for multiple volume group create}
  tags:
    - purestorage
    - flasharray
    - purefa_vg]]></content>
  <tabTrigger>purestorage.flasharray.purefa_vg</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage volume groups on Pure Storage FlashArrays</description>
</snippet>