<snippet>
  <content><![CDATA[- name: ${1:Return a list of files based on specific criteria}
  ansible.builtin.find:
    age: ${2:# Select files whose age is equal to or greater than the specified time}
    age_stamp: ${3:# Choose the file property against which we compare age}
    checksum_algorithm: ${4:# Algorithm to determine checksum of file}
    contains: ${5:# A regular expression or pattern which should be matched against the file content}
    depth: ${6:# Set the maximum number of levels to descend into}
    encoding: ${7:# When doing a O(contains) search, determine the encoding of the files to be searched}
    exact_mode: ${8:# Restrict mode matching to exact matches only, and not as a minimum set of permissions to match}
    excludes: ${9:# One or more (shell or regex) patterns, which type is controlled by O(use_regex) option}
    file_type: ${10:# Type of file to select}
    follow: ${11:# Set this to V(true) to follow symlinks in path for systems with python 2}
    get_checksum: ${12:# Whether to return a checksum of the file}
    hidden: ${13:# Set this to V(true) to include hidden files, otherwise they will be ignored}
    limit: ${14:# Limit the maximum number of matching paths returned}
    mode: ${15:# Choose objects matching a specified permission}
    paths: ${16:# List of paths of directories to search}
    patterns: ${17:# One or more (shell or regex) patterns, which type is controlled by O(use_regex) option}
    read_whole_file: ${18:# When doing a C(contains) search, determines whether the whole file should be read into memory or if the regex should be applied to the file line-by-line}
    recurse: ${19:# If target is a directory, recursively descend into the directory looking for files}
    size: ${20:# Select files whose size is equal to or greater than the specified size}
    use_regex: ${21:# If V(false), the patterns are file globs (shell)}
  tags:
    - find]]></content>
  <tabTrigger>ansible.builtin.find</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Return a list of files based on specific criteria</description>
</snippet>