  <content><![CDATA[- name: ${1:Manage repository content imports}
  theforeman.foreman.content_import_repository:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    metadata: ${3:# Contents of the metadata}
    metadata_file: ${4:# Location of the metadata}
    organization: ${5:# Organization that the entity is in}
