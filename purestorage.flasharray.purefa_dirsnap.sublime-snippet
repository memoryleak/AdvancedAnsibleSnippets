<snippet>
  <content><![CDATA[- name: ${1:Manage FlashArray File System Directory Snapshots}
  purestorage.flasharray.purefa_dirsnap:
    api_token: ${2:# FlashArray API token for admin privileged user}
    client: ${3:# The client name portion of the client visible snapshot name}
    context: ${4:# Name of fleet member on which to perform the operation}
    disable_warnings: ${5:# Disable insecure certificate warnings in debug logs}
    eradicate: ${6:# Define whether to eradicate the snapshot on delete or leave in trash}
    fa_url: ${7:# FlashArray management IPv4 address or Hostname}
    filesystem: ${8:# Name of the filesystem the directory links to}
    keep_for: ${9:# Retention period, after which snapshots will be eradicated}
    name: ${10:# Name of the directory to snapshot}
    new_client: ${11:# The new client name when performing a rename}
    new_suffix: ${12:# The new suffix when performing a rename}
    rename: ${13:# Whether to rename a directory snapshot}
    state: ${14:# Define whether the directory snapshot should exist or not}
    suffix: ${15:# Snapshot suffix to use}
  tags:
    - purestorage
    - flasharray
    - purefa_dirsnap]]></content>
  <tabTrigger>purestorage.flasharray.purefa_dirsnap</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage FlashArray File System Directory Snapshots</description>
</snippet>