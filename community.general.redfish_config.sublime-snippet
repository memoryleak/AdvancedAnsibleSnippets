<snippet>
  <content><![CDATA[- name: ${1:Manages Out-Of-Band controllers using Redfish APIs}
  community.general.redfish_config:
    auth_token: ${2:# Security token for authenticating to OOB controller}
    baseuri: ${3:# Base URI of OOB controller}
    bios_attributes: ${4:# Dictionary of BIOS attributes to update}
    boot_order: ${5:# List of BootOptionReference strings specifying the BootOrder}
    ca_path: ${6:# PEM formatted file that contains a CA certificate to be used for validation}
    category: ${7:# Category to execute on OOB controller}
    ciphers: ${8:# TLS/SSL Ciphers to use for the request}
    command: ${9:# List of commands to execute on OOB controller}
    hostinterface_config: ${10:# Setting dict of HostInterface on OOB controller}
    hostinterface_id: ${11:# Redfish HostInterface instance ID if multiple HostInterfaces are present}
    network_protocols: ${12:# Setting dict of manager services to update}
    nic_addr: ${13:# EthernetInterface Address string on OOB controller}
    nic_config: ${14:# Setting dict of EthernetInterface on OOB controller}
    password: ${15:# Password for authenticating to OOB controller}
    power_restore_policy: ${16:# The desired power state of the system when power is restored after a power loss}
    resource_id: ${17:# ID of the System, Manager or Chassis to modify}
    secure_boot_enable: ${18:# Setting parameter to enable or disable SecureBoot}
    service_id: ${19:# ID of the manager to update}
    sessions_config: ${20:# Setting dict of Sessions}
    storage_none_volume_deletion: ${21:# Indicates if all non-RAID volumes are automatically deleted prior to creating the new volume}
    storage_subsystem_id: ${22:# ID of the Storage Subsystem on which the volume is to be created}
    strip_etag_quotes: ${23:# Removes surrounding quotes of etag used in C(If-Match) header of C(PATCH) requests}
    timeout: ${24:# Timeout in seconds for HTTP requests to OOB controller}
    username: ${25:# Username for authenticating to OOB controller}
    validate_certs: ${26:# If V(false), TLS/SSL certificates are not validated}
    volume_details: ${27:# Setting dictionary of volume to be created}
    volume_ids: ${28:# List of IDs of volumes to be deleted}
  tags:
    - community
    - general
    - redfish_config]]></content>
  <tabTrigger>community.general.redfish_config</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manages Out-Of-Band controllers using Redfish APIs</description>
</snippet>