    ignore_warnings: ${16:# Apply changes ignoring warnings}
    name: ${17:# Object name}
    radius_server: ${18:# RADIUS server object identified by the name or UID}
    state: ${19:# State of the access rule (present or absent)}
    tacacs_server: ${20:# TACACS server object identified by the name or UID}
    tags: ${21:# Collection of tag identifiers}
    to_hour: ${22:# Allow users connect until hour}
    version: ${23:# Version of checkpoint}
    wait_for_task: ${24:# Wait for the task to end}
