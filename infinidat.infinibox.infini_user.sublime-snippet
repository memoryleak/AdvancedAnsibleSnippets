<snippet>
  <content><![CDATA[- name: ${1:Create, Delete and Modify a User on Infinibox}
  infinidat.infinibox.infini_user:
    password: ${2:# Infinibox User password}
    state: ${3:# Creates/Modifies user when present or removes when absent}
    stay_logged_in: ${4:# If True, persist API session to disk}
    stay_logged_in_minutes: ${5:# Number of minutes for which a persisted session may be reused}
    system: ${6:# Infinibox Hostname or IPv4 Address}
    user: ${7:# Infinibox User username with sufficient priveledges ( see notes )}
    user_email: ${8:# The new user's Email address}
    user_enabled: ${9:# Specify whether to enable the user}
    user_ldap_group_dn: ${10:# DN of the LDAP user group}
    user_ldap_group_ldap: ${11:# Name of the LDAP}
    user_ldap_group_name: ${12:# Name of the LDAP user group}
    user_ldap_group_pools: ${13:# A list of existing pools managed by the LDAP user group}
    user_ldap_group_role: ${14:# Role for the LDAP user group}
    user_name: ${15:# The new user's Name}
    user_password: ${16:# The new user's password}
    user_pool: ${17:# Use with role==pool_admin}
    user_role: ${18:# The user's role}
  tags:
    - infinidat
    - infinibox
    - infini_user]]></content>
  <tabTrigger>infinidat.infinibox.infini_user</tabTrigger>
