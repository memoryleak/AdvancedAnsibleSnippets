<snippet>
  <content><![CDATA[- name: ${1:Manage Products}
  theforeman.foreman.product:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    description: ${3:# Possibly long description to show the user in detail view}
    gpg_key: ${4:# Content GPG key name attached to this product}
    label: ${5:# Label to show the user}
    name: ${6:# Name of the product}
    organization: ${7:# Organization that the entity is in}
    password: ${8:# Password of the user accessing the Foreman server}
    server_url: ${9:# URL of the Foreman server}
    ssl_ca_cert: ${10:# Content SSL CA certificate name attached to this product}
    ssl_client_cert: ${11:# Content SSL client certificate name attached to this product}
    ssl_client_key: ${12:# Content SSL client private key name attached to this product}
    state: ${13:# State of the entity}
    sync_plan: ${14:# Sync plan name attached to this product}
    use_gssapi: ${15:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${16:# Username accessing the Foreman server}
    validate_certs: ${17:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - product]]></content>
  <tabTrigger>theforeman.foreman.product</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Products</description>
</snippet>