<snippet>
  <content><![CDATA[- name: ${1:Modify config on Infinibox}
  infinidat.infinibox.infini_config:
    config_group: ${2:# Config group}
    key: ${3:# Name of the config}
    password: ${4:# Infinibox User password}
    state: ${5:# Query or modifies config when}
    stay_logged_in: ${6:# If True, persist API session to disk}
    stay_logged_in_minutes: ${7:# Number of minutes for which a persisted session may be reused}
    system: ${8:# Infinibox Hostname or IPv4 Address}
    user: ${9:# Infinibox User username with sufficient priveledges ( see notes )}
    value: ${10:# Value of the config key}
  tags:
    - infinidat
    - infinibox
    - infini_config]]></content>
  <tabTrigger>infinidat.infinibox.infini_config</tabTrigger>
