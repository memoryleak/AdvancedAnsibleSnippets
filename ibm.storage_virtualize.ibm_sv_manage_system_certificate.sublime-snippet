<snippet>
  <content><![CDATA[- name: ${1:This module manages system certificates and truststore for replication, high availability and FlashSystem grid on IBM Storage Virtualize family systems}
  ibm.storage_virtualize.ibm_sv_manage_system_certificate:
    clustername: ${2:# The hostname or management IP of the Storage Virtualize system}
    domain: ${3:# Domain for the Storage Virtualize storage system}
    log_path: ${4:# Path of debug log file}
    password: ${5:# Password for the Storage Virtualize system}
    primary_truststore_name: ${6:# Specifies the name of the truststore on the primary system}
    remote_clustername: ${7:# Specifies the name of the partner remote cluster with which mTLS needs to be setup}
    remote_domain: ${8:# Domain for the Storage Virtualize storage system}
    remote_password: ${9:# Password for remote cluster}
    remote_truststore_name: ${10:# Specifies the name of the truststore on the remote system}
    remote_username: ${11:# Username for remote cluster}
    state: ${12:# Creates (C(present)) or deletes (C(absent)) a truststore}
    username: ${13:# Username for the Storage Virtualize system}
  tags:
    - ibm
    - storage_virtualize
    - ibm_sv_manage_system_certificate]]></content>
