<snippet>
  <content><![CDATA[- name: ${1:NetApp ONTAP multi-admin verification (MAV) rule}
  netapp.ontap.na_ontap_mav_rule:
    approval_expiry: ${2:# Specifies the time, in ISO-8601 duration format, that the approvers have after a new execution request is submitted to approve or disapprove the request before the request expires}
    approval_groups: ${3:# Specifies the list of approval groups that are allowed to approve requests for rules that don't have approval groups}
    auto_request_create: ${4:# When true, ONTAP automatically creates a request for any failed operation where there is no matching pending request}
    cert_filepath: ${5:# path to SSL client cert file (}
    execution_expiry: ${6:# Specifies the time, in ISO-8601 duration format, that the authorized users have after a request is approved to execute the requested operation before the request expires}
    feature_flags: ${7:# Enable or disable a new feature}
    force_ontap_version: ${8:# Override the cluster ONTAP version when using REST}
    hostname: ${9:# The hostname or IP address of the ONTAP instance}
    http_port: ${10:# Override the default port (80 or 443) with this port}
    https: ${11:# Enable and disable https}
    key_filepath: ${12:# path to SSL client key file}
    operation: ${13:# Specifies the command that requires one or more approvals}
    password: ${14:# Password for the specified user}
    query: ${15:# Specifies the query information which is applied to the subset of objects of ONTAP operation of the rule}
    required_approvers: ${16:# Specifies the number of required approvers, excluding the user that made the request}
    state: ${17:# Specifies whether to create/modify or delete the specified rule}
    use_rest: ${18:# This module only supports REST}
    username: ${19:# This can be a Cluster-scoped or SVM-scoped account, depending on whether a Cluster-level or SVM-level API is required}
    validate_certs: ${20:# If set to C(no), the SSL certificates will not be validated}
  tags:
    - netapp
    - ontap
    - na_ontap_mav_rule]]></content>
  <tabTrigger>netapp.ontap.na_ontap_mav_rule</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>NetApp ONTAP multi-admin verification (MAV) rule</description>
</snippet>