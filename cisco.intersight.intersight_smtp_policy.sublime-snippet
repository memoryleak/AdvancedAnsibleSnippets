<snippet>
  <content><![CDATA[- name: ${1:SMTP Policy configuration for Cisco Intersight}
  cisco.intersight.intersight_smtp_policy:
    api_key_id: ${2:# Public API Key ID associated with the private key}
    api_private_key: ${3:# Filename (absolute path) or string of PEM formatted private key data to be used for Intersight API authentication}
    api_uri: ${4:# URI used to access the Intersight API}
    description: ${5:# The user-defined description for the SMTP Policy}
    enabled: ${6:# If enabled, controls the state of the SMTP client service on the managed device}
    min_severity: ${7:# Minimum fault severity level to receive email notifications}
    name: ${8:# The name assigned to the SMTP Policy}
    organization: ${9:# The name of the Organization this resource is assigned to}
    sender_email: ${10:# The email address entered here will be displayed as the from address (mail received from address) of all the SMTP mail alerts that are received}
    smtp_port: ${11:# Port number used by the SMTP server for outgoing SMTP communication}
    smtp_recipients: ${12:# List of email addresses that will receive notifications for faults}
    smtp_server: ${13:# IP address or hostname of the SMTP server}
    state: ${14:# If C(present), will verify the resource is present and will create if needed}
    tags: ${15:# List of tags in Key:<user-defined key> Value:<user-defined value> format}
    use_proxy: ${16:# If C(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${17:# Boolean control for verifying the api_uri TLS certificate}
  tags:
    - cisco
    - intersight
    - intersight_smtp_policy]]></content>
  <tabTrigger>cisco.intersight.intersight_smtp_policy</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>SMTP Policy configuration for Cisco Intersight</description>
</snippet>