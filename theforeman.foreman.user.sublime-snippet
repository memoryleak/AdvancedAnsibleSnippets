<snippet>
  <content><![CDATA[- name: ${1:Manage Users}
  theforeman.foreman.user:
    admin: ${2:# Whether or not the user is an administrator}
    auth_source: ${3:# Authentication source where the user exists}
    ca_path: ${4:# PEM formatted file that contains a CA certificate to be used for validation}
    default_location: ${5:# The location that the user uses by default}
    default_organization: ${6:# The organization that the user uses by default}
    description: ${7:# Description of the user}
    firstname: ${8:# First name of the user}
    lastname: ${9:# Last name of the user}
    locale: ${10:# The language locale for the user}
    locations: ${11:# List of locations the entity should be assigned to}
    login: ${12:# Name of the user}
    mail: ${13:# Email address of the user}
    organizations: ${14:# List of organizations the entity should be assigned to}
    password: ${15:# Password of the user accessing the Foreman server}
    roles: ${16:# List of roles assigned to the user}
    server_url: ${17:# URL of the Foreman server}
    state: ${18:# State of the entity}
    timezone: ${19:# Timezone for the user}
    use_gssapi: ${20:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    user_password: ${21:# Password for the user}
    username: ${22:# Username accessing the Foreman server}
    validate_certs: ${23:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - user]]></content>
  <tabTrigger>theforeman.foreman.user</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Users</description>
</snippet>