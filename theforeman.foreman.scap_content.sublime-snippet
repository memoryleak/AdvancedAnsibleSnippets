<snippet>
  <content><![CDATA[- name: ${1:Manage SCAP content}
  theforeman.foreman.scap_content:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    locations: ${3:# List of locations the entity should be assigned to}
    organizations: ${4:# List of organizations the entity should be assigned to}
    original_filename: ${5:# Original file name of the XML file}
    password: ${6:# Password of the user accessing the Foreman server}
    scap_file: ${7:# File containing XML DataStream content}
    server_url: ${8:# URL of the Foreman server}
    state: ${9:# State of the entity}
    title: ${10:# Title of SCAP content}
    updated_title: ${11:# New SCAP content title}
    use_gssapi: ${12:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${13:# Username accessing the Foreman server}
    validate_certs: ${14:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - scap_content]]></content>
  <tabTrigger>theforeman.foreman.scap_content</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage SCAP content</description>
</snippet>