    validate_certs: ${13:# Validate SSL certs of the Scaleway API}
    wait: ${14:# Wait for the resource to reach its desired state before returning}
    wait_sleep_time: ${15:# Time to wait before every attempt to check the state of the resource}
    wait_timeout: ${16:# Time to wait for the resource to reach the expected state}
