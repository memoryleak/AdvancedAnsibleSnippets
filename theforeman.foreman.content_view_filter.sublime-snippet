<snippet>
  <content><![CDATA[- name: ${1:Manage Content View Filters}
  theforeman.foreman.content_view_filter:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    content_view: ${3:# Name of the content view}
    description: ${4:# Description of the Content View Filter}
    filter_type: ${5:# Content view filter type}
    inclusion: ${6:# Create an include filter}
    name: ${7:# Name of the Content View Filter}
    organization: ${8:# Organization that the entity is in}
    original_module_streams: ${9:# Include all module streams with no errata}
    original_packages: ${10:# Include all RPMs with no errata}
    password: ${11:# Password of the user accessing the Foreman server}
    repositories: ${12:# List of repositories that include name and product}
    server_url: ${13:# URL of the Foreman server}
    state: ${14:# State of the content view filter}
    use_gssapi: ${15:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${16:# Username accessing the Foreman server}
    validate_certs: ${17:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - content_view_filter]]></content>
  <tabTrigger>theforeman.foreman.content_view_filter</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Content View Filters</description>
</snippet>