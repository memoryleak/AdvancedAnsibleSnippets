<snippet>
  <content><![CDATA[- name: ${1:Manage Content Views}
  theforeman.foreman.content_view:
    auto_publish: ${2:# Auto publish composite view when a new version of a component content view is created}
    ca_path: ${3:# PEM formatted file that contains a CA certificate to be used for validation}
    components: ${4:# List of content views to includes content_view and either version or latest}
    composite: ${5:# A composite view contains other content views}
    description: ${6:# Description of the Content View}
    import_only: ${7:# Designate this Content View for importing from upstream servers only}
    label: ${8:# Label of the Content View}
    name: ${9:# Name of the Content View}
    organization: ${10:# Organization that the entity is in}
    password: ${11:# Password of the user accessing the Foreman server}
    repositories: ${12:# List of repositories that include name and product}
    rolling: ${13:# A rolling content view contains latest synced state of repositories}
    server_url: ${14:# URL of the Foreman server}
    solve_dependencies: ${15:# Solve RPM dependencies by default on Content View publish}
    state: ${16:# State of the entity}
    use_gssapi: ${17:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    username: ${18:# Username accessing the Foreman server}
    validate_certs: ${19:# Whether or not to verify the TLS certificates of the Foreman server}
  tags:
    - theforeman
    - foreman
    - content_view]]></content>
  <tabTrigger>theforeman.foreman.content_view</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Manage Content Views</description>
</snippet>