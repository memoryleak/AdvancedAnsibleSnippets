<snippet>
  <content><![CDATA[- name: ${1:Manage IPSLA Monitoring Policies on Cisco Nexus Dashboard Orchestrator (NDO)}
  cisco.mso.ndo_ipsla_monitoring_policy:
    description: ${2:# The description of the IPSLA Monitoring Policy}
    destination_port: ${3:# The port used for SLA}
    detect_multiplier: ${4:# The detection multiplier for SLA}
    host: ${5:# IP Address or hostname of the ACI Multi Site Orchestrator host}
    http_uri: ${6:# The URI used for HTTP SLA}
    http_version: ${7:# The HTTP version used for SLA}
    ipsla_monitoring_policy: ${8:# The name of the IPSLA Monitoring Policy}
    ipsla_monitoring_policy_uuid: ${9:# The UUID of the IPSLA Monitoring Policy}
    ipv6_traffic_class: ${10:# The IPv6 Traffic Class}
    login_domain: ${11:# The login domain name to use for authentication}
    operation_timeout: ${12:# The operation_timeout for SLA in milliseconds}
    output_level: ${13:# Influence the output of this MSO module}
    password: ${14:# The password to use for authentication}
    port: ${15:# Port number to be used for the REST connection}
    request_data_size: ${16:# The size of the request data in bytes}
    sla_frequency: ${17:# The frequency of SLA monitoring in seconds}
    sla_type: ${18:# The type of SLA}
    state: ${19:# Use C(absent) for removing}
    template: ${20:# The name of the template}
    threshold: ${21:# The threshold for SLA in milliseconds}
    timeout: ${22:# The socket level timeout in seconds}
    type_of_service: ${23:# The IPv4 Type of Service}
    use_proxy: ${24:# If C(false), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    use_ssl: ${25:# If C(false), an HTTP connection will be used instead of the default HTTPS connection}
    username: ${26:# The username to use for authentication}
    validate_certs: ${27:# If C(false), SSL certificates will not be validated}
  tags:
    - cisco
    - mso
    - ndo_ipsla_monitoring_policy]]></content>
