<snippet>
  <content><![CDATA[- name: ${1:Manage Host Collections}
  theforeman.foreman.host_collection:
    ca_path: ${2:# PEM formatted file that contains a CA certificate to be used for validation}
    description: ${3:# Description of the host collection}
    name: ${4:# Name of the host collection}
    organization: ${5:# Organization that the entity is in}
    password: ${6:# Password of the user accessing the Foreman server}
    server_url: ${7:# URL of the Foreman server}
    state: ${8:# State of the entity}
