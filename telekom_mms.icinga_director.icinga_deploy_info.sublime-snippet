<snippet>
  <content><![CDATA[- name: ${1:Get deployment information through the director API}
  telekom_mms.icinga_director.icinga_deploy_info:
    activities: ${2:# A list of checksums of activities to query information for}
    api_timeout: ${3:# Default timeout to wait for transaction to finish in seconds}
    client_cert: ${4:# PEM formatted certificate chain file to be used for SSL client authentication}
    client_key: ${5:# PEM formatted file that contains your private key to be used for SSL client authentication}
    configs: ${6:# A list of checksums of configs to query information for}
    force: ${7:# If V(yes) do not get a cached copy}
    force_basic_auth: ${8:# Credentials specified with O(url_username) and O(url_password) should be passed in HTTP Header}
    http_agent: ${9:# Header to identify as, generally appears in web server logs}
    url: ${10:# HTTP, HTTPS, or FTP URL in the form (http|https|ftp)://[user[:pass]]@host}
    url_password: ${11:# The password for use in HTTP basic authentication}
    url_username: ${12:# The username for use in HTTP basic authentication}
    use_gssapi: ${13:# Use GSSAPI to perform the authentication, typically this is for Kerberos or Kerberos through Negotiate authentication}
    use_proxy: ${14:# If V(no), it will not use a proxy, even if one is defined in an environment variable on the target hosts}
    validate_certs: ${15:# If V(no), SSL certificates will not be validated}
  tags:
    - telekom_mms
    - icinga_director
    - icinga_deploy_info]]></content>
  <tabTrigger>telekom_mms.icinga_director.icinga_deploy_info</tabTrigger>
  <scope>source.yaml,source.ansible</scope>
  <description>Get deployment information through the director API</description>
</snippet>